# Copy to .env next to compose.yaml and uncomment what you need.
# Everything is optional.

# Address to listen on.
#AUDIOLOADER_ADDR=:8080
# Path of the SQLite database.
#AUDIOLOADER_DB=./database.db
# How many downloads run at once (default 2, at most 4).
#AUDIOLOADER_DOWNLOAD_WORKERS=2
# Contact (email or URL) for the MusicBrainz User-Agent.
#AUDIOLOADER_CONTACT=you@example.com
# AcoustID API key, for identifying tracks by audio (needs fpcalc).
#ACOUSTID_KEY=
# Twitch app credentials (both needed), for artists' channel pictures.
#TWITCH_CLIENT_ID=
#TWITCH_CLIENT_SECRET=
# Path to fpcalc, if it isn't on PATH.
#FPCALC=
# Paths to yt-dlp and ffmpeg, if they aren't on PATH.
#YTDLP=
#FFMPEG=
# Path to spotdl, if it isn't on PATH.
#SPOTDL=
# Folder searched for missing tracks.
#AUDIOLOADER_WATCH=

# Vault passphrase hash; enables secret tracks.
# Put bcrypt hashes in SINGLE quotes: Compose interpolates `$` in .env values.
# Make the hash with one of:
#   docker compose run --rm -it audioloader -hash-secret
#   ./audioloader -hash-secret
#AUDIOLOADER_SECRET='$2a$10$replace.with.your.hash'
# Bare host name the secret source downloads from (https only).
#AUDIOLOADER_SECRET_SOURCE=
# Comma-separated extra hosts audio files may be fetched from.
#AUDIOLOADER_SECRET_SOURCE_MEDIA=
# Token (at least 32 characters, e.g. `openssl rand -hex 32`) for sharing pages from an iOS Shortcut.
#AUDIOLOADER_SHARE_TOKEN=
# The address the app is reached at, for links in share answers.
#AUDIOLOADER_PUBLIC_URL=
