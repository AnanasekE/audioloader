#!/bin/sh
# Stands in for yt-dlp in tests: -J prints fixture JSON, otherwise it
# "downloads" testdata/audio.opus (a ytsearchN: query gets search.json, a YouTube Music
# search music_search.json) to the -o template's directory.
here=$(dirname "$0")
url=""
out=""
json=0
while [ $# -gt 0 ]; do
	case "$1" in
		--version) echo 2099.01.01; exit 0 ;;
		-J) json=1 ;;
		-o) shift; out="$1" ;;
		--) shift; url="$1" ;;
	esac
	shift
done
if [ "$json" = 1 ]; then
	# FAKE_YTDLP_LOG: every URL asked about, one per line
	if [ -n "$FAKE_YTDLP_LOG" ]; then echo "$url" >> "$FAKE_YTDLP_LOG"; fi
	case "$url" in
		ytsearch*) cat "$here/search.json" ;;
		*music.youtube.com/search*) cat "$here/music_search.json" ;;
		*playlist*) cat "$here/playlist.json" ;;
		*)
			# a video with a file of its own (video-<id>.json), else the default one
			id=${url##*v=}
			if [ -f "$here/video-$id.json" ]; then cat "$here/video-$id.json"; else cat "$here/video.json"; fi ;;
	esac
	exit 0
fi
case "$url" in
	*v=failfailfai) echo "ERROR: [youtube] failfailfai: Video unavailable" >&2; exit 1 ;;
esac
id=${url##*v=}
dir=$(dirname "$out")
echo "download:  10.0%"
echo "download:  55.5%"
echo "download: 100.0%"
# copy, then make the bytes unique per video so fingerprints differ
cp "$here/audio.opus" "$dir/$id.opus"
printf '%s' "$id" >> "$dir/$id.opus"
