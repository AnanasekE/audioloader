package components

import (
	"fmt"
	"slices"
	"strings"
	"time"

	"audioloader/internal/audio"
	"audioloader/internal/db"
	"audioloader/internal/mb"
)

const PageInbox = "inbox"

// FollowPage sets up following an artist: its MusicBrainz ID, picked from
// candidates when unknown, and which releases to track.
templ FollowPage(a *audio.Artist, follow *db.Follow, candidates []mb.Artist, searchErr string) {
	@layout("Follow "+a.Name, PageArtists) {
		@avatarHeader(a.ImgURL, "Follow", a.Name, nil, followMeta(follow)) {
			<a class="btn btn-ghost" href={ artistURL(a) }>Back to artist</a>
		}
		@formPanel() {
			<form
				class="grid gap-6"
				hx-post={ "/ui/artists/" + a.ID.String() + "/follow" }
				hx-target="#follow-result"
				hx-on::after-request="if (!event.detail.successful) document.getElementById('follow-result').textContent = event.detail.xhr.responseText || 'Could not save.'"
			>
				<fieldset class="grid gap-2">
					@sectionLabel("MusicBrainz artist")
					@list() {
						if a.MBID != "" {
							<label class="row row-cand">
								<input type="radio" name="mbid" value={ a.MBID } checked/>
								<span class="min-w-0 flex-1">
									<a href={ templ.SafeURL("https://musicbrainz.org/artist/" + a.MBID) } target="_blank" rel="noopener">{ a.Name }</a>
									<span class="text-fg-muted">(linked)</span>
								</span>
							</label>
						}
						for i, c := range candidates {
							if c.ID != a.MBID {
								@artistCandidate(c) {
									<input type="radio" name="mbid" value={ c.ID } checked?={ a.MBID == "" && i == 0 } aria-label={ "Use " + c.Name } class="mt-1"/>
								}
							}
						}
					}
					if searchErr != "" {
						<p class="text-sm text-st-failed">{ searchErr }</p>
					}
					@field("Or paste a MusicBrainz artist ID or URL", "") {
						<input class="input" type="text" name="mbid_manual" placeholder="https://musicbrainz.org/artist/…"/>
					}
				</fieldset>
				@followFilters(follow)
				<div class="flex flex-wrap items-center gap-2">
					<button class="btn" type="submit">
						if follow != nil {
							Save
						} else {
							Follow
						}
					</button>
					if follow != nil {
						<button class="btn btn-ghost" type="button" hx-post={ "/ui/artists/" + a.ID.String() + "/check" }>Check now</button>
						<button class="btn btn-danger" type="button" hx-post={ "/ui/artists/" + a.ID.String() + "/unfollow" } hx-confirm={ "Stop following " + a.Name + "?" }>Unfollow</button>
					}
					<span id="follow-result" class="text-sm text-st-failed" aria-live="polite"></span>
				</div>
			</form>
		}
	}
}

func followMeta(follow *db.Follow) string {
	if follow == nil {
		return "Get new releases in your inbox"
	}
	return lastChecked(follow.LastChecked)
}

templ followFilters(follow *db.Follow) {
	{{ f := db.DefaultFilters() }}
	if follow != nil {
		{{ f = follow.Filters }}
	}
	<fieldset class="grid gap-2">
		@sectionLabel("Release types")
		<div class="flex flex-wrap gap-2">
			for _, typ := range audio.ReleaseTypes {
				@choice("type", string(typ), typ.Label(), slices.Contains(f.Types, string(typ)), true)
			}
		</div>
	</fieldset>
	<fieldset class="grid gap-2">
		@sectionLabel("Skip")
		<div class="flex flex-wrap gap-2">
			for _, sk := range db.SecondaryTypes {
				@choice("skip", sk, sk, slices.Contains(f.SkipSecondary, sk), true)
			}
		</div>
	</fieldset>
}

templ InboxPage(filter db.InboxFilter, releases []*db.InboxRelease, newCount, ignoredCount int, follows []*db.Follow) {
	{{ tab := filter.Status }}
	@layout("Inbox", PageInbox) {
		@pageHead("Inbox", fmt.Sprintf("%s from %s", plural(newCount, "new release"), plural(len(follows), "followed artist"))) {
			@segmented("Inbox tabs", []SegOption{
				{Label: fmt.Sprintf("New (%d)", newCount), Href: "/inbox", On: tab == "new"},
				{Label: fmt.Sprintf("Ignored (%d)", ignoredCount), Href: "/inbox?tab=ignored", On: tab == "ignored"},
			})
		}
		<form
			class="mb-4 flex flex-wrap items-end gap-3 text-sm"
			hx-get="/inbox"
			hx-trigger="change, input delay:300ms from:input[type=search], submit"
			hx-target="#inbox-list"
			hx-select="#inbox-list"
			hx-swap="outerHTML"
			hx-push-url="true"
			role="search"
		>
			if tab == "ignored" {
				<input type="hidden" name="tab" value="ignored"/>
			}
			<label>
				<span class="sr-only">Search</span>
				<input class="input" type="search" name="q" value={ filter.Q } placeholder="Search title or artist"/>
			</label>
			<label>
				<span class="sr-only">Type</span>
				<select class="input" name="type">
					<option value="">All types</option>
					for _, typ := range audio.ReleaseTypes {
						<option value={ string(typ) } selected?={ filter.Type == string(typ) }>{ typ.Label() }</option>
					}
				</select>
			</label>
			<label>
				<span class="sr-only">Sort</span>
				<select class="input" name="sort">
					<option value="date">Newest first</option>
					<option value="oldest" selected?={ filter.Sort == "oldest" }>Oldest first</option>
				</select>
			</label>
			<label class="flex items-center gap-2">
				<input type="checkbox" name="owned" value="none" checked?={ filter.NoneOwned }/>
				Nothing owned yet
			</label>
		</form>
		<div id="inbox-list">
			if tab == "new" && len(releases) > 1 {
				<div class="mb-3 flex justify-end">
					<button class="btn" hx-post={ "/ui/inbox/confirm-all?" + filter.Query() } hx-confirm={ fmt.Sprintf("Add all %d releases and download their missing tracks?", len(releases)) }>Confirm all</button>
				</div>
			}
			if len(follows) == 0 {
				@emptyState() {
					Follow artists on the Artists page to get their new releases here.
				}
			} else if len(releases) == 0 {
				@emptyState() {
					if filter.Active() {
						Nothing matches.
					} else if tab == "ignored" {
						Nothing ignored.
					} else {
						Nothing new.
					}
				}
			}
			<div class="grid gap-6">
				for _, g := range groupInbox(releases) {
					<details class="inbox-group" data-artist={ g.ArtistID } open>
						<summary class="flex cursor-pointer flex-wrap items-center justify-between gap-2 py-1">
							<span class="section-label">{ g.Name } <span class="font-normal">({ fmt.Sprint(len(g.Releases)) })</span></span>
							if tab == "new" && len(g.Releases) > 1 {
								<button
									class="btn"
									hx-post={ "/ui/inbox/confirm-all?artist=" + g.ArtistID + "&" + filter.Query() }
									hx-confirm={ fmt.Sprintf("Add all %d releases by %s and download their missing tracks?", len(g.Releases), g.Name) }
								>Confirm all</button>
							}
						</summary>
						<div class="mt-1">
							@list() {
								for _, r := range g.Releases {
									@inboxRelease(r, tab)
								}
							}
						</div>
					</details>
				}
			</div>
		</div>
		<script src="/assets/js/inbox.js" defer></script>
		if len(follows) > 0 {
			<div class="mt-10">
				@sectionLabel("Following")
				@list() {
					for _, f := range follows {
						@row("row-2 row-pad") {
							<a href={ templ.SafeURL("/artists/" + f.Artist.ID.String() + "/follow") }>{ f.Artist.Name }</a>
							<span class="text-sm text-fg-muted">{ lastChecked(f.LastChecked) }</span>
						}
					}
				}
			</div>
		}
	}
}

templ inboxRelease(r *db.InboxRelease, tab string) {
	<article class="row row-inbox" id={ "inbox-" + r.ReleaseGroupMBID }>
		<img
			class="cover"
			width="40"
			height="40"
			style="width:40px;height:40px"
			src={ r.Data.CoverURL }
			alt=""
			onerror="this.onerror = null; this.src = '/assets/img/default_track.png'"
		/>
		<div class="stack">
			<b>
				<a class="text-fg" href={ templ.SafeURL("https://musicbrainz.org/release-group/" + r.ReleaseGroupMBID) } target="_blank" rel="noopener">{ r.Title }</a>
			</b>
			<span>{ r.ArtistName + fmt.Sprintf(" · %d of %d in library", r.Owned(), len(r.Data.Tracks)) }</span>
		</div>
		<span class="inbox-kind">
			@chipKind(audio.ReleaseType(r.Type).Label())
		</span>
		<span class="inbox-date mono text-fg-muted">{ r.Date }</span>
		<div class="inbox-acts">
			<button class="btn btn-ghost" type="button" hx-get={ "/ui/inbox/" + r.ReleaseGroupMBID } hx-target="next .inbox-details" hx-swap="innerHTML">Show tracklist</button>
			if tab == "ignored" {
				<button class="btn btn-ghost" hx-post={ "/ui/inbox/" + r.ReleaseGroupMBID + "/restore" }>Move back to New</button>
			} else {
				<button class="btn" hx-post={ "/ui/inbox/" + r.ReleaseGroupMBID + "/confirm" }>Confirm</button>
				<button class="btn btn-ghost" hx-post={ "/ui/inbox/" + r.ReleaseGroupMBID + "/ignore" }>Don't ask again</button>
			}
		</div>
		<div class="inbox-details"></div>
	</article>
}

// InboxDetails is the part of an inbox row that opens on demand: the cover
// and the tracklist with owned tracks marked.
templ InboxDetails(r *db.InboxRelease) {
	<div class="mt-3 flex gap-4">
		<img
			class="cover size-32"
			src={ r.Data.CoverURL }
			alt=""
			onerror="this.onerror = null; this.src = '/assets/img/default_track.png'"
		/>
		<div class="list min-w-0 flex-1">
			for _, t := range r.Data.Tracks {
				@row("row-3") {
					<span class="mono text-right text-fg-muted">{ trackNumber(t) }</span>
					<span class="truncate">
						{ t.Title }
						if t.OwnedTrackID != "" {
							<span class="text-st-done" title="In your library">✓</span>
						}
					</span>
					<span class="mono text-right text-fg-muted">{ formatDuration(time.Duration(t.LengthMs) * time.Millisecond) }</span>
				}
			}
		</div>
	</div>
}

// inboxGroup is one artist's releases, in the order they were listed.
type inboxGroup struct {
	ArtistID string
	Name     string
	Releases []*db.InboxRelease
}

// groupInbox groups releases by artist, sorted by name.
func groupInbox(releases []*db.InboxRelease) []inboxGroup {
	var groups []inboxGroup
	byArtist := map[string]int{}
	for _, r := range releases {
		i, ok := byArtist[r.ArtistID]
		if !ok {
			i = len(groups)
			byArtist[r.ArtistID] = i
			groups = append(groups, inboxGroup{ArtistID: r.ArtistID, Name: r.ArtistName})
		}
		groups[i].Releases = append(groups[i].Releases, r)
	}
	slices.SortStableFunc(groups, func(a, b inboxGroup) int {
		return strings.Compare(strings.ToLower(a.Name), strings.ToLower(b.Name))
	})
	return groups
}

func trackNumber(t db.InboxTrack) string {
	if t.Disc > 1 {
		return fmt.Sprintf("%d-%d", t.Disc, t.Position)
	}
	return fmt.Sprint(t.Position)
}

func lastChecked(at string) string {
	if at == "" {
		return "Not checked yet"
	}
	return "Checked " + at + " UTC"
}

// plural formats n with noun, adding an "s" unless n is 1.
func plural(n int, noun string) string {
	if n == 1 {
		return "1 " + noun
	}
	return fmt.Sprintf("%d %ss", n, noun)
}
