package components

import (
	"fmt"
	"slices"
	"strings"
	"time"

	"audioloader/internal/audio"
	"audioloader/internal/db"
	"audioloader/internal/mb"
)

const PageInbox = "inbox"

// FollowPage sets up following an artist: its MusicBrainz ID, picked from
// candidates when unknown, and which releases to track.
templ FollowPage(a *audio.Artist, follow *db.Follow, candidates []mb.Artist, searchErr string) {
	@layout("Follow "+a.Name, PageArtists) {
		@pageHeader("Follow "+a.Name, "Get new releases in your inbox") {
			<a class="btn" href="/artists">Back</a>
		}
		<form
			class="card grid max-w-2xl gap-6"
			hx-post={ "/ui/artists/" + a.ID.String() + "/follow" }
			hx-target="#follow-result"
			hx-on::after-request="if (!event.detail.successful) document.getElementById('follow-result').textContent = event.detail.xhr.responseText || 'Could not save.'"
		>
			<fieldset class="grid gap-2">
				<legend class="mb-1 text-sm font-medium">MusicBrainz artist</legend>
				if a.MBID != "" {
					<label class="flex items-center gap-2 text-sm">
						<input type="radio" name="mbid" value={ a.MBID } checked/>
						<a href={ templ.SafeURL("https://musicbrainz.org/artist/" + a.MBID) } target="_blank" rel="noopener">{ a.Name }</a>
						<span class="text-zinc-500">(linked)</span>
					</label>
				}
				for i, c := range candidates {
					if c.ID != a.MBID {
						@artistCandidate(c) {
							<input type="radio" name="mbid" value={ c.ID } checked?={ a.MBID == "" && i == 0 } aria-label={ "Use " + c.Name } class="mt-1"/>
						}
					}
				}
				if searchErr != "" {
					<p class="text-sm text-red-600 dark:text-red-400">{ searchErr }</p>
				}
				<label class="mt-2 text-sm">
					Or paste a MusicBrainz artist ID or URL
					<input class="input mt-1" type="text" name="mbid_manual" placeholder="https://musicbrainz.org/artist/…"/>
				</label>
			</fieldset>
			@followFilters(follow)
			<div class="flex flex-wrap items-center gap-2">
				<button class="btn" type="submit">
					if follow != nil {
						Save
					} else {
						Follow
					}
				</button>
				if follow != nil {
					<button class="btn" type="button" hx-post={ "/ui/artists/" + a.ID.String() + "/check" }>Check now</button>
					<button class="btn" type="button" hx-post={ "/ui/artists/" + a.ID.String() + "/unfollow" } hx-confirm={ "Stop following " + a.Name + "?" }>Unfollow</button>
					<span class="text-sm text-zinc-500">{ lastChecked(follow.LastChecked) }</span>
				}
				<span id="follow-result" class="text-sm text-red-600 dark:text-red-400" aria-live="polite"></span>
			</div>
		</form>
	}
}

templ followFilters(follow *db.Follow) {
	{{ f := db.DefaultFilters() }}
	if follow != nil {
		{{ f = follow.Filters }}
	}
	<fieldset>
		<legend class="mb-1 text-sm font-medium">Release types</legend>
		<div class="flex flex-wrap gap-4">
			for _, typ := range audio.ReleaseTypes {
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="type" value={ string(typ) } checked?={ slices.Contains(f.Types, string(typ)) }/>
					{ typ.Label() }
				</label>
			}
		</div>
	</fieldset>
	<fieldset>
		<legend class="mb-1 text-sm font-medium">Skip</legend>
		<div class="flex flex-wrap gap-4">
			for _, s := range db.SecondaryTypes {
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="skip" value={ s } checked?={ slices.Contains(f.SkipSecondary, s) }/>
					{ s }
				</label>
			}
		</div>
	</fieldset>
}

templ InboxPage(tab string, releases []*db.InboxRelease, newCount, ignoredCount int, follows []*db.Follow) {
	@layout("Inbox", PageInbox) {
		@pageHeader("Inbox", fmt.Sprintf("%s from %s", plural(newCount, "new release"), plural(len(follows), "followed artist"))) {
			if tab == "new" && len(releases) > 1 {
				<button class="btn" hx-post="/ui/inbox/confirm-all" hx-confirm={ fmt.Sprintf("Add all %d releases and download their missing tracks?", len(releases)) }>Confirm all</button>
			}
		}
		<nav class="mb-4 flex gap-4 text-sm" aria-label="Inbox tabs">
			@inboxTab("/inbox", "New", newCount, tab == "new")
			@inboxTab("/inbox?tab=ignored", "Ignored", ignoredCount, tab == "ignored")
		</nav>
		if len(follows) == 0 {
			@emptyState() {
				Follow artists on the Artists page to get their new releases here.
			}
		} else if len(releases) == 0 {
			@emptyState() {
				if tab == "ignored" {
					Nothing ignored.
				} else {
					Nothing new.
				}
			}
		}
		<div class="grid gap-4">
			for _, g := range groupInbox(releases) {
				<details class="inbox-group" data-artist={ g.ArtistID } open>
					<summary class="flex cursor-pointer flex-wrap items-center justify-between gap-2 py-1">
						<span class="font-semibold">{ g.Name } <span class="font-normal text-zinc-500">({ fmt.Sprint(len(g.Releases)) })</span></span>
						if tab == "new" && len(g.Releases) > 1 {
							<button
								class="btn"
								hx-post={ "/ui/inbox/confirm-all?artist=" + g.ArtistID }
								hx-confirm={ fmt.Sprintf("Add all %d releases by %s and download their missing tracks?", len(g.Releases), g.Name) }
							>Confirm all</button>
						}
					</summary>
					<div class="mt-2 grid gap-2">
						for _, r := range g.Releases {
							@inboxRelease(r, tab)
						}
					</div>
				</details>
			}
		</div>
		<script src="/assets/js/inbox.js" defer></script>
		if len(follows) > 0 {
			<h2 class="mt-10 mb-3 text-lg font-semibold">Following</h2>
			<ul class="card divide-y divide-zinc-200 dark:divide-zinc-700">
				for _, f := range follows {
					<li class="flex flex-wrap items-center justify-between gap-2 py-2">
						<a href={ templ.SafeURL("/artists/" + f.Artist.ID.String() + "/follow") }>{ f.Artist.Name }</a>
						<span class="text-sm text-zinc-500">{ lastChecked(f.LastChecked) }</span>
					</li>
				}
			</ul>
		}
	}
}

templ inboxTab(href, label string, n int, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={ "border-b-2 pb-1 no-underline", templ.KV("border-zinc-900 font-semibold dark:border-zinc-100", active), templ.KV("border-transparent text-zinc-500", !active) }
		if active {
			aria-current="page"
		}
	>{ fmt.Sprintf("%s (%d)", label, n) }</a>
}

templ inboxRelease(r *db.InboxRelease, tab string) {
	<article class="card py-2" id={ "inbox-" + r.ReleaseGroupMBID }>
		<div class="flex flex-wrap items-center gap-3">
			<img
				class="size-10 shrink-0 rounded bg-zinc-100 object-cover dark:bg-zinc-800"
				src={ r.Data.CoverURL }
				alt=""
				loading="lazy"
				onerror="this.onerror = null; this.src = '/assets/img/default_track.png'"
			/>
			<div class="min-w-0 flex-1">
				<h2 class="truncate font-semibold">
					<a href={ templ.SafeURL("https://musicbrainz.org/release-group/" + r.ReleaseGroupMBID) } target="_blank" rel="noopener">{ r.Title }</a>
				</h2>
				<p class="truncate text-sm text-zinc-500 dark:text-zinc-400">
					{ r.ArtistName } · { audio.ReleaseType(r.Type).Label() }
					if r.Date != "" {
						{ " · " + r.Date }
					}
					{ fmt.Sprintf(" · %d of %d in library", r.Owned(), len(r.Data.Tracks)) }
				</p>
			</div>
			<div class="flex gap-2">
				<button class="btn" type="button" hx-get={ "/ui/inbox/" + r.ReleaseGroupMBID } hx-target="next .inbox-details" hx-swap="innerHTML">Show tracklist</button>
				if tab == "ignored" {
					<button class="btn" hx-post={ "/ui/inbox/" + r.ReleaseGroupMBID + "/restore" }>Move back to New</button>
				} else {
					<button class="btn" hx-post={ "/ui/inbox/" + r.ReleaseGroupMBID + "/confirm" }>Confirm</button>
					<button class="btn" hx-post={ "/ui/inbox/" + r.ReleaseGroupMBID + "/ignore" }>Don't ask again</button>
				}
			</div>
		</div>
		<div class="inbox-details"></div>
	</article>
}

// InboxDetails is the part of an inbox row that opens on demand: the cover
// and the tracklist with owned tracks marked.
templ InboxDetails(r *db.InboxRelease) {
	<div class="mt-3 flex gap-4">
		<img
			class="size-32 shrink-0 rounded bg-zinc-100 object-cover dark:bg-zinc-800"
			src={ r.Data.CoverURL }
			alt=""
			loading="lazy"
			onerror="this.onerror = null; this.src = '/assets/img/default_track.png'"
		/>
		<ol class="min-w-0 flex-1 text-sm">
			for _, t := range r.Data.Tracks {
				<li class="flex gap-2">
					<span class="w-8 shrink-0 text-right text-zinc-500 tabular-nums">{ trackNumber(t) }</span>
					<span class="flex-1 truncate">{ t.Title }</span>
					if t.OwnedTrackID != "" {
						<span class="text-emerald-600 dark:text-emerald-400" title="In your library">✓</span>
					}
					<span class="text-zinc-500 tabular-nums">{ formatDuration(time.Duration(t.LengthMs) * time.Millisecond) }</span>
				</li>
			}
		</ol>
	</div>
}

// inboxGroup is one artist's releases, in the order they were listed.
type inboxGroup struct {
	ArtistID string
	Name     string
	Releases []*db.InboxRelease
}

// groupInbox groups releases by artist, sorted by name.
func groupInbox(releases []*db.InboxRelease) []inboxGroup {
	var groups []inboxGroup
	byArtist := map[string]int{}
	for _, r := range releases {
		i, ok := byArtist[r.ArtistID]
		if !ok {
			i = len(groups)
			byArtist[r.ArtistID] = i
			groups = append(groups, inboxGroup{ArtistID: r.ArtistID, Name: r.ArtistName})
		}
		groups[i].Releases = append(groups[i].Releases, r)
	}
	slices.SortStableFunc(groups, func(a, b inboxGroup) int {
		return strings.Compare(strings.ToLower(a.Name), strings.ToLower(b.Name))
	})
	return groups
}

func trackNumber(t db.InboxTrack) string {
	if t.Disc > 1 {
		return fmt.Sprintf("%d-%d", t.Disc, t.Position)
	}
	return fmt.Sprint(t.Position)
}

func lastChecked(at string) string {
	if at == "" {
		return "Not checked yet"
	}
	return "Checked " + at + " UTC"
}

// plural formats n with noun, adding an "s" unless n is 1.
func plural(n int, noun string) string {
	if n == 1 {
		return "1 " + noun
	}
	return fmt.Sprintf("%d %ss", n, noun)
}
