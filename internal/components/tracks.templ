package components

import (
	"context"
	"fmt"
	"sort"
	"strings"
	"time"

	"audioloader/internal/audio"
	"audioloader/internal/trim"
)

// Sort orders of the track list in secret mode.
const (
	SortAdded   = "added"
	SortCreator = "creator"
	SortTag     = "tag"
)

// TracksPage lists the library. Secret mode has no releases to browse by,
// so its list can be sorted by date added (newest first, as the tracks
// come), creator or tag.
templ TracksPage(tracks []*audio.Track, continueListening []*audio.Track, sortBy string) {
	@layout("Tracks", PageTracks) {
		@pageHead("Tracks", fmt.Sprintf("%d in library", len(tracks))) {
			if secretMode(ctx) {
				@segmented("Sort tracks", []SegOption{
					{Label: "Added", Href: "/tracks?sort=" + SortAdded, On: sortBy == SortAdded},
					{Label: "Creator", Href: "/tracks?sort=" + SortCreator, On: sortBy == SortCreator},
					{Label: "Tag", Href: "/tracks?sort=" + SortTag, On: sortBy == SortTag},
				})
			} else {
				<a class="btn btn-ghost" href="/add">Add</a>
			}
			@filterInput("Filter tracks")
		}
		@ContinueListening(continueListening)
		if secretMode(ctx) {
			for _, g := range GroupTracks(tracks, sortBy) {
				<section class="mb-6">
					if g.Title != "" {
						@sectionLabel(g.Title)
					}
					@TrackList(g.Tracks)
				</section>
			}
			if len(tracks) == 0 {
				@TrackList(tracks)
			}
		} else {
			@TrackList(tracks)
		}
	}
}

// TrackGroup is a titled run of tracks on the secret track list.
type TrackGroup struct {
	Title  string
	Tracks []*audio.Track
}

// GroupTracks splits tracks (newest first) for a sort order. By creator or
// tag a track is listed under each of its creators or tags, groups ordered
// by name, with the tracks lacking one last.
func GroupTracks(tracks []*audio.Track, sortBy string) []TrackGroup {
	keys := func(t *audio.Track) []string { return nil }
	none := ""
	switch sortBy {
	case SortCreator:
		none = "No creator"
		keys = func(t *audio.Track) []string {
			names := make([]string, len(t.Artists))
			for i, a := range t.Artists {
				names[i] = a.Name
			}
			return names
		}
	case SortTag:
		none = "Untagged"
		keys = func(t *audio.Track) []string { return t.Tags }
	default:
		return []TrackGroup{{Tracks: tracks}}
	}
	byKey := map[string]*TrackGroup{}
	var order []string
	var rest []*audio.Track
	for _, t := range tracks {
		ks := keys(t)
		if len(ks) == 0 {
			rest = append(rest, t)
		}
		for _, k := range ks {
			id := strings.ToLower(k)
			if byKey[id] == nil {
				byKey[id] = &TrackGroup{Title: k}
				order = append(order, id)
			}
			byKey[id].Tracks = append(byKey[id].Tracks, t)
		}
	}
	sort.Strings(order)
	groups := make([]TrackGroup, 0, len(order)+1)
	for _, id := range order {
		groups = append(groups, *byKey[id])
	}
	if len(rest) > 0 {
		groups = append(groups, TrackGroup{Title: none, Tracks: rest})
	}
	return groups
}

// uploadForms starts with the kind of release. A single is uploaded right
// here; an album, EP or compilation is created first and its tracks are then
// uploaded together in batch mode. The switch is CSS only (group-has).
templ uploadForms(artists []*audio.Artist, shows []*audio.Show) {
	<div class="group">
		<fieldset class="mb-4">
			<legend class="mb-2 text-sm font-medium">What are you uploading?</legend>
			<div class="flex flex-wrap gap-2">
				if secretMode(ctx) {
					// secret tracks have no releases
					@kindChoice("kind-single", "single", "Track", true)
				}
				for _, typ := range audio.ReleaseTypes {
					if !secretMode(ctx) {
												@kindChoice("kind-"+string(typ), string(typ), typ.Label(), typ == audio.ReleaseSingle)
					}
				}
								@kindChoice("kind-episode", "episode", "Podcast episode", false)
			</div>
		</fieldset>
		<div class="hidden group-has-[#kind-single:checked]:block">
			@AddTrackForm(artists)
		</div>
		if !secretMode(ctx) {
			<div class="hidden group-has-[#kind-album:checked]:block group-has-[#kind-ep:checked]:block group-has-[#kind-compilation:checked]:block">
				@NewReleaseForm(artists, true)
			</div>
		}
		<div class="hidden group-has-[#kind-episode:checked]:block">
			@EpisodeForm(shows)
		</div>
	</div>
}

templ AddTrackForm(artists []*audio.Artist) {
	<section class="form-panel">
		<form
			id="upload-form"
			class="grid max-w-lg gap-4"
			hx-post="/ui/tracks"
			hx-encoding="multipart/form-data"
			hx-target="#result-tracks"
			hx-on::after-request="
				if (event.detail.successful) this.reset();
				else document.getElementById('result-tracks').textContent = event.detail.xhr.responseText || 'Upload failed.';
			"
		>
			<div>
				<label for="track-title" class="mb-1 block text-xs font-medium text-fg-muted">Title</label>
				<input id="track-title" class="input" type="text" name="title" placeholder="Track name" required/>
			</div>
			<div>
				<span class="mb-1 block text-sm font-medium">
					if secretMode(ctx) {
						Creators
					} else {
						Artists
					}
				</span>
				@artistPicker(artists, nil)
				if len(artists) == 0 {
					<small class="mt-1 block text-fg-muted">No artists yet. <a href="/artists">Add one first</a>.</small>
				}
			</div>
			if secretMode(ctx) {
				@secretTrackFields("", nil)
			} else {
				<div>
					<label for="track-date" class="mb-1 block text-xs font-medium text-fg-muted">Release date <span class="font-normal text-fg-muted">(optional)</span></label>
					<input
						id="track-date"
						class="input"
						type="text"
						name="date"
						placeholder="YYYY or YYYY-MM-DD"
						pattern="\d{4}(-\d{2}(-\d{2})?)?"
						title="YYYY, YYYY-MM or YYYY-MM-DD"
					/>
				</div>
			}
			<div>
				<label for="track-file" class="mb-1 block text-xs font-medium text-fg-muted">Audio file</label>
				<input
					id="track-file"
					class="input file:mr-3 file:rounded file:border-0 file:bg-panel file:px-2 file:py-1 file:text-sm"
					type="file"
					name="track"
					required
					accept="audio/*,.mp3,.opus,.flac,.ogg,.wav,.m4a,.aac"
				/>
				<small id="track-file-status" class="mt-1 block empty:hidden data-[state=exists]:text-st-review data-[state=pending]:text-fg-muted" aria-live="polite"></small>
			</div>
			<div>
				<button class="btn disabled:cursor-not-allowed disabled:opacity-50" type="submit">Upload</button>
			</div>
		</form>
		<div id="result-tracks" class="mt-4 text-sm" aria-live="polite"></div>
	</section>
	<script src="/assets/js/artist-picker.js" defer></script>
	<script src="/assets/js/track-hash.js" defer></script>
	<script src="/assets/js/upload.js" defer></script>
}

templ Track(t *audio.Track) {
	@trackRow(t, nil, 0)
}

// trackRow is a track list row; n is its number in the list (0 for none).
// highlight is a set of lower-case tags to show in the accent colour on a
// secret track (the Tags page uses it). The # cell is the play button: the
// number, a play glyph on hover, the playing bars while it plays.
templ trackRow(t *audio.Track, highlight map[string]bool, n int) {
	<article class={ "row row-track group/row", templ.KV("is-missing", !t.HasFile) } data-track-row data-filter-row>
		if t.HasFile {
			<button type="button" class="play" aria-label={ "Play " + t.Title } aria-pressed="false" data-bare { playAttrs(t)... }>
				<span class="n">{ trackNo(n) }</span>
				<span class="go">@iconClass("play", "size-3.5")</span>
				@eqBars()
			</button>
		} else {
			<span class="play" title="Not in the library yet"><span class="n">{ trackNo(n) }</span></span>
		}
		@cover(t.ImgURL, 28)
		<div class="stack">
			<b class="group-has-[[aria-pressed=true]]/row:text-accent" { descriptionAttr(t)... }>{ t.Title }</b>
			<span>
				@artistLinks(t.Artists)
			</span>
			@coverOfLine(t)
			<span class="alb-line min-[720px]:hidden">
				if t.Secret {
					{ strings.Join(t.Tags, " · ") }
				} else {
					@trackReleaseLabel(t)
				}
			</span>
		</div>
		<div class="flex min-w-0 items-center gap-1.5 text-fg-muted max-[719px]:hidden">
			if t.Secret {
				@trackTags(t, highlight)
			} else {
				@trackAlbumCell(t)
			}
			if !t.HasFile {
				@chip("missing")
			}
		</div>
		<span class="mono text-right text-fg-muted">{ formatDuration(t.Duration) }</span>
		@trackMenu(t)
	</article>
}

// descriptionAttr shows a secret track's description as a tooltip on its
// title: the row has no room for a line of it.
func descriptionAttr(t *audio.Track) templ.Attributes {
	if t.Secret && t.Description != "" {
		return templ.Attributes{"title": t.Description}
	}
	return nil
}

func trackNo(n int) string {
	if n <= 0 {
		return ""
	}
	return fmt.Sprintf("%02d", n)
}

// trackAlbumCell is the album column: the main release, or the single.
templ trackAlbumCell(t *audio.Track) {
	if main, single := mainRelease(t), firstSingle(t); main != nil {
		<a class="truncate" href={ templ.SafeURL("/releases/" + main.ID.String()) }>{ main.Title }</a>
		if single != nil {
			@chip("also a single")
		}
	} else if single != nil {
		<a class="truncate" href={ templ.SafeURL("/releases/" + single.ID.String()) }>{ "Single" + yearSuffix(single) }</a>
	}
}

func yearSuffix(r *audio.Release) string {
	if r.Year() != "" {
		return " · " + r.Year()
	}
	return ""
}

// trackTags are a secret track's tags as chips, on one line.
templ trackTags(t *audio.Track, highlight map[string]bool) {
	<span class="flex min-w-0 flex-nowrap gap-1 overflow-hidden">
		for _, tag := range t.Tags {
			if highlight[strings.ToLower(tag)] {
				@chipAccent(tag)
			} else {
				@chip(tag)
			}
		}
	</span>
}

// playAttrs are what the player (player.js) reads off a play button.
func playAttrs(t *audio.Track) templ.Attributes {
	a := templ.Attributes{
		"data-play-track": true,
		"data-id":         t.ID.String(),
		"data-title":      t.Title,
		"data-artists":    artistNames(t.Artists),
		"data-img":        t.ImgURL,
		"data-src":        "/api/tracks/" + t.ID.String() + "/stream",
	}
	if t.CoverOf != nil {
		a["data-cover-of"] = t.CoverOf.String()
	}
	if t.Secret {
		a["data-secret"] = "1"
	}
	if t.IsEpisode() {
		a["data-kind"] = "episode"
		a["data-show"] = t.ShowID
		if !t.Finished {
			a["data-position"] = fmt.Sprint(int(t.Position.Seconds()))
		}
	}
	return a
}

// trackMenu offers queueing a track; player.js handles its buttons. It
// reads the track from the play button in the same [data-track-row].
templ trackMenu(t *audio.Track) {
	if t.HasFile {
		<details class="relative" data-track-menu>
			<summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-md text-fg-muted hover:text-fg min-[720px]:size-8" aria-label={ "More for " + t.Title }>@icon("more")</summary>
			<div class="pop absolute right-0 z-10 mt-1 grid w-48">
				<button type="button" class="menu-item" data-queue="next">Play next</button>
				<button type="button" class="menu-item" data-queue="add">Add to queue</button>
				<button
					type="button"
					class="menu-item"
					hx-get={ "/ui/playlists/picker?track_id=" + t.ID.String() }
					hx-swap="outerHTML"
				>Add to playlist…</button>
				<a class="menu-item" href={ templ.SafeURL("/tracks/" + t.ID.String() + "/edit") }>Edit</a>
				if !t.IsEpisode() && !t.Secret {
					<a class="menu-item" href={ templ.SafeURL("/tracks/" + t.ID.String() + "/edit#cover-of") }>Set cover of…</a>
				}
				<button
					type="button"
					class="menu-item"
					hx-get={ "/ui/tracks/" + t.ID.String() + "/trim" }
					hx-swap="outerHTML"
				>Trim silence…</button>
				<button
					type="button"
					class="menu-item"
					hx-post={ "/ui/tracks/" + t.ID.String() + "/delete" }
					hx-confirm={ deleteConfirm(t) }
				>Delete</button>
				if vaultEnabled(ctx) {
					<button
						type="button"
						class="menu-item"
						hx-post={ "/ui/tracks/" + t.ID.String() + "/secret" }
						hx-confirm={ secretConfirm(t) }
					>
						if t.Secret {
							Make public
						} else {
							Make secret
						}
					</button>
				}
			</div>
		</details>
	} else {
		<span></span>
	}
}

// playButton hands t to the global player (player.js); size sets the button's size classes.
templ playButton(t *audio.Track, size string) {
	if !t.HasFile {
		<span
			class={ "btn btn-ghost shrink-0 self-center aspect-square min-h-0 justify-center rounded-full p-0 text-xs opacity-40", size }
			title="Not in the library yet"
			aria-label={ t.Title + " is not in the library yet" }
		>–</span>
	} else {
		@playableButton(t, size)
	}
}

templ playableButton(t *audio.Track, size string) {
	<button
		type="button"
		class={ "btn shrink-0 self-center aspect-square min-h-0 justify-center rounded-full p-0 text-xs", size }
		aria-label={ "Play " + t.Title }
		aria-pressed="false"
		{ playAttrs(t)... }
	>
		<span data-icon-play>@iconClass("play", "size-3.5")</span>
		<span data-icon-pause hidden>@iconClass("pause", "size-3.5")</span>
	</button>
}

// coverOfLine says which song a cover is of, linking to the original in the
// library or on MusicBrainz.
templ coverOfLine(t *audio.Track) {
	if c := t.CoverOf; c != nil {
		<span class="block truncate text-xs text-fg-muted">
			{ "Cover of " }
			if u := coverOfURL(c); u != "" {
				<a href={ u }>{ c.Title }</a>
			} else {
				<em>{ c.Title }</em>
			}
			if c.Artists != "" {
				{ " by " + c.Artists }
			}
		</span>
	}
}

// coverOfURL is where the original lives: its release page, or its
// MusicBrainz recording. "" for a plain text reference.
func coverOfURL(c *audio.CoverRef) templ.SafeURL {
	switch {
	case c.ReleaseID != "":
		return templ.SafeURL("/releases/" + c.ReleaseID)
	case c.TrackID != "":
		return searchURL(c.Title)
	case c.MBID != "":
		return templ.SafeURL("https://musicbrainz.org/recording/" + c.MBID)
	}
	return ""
}

// trackReleaseLabel names where a track comes from. An album, EP or
// compilation wins over a single, so a song released both ways is listed
// once, under its album, with a note that it was also a single.
templ trackReleaseLabel(t *audio.Track) {
	if main, single := mainRelease(t), firstSingle(t); main != nil {
		{ main.Title }
		if single != nil {
			{ " · also a single" }
		}
	} else if single != nil {
		{ "Single" + yearSuffix(single) }
	}
}

func mainRelease(t *audio.Track) *audio.Release {
	for _, r := range t.Releases {
		if !r.IsSingle() {
			return r
		}
	}
	return nil
}

func firstSingle(t *audio.Track) *audio.Release {
	for _, r := range t.Releases {
		if r.IsSingle() {
			return r
		}
	}
	return nil
}

func artistNames(artists []*audio.Artist) string {
	names := make([]string, len(artists))
	for i, a := range artists {
		names[i] = a.Name
	}
	return strings.Join(names, ", ")
}

templ TrackList(tracks []*audio.Track) {
	if len(tracks) == 0 {
		@emptyState() {
			No tracks yet. <a href="/add">Add one</a>.
		}
	} else {
		// data-track-list: playing a track queues the rest of the list after it
		<div class="list" data-track-list data-filter-rows>
			@listHead("row-track", "#", "", "Title", trackAlbumHead(ctx), ">Time", "")
			for i, track := range tracks {
				@trackRow(track, nil, i+1)
			}
		</div>
	}
}

func trackAlbumHead(ctx context.Context) string {
	if secretMode(ctx) {
		return "Tags"
	}
	return "Album"
}

// formatDuration renders d as m:ss, or h:mm:ss for long tracks.
func formatDuration(d time.Duration) string {
	s := int(d.Round(time.Second).Seconds())
	if s >= 3600 {
		return fmt.Sprintf("%d:%02d:%02d", s/3600, s%3600/60, s%60)
	}
	return fmt.Sprintf("%d:%02d", s/60, s%60)
}

// TrimPreview is swapped into the track menu: what a trim would do, with a
// button to do it, or why it can't.
templ TrimPreview(t *audio.Track, p trim.Plan, errMsg string) {
	<div class="mt-1 grid gap-1 border-t border-line px-2 pt-1">
		if errMsg != "" {
			<p class="text-st-failed">{ errMsg }</p>
		} else if p.None() {
			<p>No silence at the end</p>
		} else {
			<p class="flex items-center gap-1">
				<span>{ formatDuration(p.Total) }</span>
				@icon("arrow-right")
				<span>{ formatDuration(p.CutAt) }</span>
			</p>
			<button
				type="button"
				class="menu-item"
				hx-post={ "/ui/tracks/" + t.ID.String() + "/trim" }
				hx-confirm={ trimConfirm(t, p) }
				hx-indicator="next .htmx-indicator"
			>Trim</button>
			<span class="htmx-indicator text-fg-muted">Trimming…</span>
		}
	</div>
}

func trimConfirm(t *audio.Track, p trim.Plan) string {
	return fmt.Sprintf("Cut %s of silence from the end of “%s”? This can't be undone.", formatDuration(p.Saved()), t.Title)
}

// secretConfirm is the question before a track moves to the other mode.
// Moving it to secret mode takes it off its releases, which it names.
func secretConfirm(t *audio.Track) string {
	if t.Secret {
		return "Make " + t.Title + " public? It will be on no release."
	}
	if len(t.Releases) == 0 {
		return "Make " + t.Title + " secret?"
	}
	titles := make([]string, len(t.Releases))
	for i, r := range t.Releases {
		titles[i] = r.Title
	}
	return "Make " + t.Title + " secret? It will leave " + strings.Join(titles, ", ") + ", and a release left with no tracks is deleted."
}

// TrackEditPage edits a track's title, artists and secret flag. Only an
// episode can change kind, and only into a song.
templ TrackEditPage(t *audio.Track, artists []*audio.Artist, uploader string) {
	@layout("Edit "+t.Title, PageTracks) {
		@pageHead("Edit track", t.Title) {
			<a class="btn btn-ghost" href="/tracks">Cancel</a>
		}
		if uploader != "" {
			<p class="mb-4 text-sm">@UploaderLink(uploader)</p>
		}
		<form
			class="form-panel"
			hx-post={ "/ui/tracks/" + t.ID.String() }
			hx-target="#track-edit-result"
			hx-on::after-request="if (!event.detail.successful) document.getElementById('track-edit-result').textContent = event.detail.xhr.responseText || 'Could not save.'"
		>
			<div>
				<label for="track-title" class="mb-1 block text-xs font-medium text-fg-muted">Title</label>
				<input id="track-title" class="input" type="text" name="title" value={ t.Title } required/>
			</div>
			<div>
				<span class="mb-1 block text-sm font-medium">
					if t.Secret {
						Creators
					} else {
						Artists
					}
				</span>
				@artistPicker(artists, artistIDs(t.Artists))
			</div>
			if t.Secret {
				@secretTrackFields(t.Description, t.Tags)
			}
			if t.IsEpisode() {
				<div>
					<label for="track-kind" class="mb-1 block text-xs font-medium text-fg-muted">Kind</label>
					<select id="track-kind" class="input" name="kind">
						<option value="episode" selected>Podcast episode</option>
						<option value="music">Song (needs an artist)</option>
					</select>
				</div>
			} else {
				<input type="hidden" name="kind" value="music"/>
			}
			if !t.IsEpisode() && !t.Secret {
				@coverOfFields(t)
			}
			<div class="flex items-center gap-4">
				<button class="btn" type="submit">Save</button>
				<span id="track-edit-result" class="text-sm text-st-failed" aria-live="polite"></span>
			</div>
		</form>
		if t.Secret {
			@trackImageForm(t)
		}
		<script src="/assets/js/artist-picker.js" defer></script>
	}
}

// secretTrackFields are the fields a secret track has in place of releases
// and a cover: a description and comma separated tags.
templ secretTrackFields(description string, tags []string) {
	<div>
		<label for="track-description" class="mb-1 block text-xs font-medium text-fg-muted">Description <span class="font-normal text-fg-muted">(optional)</span></label>
		<textarea id="track-description" class="input" name="description" rows="4">{ description }</textarea>
	</div>
	<div>
		<label for="track-tags" class="mb-1 block text-xs font-medium text-fg-muted">Tags <span class="font-normal text-fg-muted">(optional, separated by commas)</span></label>
		<input id="track-tags" class="input" type="text" name="tags" value={ strings.Join(tags, ", ") } maxlength="800"/>
	</div>
}

// trackImageForm sets the picture of a secret track.
templ trackImageForm(t *audio.Track) {
	<form
		class="form-panel mt-6"
		hx-post={ "/ui/tracks/" + t.ID.String() + "/image" }
		hx-encoding="multipart/form-data"
		hx-target="#track-image-result"
		hx-on::after-request="if (!event.detail.successful) document.getElementById('track-image-result').textContent = event.detail.xhr.responseText || 'Could not upload the picture.'"
	>
		<img class="pixelated size-24 rounded bg-panel-2 object-cover" src={ t.ImgURL } alt=""/>
		<label for="track-image" class="text-xs font-medium text-fg-muted">Picture (JPEG, PNG or WebP, up to 10 MiB)</label>
		<input id="track-image" type="file" name="image" accept="image/jpeg,image/png,image/webp" required/>
		<div class="flex flex-wrap items-center gap-4">
			<button class="btn" type="submit">Upload picture</button>
			<button
				type="button"
				class="btn"
				hx-post={ "/ui/tracks/" + t.ID.String() + "/image/remove" }
				hx-confirm="Go back to the placeholder picture?"
			>Remove picture</button>
			<span id="track-image-result" class="text-sm text-st-failed" aria-live="polite"></span>
		</div>
	</form>
}

// coverOfFields is the "Cover of" part of the edit form. cover_mode picks
// what the fields below it mean; "keep" leaves the cover as it is, which is
// also right for a hidden original (the form can't show it).
templ coverOfFields(t *audio.Track) {
	<fieldset id="cover-of" class="group grid gap-3 rounded-md border border-line p-3">
		<legend class="px-1 text-sm font-medium">Cover of</legend>
		if t.CoverOf != nil {
			<p class="text-sm text-fg-muted">Now: { t.CoverOf.String() }</p>
		}
		<select id="cover-mode" class="input" name="cover_mode" aria-label="Set the original song by">
			<option value="keep" selected>Leave as it is</option>
			<option id="cover-opt-library" value="library">Pick a track in the library</option>
			<option id="cover-opt-text" value="text">Title and artist as text</option>
			<option id="cover-opt-mbid" value="mbid">MusicBrainz recording URL</option>
			<option value="none">Not a cover (remove)</option>
		</select>
		<div class="hidden group-has-[#cover-opt-library:checked]:block">
			<input type="hidden" id="cover-track-id" name="cover_track_id"/>
			<input
				class="input"
				type="search"
				name="q"
				placeholder="Search the library"
				autocomplete="off"
				aria-label="Search for the original track"
				hx-get="/ui/tracks/pick"
				hx-trigger="input changed delay:250ms"
				hx-target="#cover-pick-results"
				hx-vals={ `{"exclude": "` + t.ID.String() + `"}` }
				hx-on:keydown="if (event.key === 'Enter') event.preventDefault()"
			/>
			<p id="cover-track-label" class="mt-1 text-sm text-fg-muted empty:hidden"></p>
			<div id="cover-pick-results"></div>
		</div>
		<div class="hidden gap-2 group-has-[#cover-opt-text:checked]:grid">
			<input class="input" type="text" name="cover_title" placeholder="Original title" aria-label="Original title"/>
			<input class="input" type="text" name="cover_artists" placeholder="Original artists, e.g. A &amp; B" aria-label="Original artists"/>
		</div>
		<div class="hidden group-has-[#cover-opt-mbid:checked]:block">
			<input class="input" type="url" name="cover_mb_url" placeholder="https://musicbrainz.org/recording/…" aria-label="MusicBrainz recording URL"/>
			<small class="mt-1 block text-fg-muted">Title and artists are looked up when you save.</small>
		</div>
	</fieldset>
}

// CoverPickResults lists library songs to pick as a cover's original;
// choosing one fills the form's cover_track_id.
templ CoverPickResults(tracks []*audio.Track) {
	if len(tracks) == 0 {
		<p class="mt-1 text-sm text-fg-muted">Nothing matches.</p>
	} else {
		<ul class="mt-1 rounded-md border border-line bg-panel p-1 text-sm">
			for _, t := range tracks {
				<li>
					<button
						type="button"
						class="block w-full truncate rounded px-2 py-1 text-left hover:bg-panel-2"
						data-id={ t.ID.String() }
						data-label={ coverPickLabel(t) }
						hx-on:click="document.getElementById('cover-track-id').value = this.dataset.id; document.getElementById('cover-track-label').textContent = 'Picked: ' + this.dataset.label; document.getElementById('cover-mode').value = 'library'; this.closest('ul').remove()"
					>
						{ t.Title }<span class="text-fg-muted">{ " · " + artistNames(t.Artists) }</span>
					</button>
				</li>
			}
		</ul>
	}
}

func coverPickLabel(t *audio.Track) string {
	if len(t.Artists) == 0 {
		return t.Title
	}
	return t.Title + " by " + artistNames(t.Artists)
}

// deleteConfirm is the text of the delete dialog: it names the track and the
// releases it will disappear from.
func deleteConfirm(t *audio.Track) string {
	msg := "Delete " + t.Title + " and its file?"
	if len(t.Releases) > 0 {
		titles := make([]string, len(t.Releases))
		for i, r := range t.Releases {
			titles[i] = r.Title
		}
		msg += " It will be removed from " + strings.Join(titles, ", ") + "."
	}
	return msg
}
