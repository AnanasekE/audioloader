package components

import (
	"fmt"
	"strings"
	"time"

	"audioloader/internal/audio"
)

templ TracksPage(tracks []*audio.Track, continueListening []*audio.Track) {
	@layout("Tracks", PageTracks) {
		@pageHeader("Tracks", fmt.Sprintf("%d in library", len(tracks))) {
			<a class="btn" href="/upload">Upload track</a>
		}
		@ContinueListening(continueListening)
		@TrackList(tracks)
	}
}

// UploadPage starts with the kind of release. A single is uploaded right
// here; an album, EP or compilation is created first and its tracks are then
// uploaded together in batch mode. The switch is CSS only (group-has).
templ UploadPage(artists []*audio.Artist, shows []*audio.Show) {
	@layout("Upload", PageUpload) {
		@pageHeader("Upload", "Add music to the library") {
			<div class="flex flex-wrap gap-2">
				<a class="btn" href="/upload/import">Import library</a>
				<a class="btn" href="/upload/batch">Batch mode</a>
				<a class="btn" href="/upload/youtube">From YouTube</a>
			</div>
		}
		<div class="group">
			<fieldset class="mb-4">
				<legend class="mb-2 text-sm font-medium">What are you uploading?</legend>
				<div class="flex flex-wrap gap-2">
					for _, typ := range audio.ReleaseTypes {
						<label class="cursor-pointer rounded-md border border-zinc-300 px-3 py-1.5 text-sm has-[:checked]:border-zinc-900 has-[:checked]:bg-zinc-900 has-[:checked]:text-white has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-sky-500 dark:border-zinc-700 dark:has-[:checked]:border-zinc-100 dark:has-[:checked]:bg-zinc-100 dark:has-[:checked]:text-zinc-900">
							// form= ties the choice to the release form, which needs the type
							<input id={ "kind-" + string(typ) } class="sr-only" type="radio" name="type" value={ string(typ) } form="new-release-form" checked?={ typ == audio.ReleaseSingle }/>
							{ typ.Label() }
						</label>
					}
					<label class="cursor-pointer rounded-md border border-zinc-300 px-3 py-1.5 text-sm has-[:checked]:border-zinc-900 has-[:checked]:bg-zinc-900 has-[:checked]:text-white has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-sky-500 dark:border-zinc-700 dark:has-[:checked]:border-zinc-100 dark:has-[:checked]:bg-zinc-100 dark:has-[:checked]:text-zinc-900">
						// not part of the release form: an episode isn't a release
						<input id="kind-episode" class="sr-only" type="radio" name="type" value="episode" form="episode-form"/>
						Podcast episode
					</label>
				</div>
			</fieldset>
			<div class="hidden group-has-[#kind-single:checked]:block">
				@AddTrackForm(artists)
			</div>
			<div class="hidden group-has-[#kind-album:checked]:block group-has-[#kind-ep:checked]:block group-has-[#kind-compilation:checked]:block">
				@NewReleaseForm(artists, true)
			</div>
			<div class="hidden group-has-[#kind-episode:checked]:block">
				@EpisodeForm(shows)
			</div>
		</div>
	}
}

templ AddTrackForm(artists []*audio.Artist) {
	<section class="card">
		<form
			id="upload-form"
			class="grid max-w-lg gap-4"
			hx-post="/ui/tracks"
			hx-encoding="multipart/form-data"
			hx-target="#result-tracks"
			hx-on::after-request="
				if (event.detail.successful) this.reset();
				else document.getElementById('result-tracks').textContent = event.detail.xhr.responseText || 'Upload failed.';
			"
		>
			<div>
				<label for="track-title" class="mb-1 block text-sm font-medium">Title</label>
				<input id="track-title" class="input" type="text" name="title" placeholder="Track name" required/>
			</div>
			<div>
				<span class="mb-1 block text-sm font-medium">Artists</span>
				@artistPicker(artists, nil)
				if len(artists) == 0 {
					<small class="mt-1 block text-zinc-500">No artists yet. <a href="/artists">Add one first</a>.</small>
				}
			</div>
			<div>
				<label for="track-date" class="mb-1 block text-sm font-medium">Release date <span class="font-normal text-zinc-500">(optional)</span></label>
				<input
					id="track-date"
					class="input"
					type="text"
					name="date"
					placeholder="YYYY or YYYY-MM-DD"
					pattern="\d{4}(-\d{2}(-\d{2})?)?"
					title="YYYY, YYYY-MM or YYYY-MM-DD"
				/>
			</div>
			<div>
				<label for="track-file" class="mb-1 block text-sm font-medium">Audio file</label>
				<input
					id="track-file"
					class="input file:mr-3 file:rounded file:border-0 file:bg-zinc-200 file:px-2 file:py-1 file:text-sm dark:file:bg-zinc-700"
					type="file"
					name="track"
					required
					accept="audio/*,.mp3,.opus,.flac,.ogg,.wav,.m4a,.aac"
				/>
				<small id="track-file-status" class="mt-1 block empty:hidden data-[state=exists]:text-amber-600 data-[state=pending]:text-zinc-500 dark:data-[state=exists]:text-amber-400" aria-live="polite"></small>
			</div>
			if vaultOpen(ctx) {
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="secret" value="1"/>
					Secret: only shown while the vault is unlocked
				</label>
			}
			<div>
				<button class="btn disabled:cursor-not-allowed disabled:opacity-50" type="submit">Upload</button>
			</div>
		</form>
		<div id="result-tracks" class="mt-4 text-sm" aria-live="polite"></div>
	</section>
	<script src="/assets/js/artist-picker.js" defer></script>
	<script src="/assets/js/track-hash.js" defer></script>
	<script src="/assets/js/upload.js" defer></script>
}

templ Track(t *audio.Track) {
	<article class="grid grid-cols-[auto_3.5rem_1fr_auto_auto] items-center gap-x-4 py-3" data-track-row>
		@playButton(t, "size-10")
		<img class="pixelated size-14 rounded bg-zinc-100 object-cover dark:bg-zinc-800" src={ t.ImgURL } alt=""/>
		<div class="flex min-w-0 flex-col">
			<strong class="truncate">
				{ t.Title }
				if t.Secret {
					<span class="ml-1 rounded bg-zinc-200 px-1 text-xs font-normal dark:bg-zinc-700">secret</span>
				}
			</strong>
			<span class="truncate text-sm text-zinc-500 dark:text-zinc-400">
				{ artistNames(t.Artists) }
				@trackReleaseLabel(t)
			</span>
		</div>
		<span class="text-sm text-zinc-500 tabular-nums dark:text-zinc-400">{ formatDuration(t.Duration) }</span>
		@trackMenu(t)
	</article>
}

// trackMenu offers queueing a track; player.js handles its buttons. It
// reads the track from the play button in the same [data-track-row].
templ trackMenu(t *audio.Track) {
	if t.HasFile {
		<details class="relative" data-track-menu>
			<summary class="btn cursor-pointer list-none px-2" aria-label={ "More for " + t.Title }>⋯</summary>
			<div class="absolute right-0 z-10 mt-1 grid w-44 rounded-md border border-zinc-300 bg-white p-1 text-sm shadow-lg dark:border-zinc-700 dark:bg-zinc-800">
				<button type="button" class="rounded px-2 py-1 text-left hover:bg-zinc-100 dark:hover:bg-zinc-700" data-queue="next">Play next</button>
				<button type="button" class="rounded px-2 py-1 text-left hover:bg-zinc-100 dark:hover:bg-zinc-700" data-queue="add">Add to queue</button>
				<button
					type="button"
					class="rounded px-2 py-1 text-left hover:bg-zinc-100 dark:hover:bg-zinc-700"
					hx-get={ "/ui/playlists/picker?track_id=" + t.ID.String() }
					hx-swap="outerHTML"
				>Add to playlist…</button>
				<a class="rounded px-2 py-1 text-left text-inherit hover:bg-zinc-100 hover:no-underline dark:text-inherit dark:hover:bg-zinc-700" href={ templ.SafeURL("/tracks/" + t.ID.String() + "/edit") }>Edit</a>
				<button
					type="button"
					class="rounded px-2 py-1 text-left hover:bg-zinc-100 dark:hover:bg-zinc-700"
					hx-post={ "/ui/tracks/" + t.ID.String() + "/delete" }
					hx-confirm={ deleteConfirm(t) }
				>Delete</button>
				if vaultOpen(ctx) {
					<button
						type="button"
						class="rounded px-2 py-1 text-left hover:bg-zinc-100 dark:hover:bg-zinc-700"
						hx-post={ "/ui/tracks/" + t.ID.String() + "/secret" }
						hx-vals={ secretToggle(t) }
					>
						if t.Secret {
							Make public
						} else {
							Make secret
						}
					</button>
				}
			</div>
		</details>
	} else {
		<span></span>
	}
}

// playButton hands t to the global player (player.js); size sets the button's size classes.
templ playButton(t *audio.Track, size string) {
	if !t.HasFile {
		<span
			class={ "btn shrink-0 justify-center rounded-full p-0 opacity-40", size }
			title="Not in the library yet"
			aria-label={ t.Title + " is not in the library yet" }
		>–</span>
	} else {
		@playableButton(t, size)
	}
}

templ playableButton(t *audio.Track, size string) {
	<button
		type="button"
		class={ "btn shrink-0 justify-center rounded-full p-0", size }
		aria-label={ "Play " + t.Title }
		aria-pressed="false"
		data-play-track
		data-id={ t.ID.String() }
		data-title={ t.Title }
		data-artists={ artistNames(t.Artists) }
		data-img={ t.ImgURL }
		data-src={ "/api/tracks/" + t.ID.String() + "/stream" }
		if t.Secret {
			data-secret="1"
		}
		if t.IsEpisode() {
			data-kind="episode"
			data-show={ t.ShowID }
			if !t.Finished {
				data-position={ fmt.Sprint(int(t.Position.Seconds())) }
			}
		}
	>▶</button>
}

// trackReleaseLabel names where a track comes from. An album, EP or
// compilation wins over a single, so a song released both ways is listed
// once, under its album, with a note that it was also a single.
templ trackReleaseLabel(t *audio.Track) {
	// separators are string expressions: templ drops plain whitespace next to a component call
	if main, single := mainRelease(t), firstSingle(t); main != nil {
		{ " · " }
		<a href={ templ.SafeURL("/releases/" + main.ID.String()) }>{ main.Title }</a>
		if single != nil {
			{ " · also a single" }
		}
	} else if single != nil {
		{ " · " }
		<a href={ templ.SafeURL("/releases/" + single.ID.String()) }>Single</a>
		if single.Year() != "" {
			{ " · " + single.Year() }
		}
	}
}

func mainRelease(t *audio.Track) *audio.Release {
	for _, r := range t.Releases {
		if !r.IsSingle() {
			return r
		}
	}
	return nil
}

func firstSingle(t *audio.Track) *audio.Release {
	for _, r := range t.Releases {
		if r.IsSingle() {
			return r
		}
	}
	return nil
}

func artistNames(artists []*audio.Artist) string {
	names := make([]string, len(artists))
	for i, a := range artists {
		names[i] = a.Name
	}
	return strings.Join(names, ", ")
}

templ TrackList(tracks []*audio.Track) {
	if len(tracks) == 0 {
		@emptyState() {
			No tracks yet. <a href="/upload">Upload one</a>.
		}
	} else {
		// data-track-list: playing a track queues the rest of the list after it
		<ul class="divide-y divide-zinc-200 dark:divide-zinc-800" data-track-list>
			for _, track := range tracks {
				<li>
					@Track(track)
				</li>
			}
		</ul>
	}
}

// formatDuration renders d as m:ss, or h:mm:ss for long tracks.
func formatDuration(d time.Duration) string {
	s := int(d.Round(time.Second).Seconds())
	if s >= 3600 {
		return fmt.Sprintf("%d:%02d:%02d", s/3600, s%3600/60, s%60)
	}
	return fmt.Sprintf("%d:%02d", s/60, s%60)
}

func secretToggle(t *audio.Track) string {
	if t.Secret {
		return `{"secret": "0"}`
	}
	return `{"secret": "1"}`
}

// TrackEditPage edits a track's title, artists and secret flag. Only an
// episode can change kind, and only into a song.
templ TrackEditPage(t *audio.Track, artists []*audio.Artist) {
	@layout("Edit "+t.Title, PageTracks) {
		@pageHeader("Edit track", t.Title) {
			<a class="btn" href="/tracks">Cancel</a>
		}
		<form
			class="card grid max-w-lg gap-4"
			hx-post={ "/ui/tracks/" + t.ID.String() }
			hx-target="#track-edit-result"
			hx-on::after-request="if (!event.detail.successful) document.getElementById('track-edit-result').textContent = event.detail.xhr.responseText || 'Could not save.'"
		>
			<div>
				<label for="track-title" class="mb-1 block text-sm font-medium">Title</label>
				<input id="track-title" class="input" type="text" name="title" value={ t.Title } required/>
			</div>
			<div>
				<span class="mb-1 block text-sm font-medium">Artists</span>
				@artistPicker(artists, artistIDs(t.Artists))
			</div>
			if t.IsEpisode() {
				<div>
					<label for="track-kind" class="mb-1 block text-sm font-medium">Kind</label>
					<select id="track-kind" class="input" name="kind">
						<option value="episode" selected>Podcast episode</option>
						<option value="music">Song (needs an artist)</option>
					</select>
				</div>
			} else {
				<input type="hidden" name="kind" value="music"/>
			}
			if vaultOpen(ctx) {
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="secret" value="1" checked?={ t.Secret }/>
					Secret: only shown while the vault is unlocked
				</label>
			}
			<div class="flex items-center gap-4">
				<button class="btn" type="submit">Save</button>
				<span id="track-edit-result" class="text-sm text-red-600 dark:text-red-400" aria-live="polite"></span>
			</div>
		</form>
		<script src="/assets/js/artist-picker.js" defer></script>
	}
}

// deleteConfirm is the text of the delete dialog: it names the track and the
// releases it will disappear from.
func deleteConfirm(t *audio.Track) string {
	msg := "Delete " + t.Title + " and its file?"
	if len(t.Releases) > 0 {
		titles := make([]string, len(t.Releases))
		for i, r := range t.Releases {
			titles[i] = r.Title
		}
		msg += " It will be removed from " + strings.Join(titles, ", ") + "."
	}
	return msg
}
