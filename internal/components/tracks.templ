package components

import (
	"fmt"
	"sort"
	"strings"
	"time"

	"audioloader/internal/audio"
)

// Sort orders of the track list in secret mode.
const (
	SortAdded   = "added"
	SortCreator = "creator"
	SortTag     = "tag"
)

// TracksPage lists the library. Secret mode has no releases to browse by,
// so its list can be sorted by date added (newest first, as the tracks
// come), creator or tag.
templ TracksPage(tracks []*audio.Track, continueListening []*audio.Track, sortBy string) {
	@layout("Tracks", PageTracks) {
		@pageHeader("Tracks", fmt.Sprintf("%d in library", len(tracks))) {
			<a class="btn" href="/upload">Upload track</a>
		}
		@ContinueListening(continueListening)
		if secretMode(ctx) {
			<nav class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm" aria-label="Sort tracks">
				<span class="text-zinc-500 dark:text-zinc-400">Sort by</span>
				for _, s := range []struct{ Key, Label string }{{SortAdded, "Date added"}, {SortCreator, "Creator"}, {SortTag, "Tag"}} {
					@navAnchor("/tracks?sort="+s.Key, s.Label, s.Key == sortBy)
				}
			</nav>
			for _, g := range GroupTracks(tracks, sortBy) {
				<section class="mb-8">
					if g.Title != "" {
						<h2 class="mb-2 text-lg font-semibold">{ g.Title }</h2>
					}
					@TrackList(g.Tracks)
				</section>
			}
			if len(tracks) == 0 {
				@TrackList(tracks)
			}
		} else {
			@TrackList(tracks)
		}
	}
}

// TrackGroup is a titled run of tracks on the secret track list.
type TrackGroup struct {
	Title  string
	Tracks []*audio.Track
}

// GroupTracks splits tracks (newest first) for a sort order. By creator or
// tag a track is listed under each of its creators or tags, groups ordered
// by name, with the tracks lacking one last.
func GroupTracks(tracks []*audio.Track, sortBy string) []TrackGroup {
	keys := func(t *audio.Track) []string { return nil }
	none := ""
	switch sortBy {
	case SortCreator:
		none = "No creator"
		keys = func(t *audio.Track) []string {
			names := make([]string, len(t.Artists))
			for i, a := range t.Artists {
				names[i] = a.Name
			}
			return names
		}
	case SortTag:
		none = "Untagged"
		keys = func(t *audio.Track) []string { return t.Tags }
	default:
		return []TrackGroup{{Tracks: tracks}}
	}
	byKey := map[string]*TrackGroup{}
	var order []string
	var rest []*audio.Track
	for _, t := range tracks {
		ks := keys(t)
		if len(ks) == 0 {
			rest = append(rest, t)
		}
		for _, k := range ks {
			id := strings.ToLower(k)
			if byKey[id] == nil {
				byKey[id] = &TrackGroup{Title: k}
				order = append(order, id)
			}
			byKey[id].Tracks = append(byKey[id].Tracks, t)
		}
	}
	sort.Strings(order)
	groups := make([]TrackGroup, 0, len(order)+1)
	for _, id := range order {
		groups = append(groups, *byKey[id])
	}
	if len(rest) > 0 {
		groups = append(groups, TrackGroup{Title: none, Tracks: rest})
	}
	return groups
}

// UploadPage starts with the kind of release. A single is uploaded right
// here; an album, EP or compilation is created first and its tracks are then
// uploaded together in batch mode. The switch is CSS only (group-has).
templ UploadPage(artists []*audio.Artist, shows []*audio.Show) {
	@layout("Upload", PageUpload) {
		@pageHeader("Upload", "Add music to the library") {
			<div class="flex flex-wrap gap-2">
				<a class="btn" href="/upload/import">Import library</a>
				<a class="btn" href="/upload/batch">Batch mode</a>
				if !secretMode(ctx) {
					<a class="btn" href="/upload/youtube">From YouTube</a>
				}
			</div>
		}
		<div class="group">
			<fieldset class="mb-4">
				<legend class="mb-2 text-sm font-medium">What are you uploading?</legend>
				<div class="flex flex-wrap gap-2">
					if secretMode(ctx) {
						// secret tracks have no releases
						<label class="cursor-pointer rounded-md border border-zinc-300 px-3 py-1.5 text-sm has-[:checked]:border-zinc-900 has-[:checked]:bg-zinc-900 has-[:checked]:text-white has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-sky-500 dark:border-zinc-700 dark:has-[:checked]:border-zinc-100 dark:has-[:checked]:bg-zinc-100 dark:has-[:checked]:text-zinc-900">
							<input id="kind-single" class="sr-only" type="radio" name="type" value="single" form="episode-form" checked/>
							Track
						</label>
					}
					for _, typ := range audio.ReleaseTypes {
						if !secretMode(ctx) {
							<label class="cursor-pointer rounded-md border border-zinc-300 px-3 py-1.5 text-sm has-[:checked]:border-zinc-900 has-[:checked]:bg-zinc-900 has-[:checked]:text-white has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-sky-500 dark:border-zinc-700 dark:has-[:checked]:border-zinc-100 dark:has-[:checked]:bg-zinc-100 dark:has-[:checked]:text-zinc-900">
								// form= ties the choice to the release form, which needs the type
								<input id={ "kind-" + string(typ) } class="sr-only" type="radio" name="type" value={ string(typ) } form="new-release-form" checked?={ typ == audio.ReleaseSingle }/>
								{ typ.Label() }
							</label>
						}
					}
					<label class="cursor-pointer rounded-md border border-zinc-300 px-3 py-1.5 text-sm has-[:checked]:border-zinc-900 has-[:checked]:bg-zinc-900 has-[:checked]:text-white has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-sky-500 dark:border-zinc-700 dark:has-[:checked]:border-zinc-100 dark:has-[:checked]:bg-zinc-100 dark:has-[:checked]:text-zinc-900">
						// not part of the release form: an episode isn't a release
						<input id="kind-episode" class="sr-only" type="radio" name="type" value="episode" form="episode-form"/>
						Podcast episode
					</label>
				</div>
			</fieldset>
			<div class="hidden group-has-[#kind-single:checked]:block">
				@AddTrackForm(artists)
			</div>
			if !secretMode(ctx) {
				<div class="hidden group-has-[#kind-album:checked]:block group-has-[#kind-ep:checked]:block group-has-[#kind-compilation:checked]:block">
					@NewReleaseForm(artists, true)
				</div>
			}
			<div class="hidden group-has-[#kind-episode:checked]:block">
				@EpisodeForm(shows)
			</div>
		</div>
	}
}

templ AddTrackForm(artists []*audio.Artist) {
	<section class="card">
		<form
			id="upload-form"
			class="grid max-w-lg gap-4"
			hx-post="/ui/tracks"
			hx-encoding="multipart/form-data"
			hx-target="#result-tracks"
			hx-on::after-request="
				if (event.detail.successful) this.reset();
				else document.getElementById('result-tracks').textContent = event.detail.xhr.responseText || 'Upload failed.';
			"
		>
			<div>
				<label for="track-title" class="mb-1 block text-sm font-medium">Title</label>
				<input id="track-title" class="input" type="text" name="title" placeholder="Track name" required/>
			</div>
			<div>
				<span class="mb-1 block text-sm font-medium">
					if secretMode(ctx) {
						Creators
					} else {
						Artists
					}
				</span>
				@artistPicker(artists, nil)
				if len(artists) == 0 {
					<small class="mt-1 block text-zinc-500">No artists yet. <a href="/artists">Add one first</a>.</small>
				}
			</div>
			if secretMode(ctx) {
				@secretTrackFields("", nil)
			} else {
				<div>
					<label for="track-date" class="mb-1 block text-sm font-medium">Release date <span class="font-normal text-zinc-500">(optional)</span></label>
					<input
						id="track-date"
						class="input"
						type="text"
						name="date"
						placeholder="YYYY or YYYY-MM-DD"
						pattern="\d{4}(-\d{2}(-\d{2})?)?"
						title="YYYY, YYYY-MM or YYYY-MM-DD"
					/>
				</div>
			}
			<div>
				<label for="track-file" class="mb-1 block text-sm font-medium">Audio file</label>
				<input
					id="track-file"
					class="input file:mr-3 file:rounded file:border-0 file:bg-zinc-200 file:px-2 file:py-1 file:text-sm dark:file:bg-zinc-700"
					type="file"
					name="track"
					required
					accept="audio/*,.mp3,.opus,.flac,.ogg,.wav,.m4a,.aac"
				/>
				<small id="track-file-status" class="mt-1 block empty:hidden data-[state=exists]:text-amber-600 data-[state=pending]:text-zinc-500 dark:data-[state=exists]:text-amber-400" aria-live="polite"></small>
			</div>
			<div>
				<button class="btn disabled:cursor-not-allowed disabled:opacity-50" type="submit">Upload</button>
			</div>
		</form>
		<div id="result-tracks" class="mt-4 text-sm" aria-live="polite"></div>
	</section>
	<script src="/assets/js/artist-picker.js" defer></script>
	<script src="/assets/js/track-hash.js" defer></script>
	<script src="/assets/js/upload.js" defer></script>
}

templ Track(t *audio.Track) {
	<article class="grid grid-cols-[auto_3.5rem_1fr_auto_auto] items-center gap-x-4 py-3" data-track-row>
		@playButton(t, "size-10")
		<img class="pixelated size-14 rounded bg-zinc-100 object-cover dark:bg-zinc-800" src={ t.ImgURL } alt=""/>
		<div class="flex min-w-0 flex-col">
			<strong class="truncate">
				{ t.Title }
				if t.Secret {
					<span class="ml-1 rounded bg-zinc-200 px-1 text-xs font-normal dark:bg-zinc-700">secret</span>
				}
			</strong>
			<span class="truncate text-sm text-zinc-500 dark:text-zinc-400">
				@artistLinks(t.Artists)
				@trackReleaseLabel(t)
			</span>
			@coverOfLine(t)
			if t.Secret {
				@secretTrackDetails(t)
			}
		</div>
		<span class="text-sm text-zinc-500 tabular-nums dark:text-zinc-400">{ formatDuration(t.Duration) }</span>
		@trackMenu(t)
	</article>
}

// trackMenu offers queueing a track; player.js handles its buttons. It
// reads the track from the play button in the same [data-track-row].
templ trackMenu(t *audio.Track) {
	if t.HasFile {
		<details class="relative" data-track-menu>
			<summary class="btn cursor-pointer list-none px-2" aria-label={ "More for " + t.Title }>⋯</summary>
			<div class="absolute right-0 z-10 mt-1 grid w-44 rounded-md border border-zinc-300 bg-white p-1 text-sm shadow-lg dark:border-zinc-700 dark:bg-zinc-800">
				<button type="button" class="rounded px-2 py-1 text-left hover:bg-zinc-100 dark:hover:bg-zinc-700" data-queue="next">Play next</button>
				<button type="button" class="rounded px-2 py-1 text-left hover:bg-zinc-100 dark:hover:bg-zinc-700" data-queue="add">Add to queue</button>
				<button
					type="button"
					class="rounded px-2 py-1 text-left hover:bg-zinc-100 dark:hover:bg-zinc-700"
					hx-get={ "/ui/playlists/picker?track_id=" + t.ID.String() }
					hx-swap="outerHTML"
				>Add to playlist…</button>
				<a class="rounded px-2 py-1 text-left text-inherit hover:bg-zinc-100 hover:no-underline dark:text-inherit dark:hover:bg-zinc-700" href={ templ.SafeURL("/tracks/" + t.ID.String() + "/edit") }>Edit</a>
				if !t.IsEpisode() && !t.Secret {
					<a class="rounded px-2 py-1 text-left text-inherit hover:bg-zinc-100 hover:no-underline dark:text-inherit dark:hover:bg-zinc-700" href={ templ.SafeURL("/tracks/" + t.ID.String() + "/edit#cover-of") }>Set cover of…</a>
				}
				<button
					type="button"
					class="rounded px-2 py-1 text-left hover:bg-zinc-100 dark:hover:bg-zinc-700"
					hx-post={ "/ui/tracks/" + t.ID.String() + "/delete" }
					hx-confirm={ deleteConfirm(t) }
				>Delete</button>
				if vaultEnabled(ctx) {
					<button
						type="button"
						class="rounded px-2 py-1 text-left hover:bg-zinc-100 dark:hover:bg-zinc-700"
						hx-post={ "/ui/tracks/" + t.ID.String() + "/secret" }
						hx-confirm={ secretConfirm(t) }
					>
						if t.Secret {
							Make public
						} else {
							Make secret
						}
					</button>
				}
			</div>
		</details>
	} else {
		<span></span>
	}
}

// playButton hands t to the global player (player.js); size sets the button's size classes.
templ playButton(t *audio.Track, size string) {
	if !t.HasFile {
		<span
			class={ "btn shrink-0 justify-center rounded-full p-0 opacity-40", size }
			title="Not in the library yet"
			aria-label={ t.Title + " is not in the library yet" }
		>–</span>
	} else {
		@playableButton(t, size)
	}
}

templ playableButton(t *audio.Track, size string) {
	<button
		type="button"
		class={ "btn shrink-0 justify-center rounded-full p-0", size }
		aria-label={ "Play " + t.Title }
		aria-pressed="false"
		data-play-track
		data-id={ t.ID.String() }
		data-title={ t.Title }
		data-artists={ artistNames(t.Artists) }
		data-img={ t.ImgURL }
		data-src={ "/api/tracks/" + t.ID.String() + "/stream" }
		if t.CoverOf != nil {
			data-cover-of={ t.CoverOf.String() }
		}
		if t.Secret {
			data-secret="1"
		}
		if t.IsEpisode() {
			data-kind="episode"
			data-show={ t.ShowID }
			if !t.Finished {
				data-position={ fmt.Sprint(int(t.Position.Seconds())) }
			}
		}
	>▶</button>
}

// coverOfLine says which song a cover is of, linking to the original in the
// library or on MusicBrainz.
templ coverOfLine(t *audio.Track) {
	if c := t.CoverOf; c != nil {
		<span class="block truncate text-xs text-zinc-500 dark:text-zinc-400">
			{ "Cover of " }
			if u := coverOfURL(c); u != "" {
				<a href={ u }>{ c.Title }</a>
			} else {
				<em>{ c.Title }</em>
			}
			if c.Artists != "" {
				{ " by " + c.Artists }
			}
		</span>
	}
}

// coverOfURL is where the original lives: its release page, or its
// MusicBrainz recording. "" for a plain text reference.
func coverOfURL(c *audio.CoverRef) templ.SafeURL {
	switch {
	case c.ReleaseID != "":
		return templ.SafeURL("/releases/" + c.ReleaseID)
	case c.TrackID != "":
		return searchURL(c.Title)
	case c.MBID != "":
		return templ.SafeURL("https://musicbrainz.org/recording/" + c.MBID)
	}
	return ""
}

// trackReleaseLabel names where a track comes from. An album, EP or
// compilation wins over a single, so a song released both ways is listed
// once, under its album, with a note that it was also a single.
templ trackReleaseLabel(t *audio.Track) {
	// separators are string expressions: templ drops plain whitespace next to a component call
	if main, single := mainRelease(t), firstSingle(t); main != nil {
		{ " · " }
		<a href={ templ.SafeURL("/releases/" + main.ID.String()) }>{ main.Title }</a>
		if single != nil {
			{ " · also a single" }
		}
	} else if single != nil {
		{ " · " }
		<a href={ templ.SafeURL("/releases/" + single.ID.String()) }>Single</a>
		if single.Year() != "" {
			{ " · " + single.Year() }
		}
	}
}

func mainRelease(t *audio.Track) *audio.Release {
	for _, r := range t.Releases {
		if !r.IsSingle() {
			return r
		}
	}
	return nil
}

func firstSingle(t *audio.Track) *audio.Release {
	for _, r := range t.Releases {
		if r.IsSingle() {
			return r
		}
	}
	return nil
}

func artistNames(artists []*audio.Artist) string {
	names := make([]string, len(artists))
	for i, a := range artists {
		names[i] = a.Name
	}
	return strings.Join(names, ", ")
}

templ TrackList(tracks []*audio.Track) {
	if len(tracks) == 0 {
		@emptyState() {
			No tracks yet. <a href="/upload">Upload one</a>.
		}
	} else {
		// data-track-list: playing a track queues the rest of the list after it
		<ul class="divide-y divide-zinc-200 dark:divide-zinc-800" data-track-list>
			for _, track := range tracks {
				<li>
					@Track(track)
				</li>
			}
		</ul>
	}
}

// formatDuration renders d as m:ss, or h:mm:ss for long tracks.
func formatDuration(d time.Duration) string {
	s := int(d.Round(time.Second).Seconds())
	if s >= 3600 {
		return fmt.Sprintf("%d:%02d:%02d", s/3600, s%3600/60, s%60)
	}
	return fmt.Sprintf("%d:%02d", s/60, s%60)
}

// secretConfirm is the question before a track moves to the other mode.
// Moving it to secret mode takes it off its releases, which it names.
func secretConfirm(t *audio.Track) string {
	if t.Secret {
		return "Make " + t.Title + " public? It will be on no release."
	}
	if len(t.Releases) == 0 {
		return "Make " + t.Title + " secret?"
	}
	titles := make([]string, len(t.Releases))
	for i, r := range t.Releases {
		titles[i] = r.Title
	}
	return "Make " + t.Title + " secret? It will leave " + strings.Join(titles, ", ") + ", and a release left with no tracks is deleted."
}

// secretTrackDetails shows what a secret track has instead of releases: its
// description, cut to a line, and its tags.
templ secretTrackDetails(t *audio.Track) {
	if t.Description != "" {
		<span class="block truncate text-xs text-zinc-500 dark:text-zinc-400">{ t.Description }</span>
	}
	if len(t.Tags) > 0 {
		<span class="flex flex-wrap gap-1 pt-0.5">
			for _, tag := range t.Tags {
				<span class="rounded bg-violet-100 px-1.5 text-xs text-violet-800 dark:bg-violet-900/50 dark:text-violet-200">{ tag }</span>
			}
		</span>
	}
}

// TrackEditPage edits a track's title, artists and secret flag. Only an
// episode can change kind, and only into a song.
templ TrackEditPage(t *audio.Track, artists []*audio.Artist) {
	@layout("Edit "+t.Title, PageTracks) {
		@pageHeader("Edit track", t.Title) {
			<a class="btn" href="/tracks">Cancel</a>
		}
		<form
			class="card grid max-w-lg gap-4"
			hx-post={ "/ui/tracks/" + t.ID.String() }
			hx-target="#track-edit-result"
			hx-on::after-request="if (!event.detail.successful) document.getElementById('track-edit-result').textContent = event.detail.xhr.responseText || 'Could not save.'"
		>
			<div>
				<label for="track-title" class="mb-1 block text-sm font-medium">Title</label>
				<input id="track-title" class="input" type="text" name="title" value={ t.Title } required/>
			</div>
			<div>
				<span class="mb-1 block text-sm font-medium">
					if t.Secret {
						Creators
					} else {
						Artists
					}
				</span>
				@artistPicker(artists, artistIDs(t.Artists))
			</div>
			if t.Secret {
				@secretTrackFields(t.Description, t.Tags)
			}
			if t.IsEpisode() {
				<div>
					<label for="track-kind" class="mb-1 block text-sm font-medium">Kind</label>
					<select id="track-kind" class="input" name="kind">
						<option value="episode" selected>Podcast episode</option>
						<option value="music">Song (needs an artist)</option>
					</select>
				</div>
			} else {
				<input type="hidden" name="kind" value="music"/>
			}
			if !t.IsEpisode() && !t.Secret {
				@coverOfFields(t)
			}
			<div class="flex items-center gap-4">
				<button class="btn" type="submit">Save</button>
				<span id="track-edit-result" class="text-sm text-red-600 dark:text-red-400" aria-live="polite"></span>
			</div>
		</form>
		if t.Secret {
			@trackImageForm(t)
		}
		<script src="/assets/js/artist-picker.js" defer></script>
	}
}

// secretTrackFields are the fields a secret track has in place of releases
// and a cover: a description and comma separated tags.
templ secretTrackFields(description string, tags []string) {
	<div>
		<label for="track-description" class="mb-1 block text-sm font-medium">Description <span class="font-normal text-zinc-500">(optional)</span></label>
		<textarea id="track-description" class="input" name="description" rows="4">{ description }</textarea>
	</div>
	<div>
		<label for="track-tags" class="mb-1 block text-sm font-medium">Tags <span class="font-normal text-zinc-500">(optional, separated by commas)</span></label>
		<input id="track-tags" class="input" type="text" name="tags" value={ strings.Join(tags, ", ") } maxlength="800"/>
	</div>
}

// trackImageForm sets the picture of a secret track.
templ trackImageForm(t *audio.Track) {
	<form
		class="card mt-6 grid max-w-lg gap-2"
		hx-post={ "/ui/tracks/" + t.ID.String() + "/image" }
		hx-encoding="multipart/form-data"
		hx-target="#track-image-result"
		hx-on::after-request="if (!event.detail.successful) document.getElementById('track-image-result').textContent = event.detail.xhr.responseText || 'Could not upload the picture.'"
	>
		<img class="pixelated size-24 rounded bg-zinc-100 object-cover dark:bg-zinc-800" src={ t.ImgURL } alt=""/>
		<label for="track-image" class="text-sm font-medium">Picture (JPEG, PNG or WebP, up to 10 MiB)</label>
		<input id="track-image" type="file" name="image" accept="image/jpeg,image/png,image/webp" required/>
		<div class="flex flex-wrap items-center gap-4">
			<button class="btn" type="submit">Upload picture</button>
			<button
				type="button"
				class="btn"
				hx-post={ "/ui/tracks/" + t.ID.String() + "/image/remove" }
				hx-confirm="Go back to the placeholder picture?"
			>Remove picture</button>
			<span id="track-image-result" class="text-sm text-red-600 dark:text-red-400" aria-live="polite"></span>
		</div>
	</form>
}

// coverOfFields is the "Cover of" part of the edit form. cover_mode picks
// what the fields below it mean; "keep" leaves the cover as it is, which is
// also right for a hidden original (the form can't show it).
templ coverOfFields(t *audio.Track) {
	<fieldset id="cover-of" class="group grid gap-3 rounded-md border border-zinc-300 p-3 dark:border-zinc-700">
		<legend class="px-1 text-sm font-medium">Cover of</legend>
		if t.CoverOf != nil {
			<p class="text-sm text-zinc-500 dark:text-zinc-400">Now: { t.CoverOf.String() }</p>
		}
		<select id="cover-mode" class="input" name="cover_mode" aria-label="Set the original song by">
			<option value="keep" selected>Leave as it is</option>
			<option id="cover-opt-library" value="library">Pick a track in the library</option>
			<option id="cover-opt-text" value="text">Title and artist as text</option>
			<option id="cover-opt-mbid" value="mbid">MusicBrainz recording URL</option>
			<option value="none">Not a cover (remove)</option>
		</select>
		<div class="hidden group-has-[#cover-opt-library:checked]:block">
			<input type="hidden" id="cover-track-id" name="cover_track_id"/>
			<input
				class="input"
				type="search"
				name="q"
				placeholder="Search the library"
				autocomplete="off"
				aria-label="Search for the original track"
				hx-get="/ui/tracks/pick"
				hx-trigger="input changed delay:250ms"
				hx-target="#cover-pick-results"
				hx-vals={ `{"exclude": "` + t.ID.String() + `"}` }
				hx-on:keydown="if (event.key === 'Enter') event.preventDefault()"
			/>
			<p id="cover-track-label" class="mt-1 text-sm text-zinc-500 empty:hidden dark:text-zinc-400"></p>
			<div id="cover-pick-results"></div>
		</div>
		<div class="hidden gap-2 group-has-[#cover-opt-text:checked]:grid">
			<input class="input" type="text" name="cover_title" placeholder="Original title" aria-label="Original title"/>
			<input class="input" type="text" name="cover_artists" placeholder="Original artists, e.g. A &amp; B" aria-label="Original artists"/>
		</div>
		<div class="hidden group-has-[#cover-opt-mbid:checked]:block">
			<input class="input" type="url" name="cover_mb_url" placeholder="https://musicbrainz.org/recording/…" aria-label="MusicBrainz recording URL"/>
			<small class="mt-1 block text-zinc-500">Title and artists are looked up when you save.</small>
		</div>
	</fieldset>
}

// CoverPickResults lists library songs to pick as a cover's original;
// choosing one fills the form's cover_track_id.
templ CoverPickResults(tracks []*audio.Track) {
	if len(tracks) == 0 {
		<p class="mt-1 text-sm text-zinc-500">Nothing matches.</p>
	} else {
		<ul class="mt-1 rounded-md border border-zinc-300 bg-white p-1 text-sm dark:border-zinc-700 dark:bg-zinc-800">
			for _, t := range tracks {
				<li>
					<button
						type="button"
						class="block w-full truncate rounded px-2 py-1 text-left hover:bg-zinc-100 dark:hover:bg-zinc-700"
						data-id={ t.ID.String() }
						data-label={ coverPickLabel(t) }
						hx-on:click="document.getElementById('cover-track-id').value = this.dataset.id; document.getElementById('cover-track-label').textContent = 'Picked: ' + this.dataset.label; document.getElementById('cover-mode').value = 'library'; this.closest('ul').remove()"
					>
						{ t.Title }<span class="text-zinc-500">{ " · " + artistNames(t.Artists) }</span>
					</button>
				</li>
			}
		</ul>
	}
}

func coverPickLabel(t *audio.Track) string {
	if len(t.Artists) == 0 {
		return t.Title
	}
	return t.Title + " by " + artistNames(t.Artists)
}

// deleteConfirm is the text of the delete dialog: it names the track and the
// releases it will disappear from.
func deleteConfirm(t *audio.Track) string {
	msg := "Delete " + t.Title + " and its file?"
	if len(t.Releases) > 0 {
		titles := make([]string, len(t.Releases))
		for i, r := range t.Releases {
			titles[i] = r.Title
		}
		msg += " It will be removed from " + strings.Join(titles, ", ") + "."
	}
	return msg
}
