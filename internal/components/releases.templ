package components

import (
	"fmt"
	"time"

	"audioloader/internal/audio"
)

// ReleasesPage lists the library's releases as shelves by type; filter is
// one type to show alone, or "" for all.
templ ReleasesPage(releases []*audio.Release, artists []*audio.Artist, filter string) {
	@layout("Releases", PageReleases) {
		@pageHead("Releases", fmt.Sprintf("%d in library", len(releases))) {
			@segmented("Release type", releaseFilters(filter))
			@popover("New release") {
				@NewReleaseForm(artists, false)
			}
		}
		if len(releases) == 0 {
			@emptyState() {
				No releases yet.
			}
		}
		// one shelf per type: singles are never mixed in with albums
		for _, typ := range audio.ReleaseTypes {
			if rs := releasesOfType(releases, typ); len(rs) > 0 && (filter == "" || filter == string(typ)) {
				<section class="mb-8">
					@sectionLabel(pluralLabel(typ))
					if typ == audio.ReleaseSingle {
						@singleList(rs)
					} else {
						@releaseGrid(rs)
					}
				</section>
			}
		}
		<script src="/assets/js/artist-picker.js" defer></script>
	}
}

func releaseFilters(filter string) []SegOption {
	opts := []SegOption{{Label: "All", Href: "/releases", On: filter == ""}}
	for _, typ := range audio.ReleaseTypes {
		opts = append(opts, SegOption{Label: pluralLabel(typ), Href: "/releases?type=" + string(typ), On: filter == string(typ)})
	}
	return opts
}

// NewReleaseForm creates a release. With upload set it's the upload page's
// version: the type comes from the page's radio buttons and the browser
// continues to batch upload for the new release.
templ NewReleaseForm(artists []*audio.Artist, upload bool) {
	<section class="form-panel">
		if upload {
			<p class="mb-4 text-sm text-fg-muted">Create the release first, then upload all of its tracks together.</p>
		}
		<form
			id="new-release-form"
			class="grid max-w-lg gap-4"
			hx-post="/ui/releases"
			hx-target="#release-result"
			hx-on::after-request="if (!event.detail.successful) document.getElementById('release-result').textContent = event.detail.xhr.responseText || 'Could not create the release.'"
		>
			<div>
				<label for="release-title" class="mb-1 block text-xs font-medium text-fg-muted">Title</label>
				<input id="release-title" class="input" type="text" name="title" required/>
			</div>
			if upload {
				<input type="hidden" name="next" value="batch"/>
				// the kind pick (upload.js keeps this in step with it)
				<input id="release-type-pick" type="hidden" name="type" value="single"/>
			}
			<div class="grid grid-cols-2 gap-4">
				if !upload {
					<div>
						<label for="release-type" class="mb-1 block text-xs font-medium text-fg-muted">Type</label>
						<select id="release-type" class="input" name="type">
							for _, typ := range audio.ReleaseTypes {
								<option value={ string(typ) } selected?={ typ == audio.ReleaseAlbum }>{ typ.Label() }</option>
							}
						</select>
					</div>
				}
				<div>
					<label for="release-date" class="mb-1 block text-xs font-medium text-fg-muted">Release date</label>
					<input
						id="release-date"
						class="input"
						type="text"
						name="date"
						placeholder="YYYY or YYYY-MM-DD"
						pattern="\d{4}(-\d{2}(-\d{2})?)?"
						title="YYYY, YYYY-MM or YYYY-MM-DD"
					/>
				</div>
			</div>
			<div>
				<span class="mb-1 block text-sm font-medium">Artists</span>
				@artistPicker(artists, nil)
			</div>
			<div>
				<button class="btn" type="submit">
					if upload {
						Create and upload tracks
					} else {
						Create release
					}
				</button>
			</div>
		</form>
		<div id="release-result" class="mt-4 text-sm text-st-failed empty:hidden" aria-live="polite"></div>
	</section>
}

templ releaseGrid(releases []*audio.Release) {
	@cardGrid() {
		for _, r := range releases {
			@tileWithMenu() {
				@card(r.ImgURL, r.Title, joinDot([]string{artistNames(r.Artists), r.Year()}), string(releaseURL(r)))
				@releaseMenu(r, "card")
			}
		}
	}
}

// singleList shows singles as song rows rather than album covers.
templ singleList(releases []*audio.Release) {
	@list() {
		for _, r := range releases {
			<div class="row row-single relative" data-menu-host>
				@cover(r.ImgURL, 28)
				<span class="stack">
					// the link covers the row, the menu sits above it
					<a class="after:absolute after:inset-0" href={ releaseURL(r) }><b>{ r.Title }</b></a>
					<span>{ artistNames(r.Artists) }</span>
				</span>
				<span class="mono text-fg-muted">{ r.Year() }</span>
				@releaseMenu(r, "row")
			</div>
		}
	}
}

templ ReleasePage(r *audio.Release) {
	@layout(r.Title, PageReleases) {
		if r.IsSingle() {
			@singleView(r)
		} else {
			@albumView(r)
		}
		@releaseMissing(r)
	}
}

templ releaseActions(r *audio.Release) {
	if missingCount(r) < len(r.Tracks) {
		<button type="button" class="btn" data-play-list="release-tracks">Play</button>
		<button type="button" class="btn btn-ghost" data-play-list="release-tracks" data-shuffle>Shuffle</button>
	}
	<a class="btn btn-ghost" href={ templ.SafeURL("/upload/batch?release=" + r.ID.String()) }>Upload tracks</a>
	<a class="btn btn-ghost" href={ templ.SafeURL("/releases/" + r.ID.String() + "/edit") }>Edit release</a>
	@removeReleaseButton(r)
	@releaseMenu(r, "head")
}

// releaseMenu is the ⋯ menu of a release: on its card or row, and in its
// page header. Releases exist in normal mode only.
templ releaseMenu(r *audio.Release, where string) {
	@ctxMenu(where, "More for "+r.Title) {
		@sourceItems("releases/"+r.ID.String(), "Play", true)
		<a class="menu-item" href={ templ.SafeURL("/releases/" + r.ID.String() + "/edit") }>Edit</a>
		<a class="menu-item" href={ templ.SafeURL("/releases/" + r.ID.String() + "/edit#release-edit") }>Edit tracklist</a>
		<button
			type="button"
			class="menu-item"
			hx-post={ "/ui/releases/" + r.ID.String() + "/remove" }
			hx-confirm={ removeReleaseConfirm(r) }
		>Remove release…</button>
	}
}

templ removeReleaseButton(r *audio.Release) {
	<button
		type="button"
		class="btn btn-danger"
		hx-post={ "/ui/releases/" + r.ID.String() + "/remove" }
		hx-confirm={ removeReleaseConfirm(r) }
	>Remove release</button>
}

// removeReleaseConfirm counts what removing r takes with it: its tracks that
// are on no other release go, the rest stay.
func removeReleaseConfirm(r *audio.Release) string {
	// a card doesn't load the tracks, so it can't count them
	if len(r.Tracks) == 0 {
		return "Remove " + r.Title + "? Its tracks that are on no other release go too, with their files."
	}
	gone, withFiles, stay := 0, 0, 0
	for _, rt := range r.Tracks {
		if len(rt.Track.Releases) <= 1 {
			gone++
			if rt.Track.HasFile {
				withFiles++
			}
		} else {
			stay++
		}
	}
	plural := func(n int) string {
		if n == 1 {
			return "1 track"
		}
		return fmt.Sprintf("%d tracks", n)
	}
	msg := "Remove " + r.Title + "? "
	if gone == 0 {
		return msg + "Its tracks are all on other releases and stay."
	}
	verb := "go"
	if gone == 1 {
		verb = "goes"
	}
	msg += plural(gone) + " " + verb + ", " + fmt.Sprintf("%d", withFiles) + " of them with files, which are deleted."
	if stay > 0 {
		msg += " " + plural(stay) + " on other releases stay."
	}
	return msg
}

templ albumView(r *audio.Release) {
	@mediaHeader(r.ImgURL, r.Type.Label(), r.Title, artistLinks(r.Artists), releaseFacts(r)) {
		@releaseActions(r)
	}
	if len(r.Tracks) == 0 {
		@emptyState() {
			No tracks yet. Upload tracks, or add existing ones with Edit tracklist.
		}
	}
	if len(r.Tracks) > 0 {
		<div id="release-tracks" data-track-list>
			@list() {
				for _, disc := range r.Discs() {
					if len(r.Discs()) > 1 {
						@rowBar(true) {
							<span class="label">{ "Disc " + fmt.Sprint(disc[0].Disc) }</span>
							<span class="mono">{ formatDuration(discLength(disc)) }</span>
						}
					} else {
						@listHead("row-rel", "#", "Title", ">Time")
					}
					for _, rt := range disc {
						@releaseTrackRow(rt, r)
					}
				}
				@rowBar(false) {
					<span class="label">Total length</span>
					<span class="mono">{ formatDuration(r.Duration()) }</span>
				}
			}
		</div>
	}
}

// singleView centres a single on its song: the first track is the A-side,
// any others are B-sides.
templ singleView(r *audio.Release) {
	@mediaHeader(r.ImgURL, "Single", r.Title, artistLinks(r.Artists), singleFacts(r)) {
		@releaseActions(r)
	}
	if len(r.Tracks) == 0 {
		@emptyState() {
			No track yet. Upload it, or add an existing one with Edit tracklist.
		}
	} else {
		<div id="release-tracks" data-track-list class="mb-6">
			@list() {
				@releaseTrackRow(r.Tracks[0], r)
			}
		</div>
		if also := alsoOn(r); len(also) > 0 {
			<section class="mb-6">
				@sectionLabel("Also on")
				@list() {
					for _, other := range also {
						@row("row-2 row-pad") {
							<a class="truncate" href={ releaseURL(other) }>{ other.Title }</a>
							<span class="mono text-fg-muted">{ other.Year() }</span>
						}
					}
				}
			</section>
		}
		if len(r.Tracks) > 1 {
			<section class="mb-6">
				@sectionLabel("Also on this single")
				@list() {
					for _, rt := range r.Tracks[1:] {
						@releaseTrackRow(rt, r)
					}
				}
			</section>
		}
	}
}

// releaseTrackRow is a row of a release's tracklist: the release's number
// (a play button), title over artists when they differ from the release's,
// time, menu.
templ releaseTrackRow(rt *audio.ReleaseTrack, r *audio.Release) {
	<article class={ "row row-rel group/row", templ.KV("is-missing", !rt.Track.HasFile) } data-track-row>
		if rt.Track.HasFile {
			<button type="button" class="play" aria-label={ "Play " + rt.Track.Title } aria-pressed="false" data-bare { playAttrs(rt.Track)... }>
				<span class="n">{ fmt.Sprint(rt.Position) }</span>
				<span class="go">@iconClass("play", "size-3.5")</span>
				@eqBars()
			</button>
		} else {
			<span class="play" title="Not in the library yet"><span class="n">{ fmt.Sprint(rt.Position) }</span></span>
		}
		<div class="stack">
			<b class="group-has-[[aria-pressed=true]]/row:text-accent">{ rt.Track.Title }</b>
			// only shown when they differ from the release's, e.g. features or compilations
			if artistNames(rt.Track.Artists) != artistNames(r.Artists) {
				<span>{ artistNames(rt.Track.Artists) }</span>
			}
			@coverOfLine(rt.Track)
		</div>
		if !rt.Track.HasFile {
			@chip("missing")
		}
		<span class="mono text-right text-fg-muted">{ formatDuration(rt.Track.Duration) }</span>
		@trackMenu(rt.Track)
	</article>
}

templ ReleaseEditPage(r *audio.Release, library []*audio.Track, artists []*audio.Artist) {
	@layout("Edit "+r.Title, PageReleases) {
		@pageHead("Edit release", r.Type.Label()+": "+r.Title) {
			<a class="btn btn-ghost" href={ releaseURL(r) }>Cancel</a>
		}
		<div class="mb-8 grid items-start gap-4 min-[1024px]:grid-cols-2">
			@releaseDetailsForm(r, artists)
			@releaseCoverForm(r)
		</div>
		@sectionLabel("Tracklist")
		<form
			id="release-edit"
			hx-post={ "/ui/releases/" + r.ID.String() + "/tracks" }
			hx-target="#release-edit-result"
			hx-on::after-request="if (!event.detail.successful) document.getElementById('release-edit-result').textContent = event.detail.xhr.responseText || 'Could not save.'"
		>
			<div id="release-edit-rows" class="list">
				for _, rt := range r.Tracks {
					@editRow(rt.Track.ID.String(), rt.Track.Title, artistNames(rt.Track.Artists), rt.Disc)
				}
			</div>
			<p class="py-4 text-sm text-fg-muted" data-edit-empty hidden?={ len(r.Tracks) > 0 }>No tracks on this release.</p>
			<div class="mt-4 flex flex-wrap items-center gap-2">
				<label for="release-add-track" class="text-xs font-medium text-fg-muted">Add from library</label>
				<select id="release-add-track" class="input w-auto min-w-64 flex-1">
					<option value="">Choose a track…</option>
					for _, t := range notOnRelease(library, r) {
						<option value={ t.ID.String() } data-title={ t.Title } data-artists={ artistNames(t.Artists) }>
							{ trackOptionLabel(t) }
						</option>
					}
				</select>
				<button type="button" class="btn" data-action="add">Add</button>
			</div>
			<div class="mt-4 flex items-center gap-4">
				<button type="submit" class="btn">Save tracklist</button>
				<span id="release-edit-result" class="text-sm text-st-failed" aria-live="polite"></span>
			</div>
		</form>
		<template id="release-edit-row">
			@editRow("", "", "", 1)
		</template>
		<section class="mt-10">
			@sectionLabel("Remove release")
			<p class="mb-4 text-sm text-fg-muted">Deletes the release and its tracks that aren't on another release, with their files. It moves to Ignored in the inbox.</p>
			@removeReleaseButton(r)
			<button
				type="button"
				class="btn btn-danger ml-2"
				hx-post={ "/ui/releases/" + r.ID.String() + "/delete" }
				hx-confirm={ "Delete " + r.Title + "? Its tracks stay in your library." }
			>Delete the release only</button>
		</section>
		<script src="/assets/js/release-edit.js" defer></script>
		<script src="/assets/js/artist-picker.js" defer></script>
	}
}

templ releaseDetailsForm(r *audio.Release, artists []*audio.Artist) {
	<form
		class="form-panel"
		hx-post={ "/ui/releases/" + r.ID.String() }
		hx-target="#release-details-result"
		hx-on::after-request="if (!event.detail.successful) document.getElementById('release-details-result').textContent = event.detail.xhr.responseText || 'Could not save.'"
	>
		@field("Title", "") {
			<input id="release-title" class="input" type="text" name="title" value={ r.Title } required/>
		}
		<div class="grid grid-cols-2 gap-4">
			@field("Type", "") {
				<select id="release-type" class="input" name="type">
					for _, typ := range audio.ReleaseTypes {
						<option value={ string(typ) } selected?={ typ == r.Type }>{ typ.Label() }</option>
					}
				</select>
			}
			@field("Release date", "") {
				<input
					id="release-date"
					class="input"
					type="text"
					name="date"
					value={ r.Date }
					placeholder="YYYY or YYYY-MM-DD"
					pattern="\d{4}(-\d{2}(-\d{2})?)?"
					title="YYYY, YYYY-MM or YYYY-MM-DD"
				/>
			}
		</div>
		<div>
			<span class="mb-1 block text-sm font-medium">Artists</span>
			@artistPicker(artists, artistIDs(r.Artists))
		</div>
		<div class="flex items-center gap-4">
			<button class="btn" type="submit">Save details</button>
			<span id="release-details-result" class="text-sm text-st-failed" aria-live="polite"></span>
		</div>
	</form>
}

templ releaseCoverForm(r *audio.Release) {
	<form
		class="form-panel flex-col sm:flex-row sm:items-center"
		hx-post={ "/ui/releases/" + r.ID.String() + "/cover" }
		hx-encoding="multipart/form-data"
		hx-target="#release-cover-result"
		hx-on::after-request="if (!event.detail.successful) document.getElementById('release-cover-result').textContent = event.detail.xhr.responseText || 'Could not upload the cover.'"
	>
		@cover(r.ImgURL, 96)
		<div class="grid gap-2">
			@field("Cover (JPEG, PNG or WebP, up to 10 MiB)", "") {
				<input id="release-cover" type="file" name="cover" accept="image/jpeg,image/png,image/webp" required/>
			}
			<div class="flex items-center gap-4">
				<button class="btn" type="submit">Upload cover</button>
				<span id="release-cover-result" class="text-sm text-st-failed" aria-live="polite"></span>
			</div>
		</div>
	</form>
}

func artistIDs(artists []*audio.Artist) []string {
	ids := make([]string, len(artists))
	for i, a := range artists {
		ids[i] = a.ID.String()
	}
	return ids
}

// editRow is one tracklist entry. Positions aren't stored in the form: they
// follow the row order within each disc and are shown by release-edit.js.
templ editRow(trackID, title, artists string, disc int) {
	<div class="row row-redit release-edit-row">
		<input type="hidden" name="track_id" value={ trackID }/>
		<span class="mono text-right text-fg-muted" data-number></span>
		<label class="flex items-center gap-1 text-sm">
			Disc
			<input class="input w-14 px-2" type="number" name="disc" min="1" value={ fmt.Sprint(disc) } required/>
		</label>
		<div class="stack">
			<b data-title>{ title }</b>
			<span data-artists>{ artists }</span>
		</div>
		<div class="flex gap-1">
			<button type="button" class="btn btn-ghost px-2.5" data-action="up" aria-label="Move up">@icon("arrow-up")</button>
			<button type="button" class="btn btn-ghost px-2.5" data-action="down" aria-label="Move down">@icon("arrow-down")</button>
			<button type="button" class="btn btn-ghost px-2.5" data-action="remove" aria-label="Remove from release">@icon("x")</button>
		</div>
	</div>
}

func releaseURL(r *audio.Release) templ.SafeURL {
	return templ.SafeURL("/releases/" + r.ID.String())
}

func releasesOfType(releases []*audio.Release, typ audio.ReleaseType) []*audio.Release {
	var out []*audio.Release
	for _, r := range releases {
		if r.Type == typ {
			out = append(out, r)
		}
	}
	return out
}

func pluralLabel(typ audio.ReleaseType) string {
	switch typ {
	case audio.ReleaseAlbum:
		return "Albums"
	case audio.ReleaseEP:
		return "EPs"
	case audio.ReleaseSingle:
		return "Singles"
	case audio.ReleaseCompilation:
		return "Compilations"
	}
	return typ.Label()
}

// releaseFacts is the summary line under an album title, e.g. "2025 · 3 discs · 39 tracks · 2 h 13 min".
func releaseFacts(r *audio.Release) string {
	var parts []string
	if r.Year() != "" {
		parts = append(parts, r.Year())
	}
	if n := len(r.Discs()); n > 1 {
		parts = append(parts, fmt.Sprintf("%d discs", n))
	}
	switch n := len(r.Tracks); n {
	case 0:
	case 1:
		parts = append(parts, "1 track")
	default:
		parts = append(parts, fmt.Sprintf("%d tracks", n))
	}
	if d := r.Duration(); d > 0 {
		parts = append(parts, formatLongDuration(d))
	}
	return joinDot(parts)
}

func formatLongDuration(d time.Duration) string {
	m := int(d.Round(time.Minute).Minutes())
	if m < 60 {
		return fmt.Sprintf("%d min", m)
	}
	return fmt.Sprintf("%d h %d min", m/60, m%60)
}

func joinDot(parts []string) string {
	out := ""
	for _, p := range parts {
		if p == "" {
			continue
		}
		if out != "" {
			out += " · "
		}
		out += p
	}
	return out
}

func notOnRelease(library []*audio.Track, r *audio.Release) []*audio.Track {
	on := make(map[string]bool, len(r.Tracks))
	for _, rt := range r.Tracks {
		on[rt.Track.ID.String()] = true
	}
	var out []*audio.Track
	for _, t := range library {
		if !on[t.ID.String()] {
			out = append(out, t)
		}
	}
	return out
}

func trackOptionLabel(t *audio.Track) string {
	if names := artistNames(t.Artists); names != "" {
		return t.Title + " — " + names
	}
	return t.Title
}

// singleFacts is the meta line of a single: its date and length.
func singleFacts(r *audio.Release) string {
	var parts []string
	if r.Date != "" {
		parts = append(parts, r.Date)
	}
	if len(r.Tracks) > 0 {
		if d := r.Tracks[0].Track.Duration; d > 0 {
			parts = append(parts, formatDuration(d))
		}
	}
	return joinDot(parts)
}

// alsoOn are the other, non-single releases the single's A-side is on.
func alsoOn(r *audio.Release) []*audio.Release {
	if len(r.Tracks) == 0 {
		return nil
	}
	var out []*audio.Release
	for _, other := range r.Tracks[0].Track.Releases {
		if other.ID != r.ID && !other.IsSingle() {
			out = append(out, other)
		}
	}
	return out
}

func discLength(disc []*audio.ReleaseTrack) time.Duration {
	var d time.Duration
	for _, rt := range disc {
		d += rt.Track.Duration
	}
	return d
}
