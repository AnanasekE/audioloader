package components

import (
	"cmp"
	"encoding/json"
	"fmt"
	"math"
	"strings"
	"time"

	"audioloader/internal/audio"
	"audioloader/internal/db"
	"audioloader/internal/downloads"
	"audioloader/internal/jobs"
	"audioloader/internal/sources/ytdlp"
)

const PageDownloads = "downloads"

// DownloadsPage lists placeholder tracks waiting for their files. ytErr and
// spErr are why yt-dlp and spotDL are unavailable, or "".
templ DownloadsPage(active, needsPick, failed, notFound []*db.Download, ytErr, spErr string) {
	@layout("Downloads", PageDownloads) {
		@pageHead("Downloads", fmt.Sprintf("%d in progress · %d need a pick · %d failed · %d not found", len(active), len(needsPick), len(failed), len(notFound))) {
		}
		if ytErr != "" {
			<p class="card mb-6 text-sm">YouTube downloads are off: { ytErr }.</p>
		}
		if spErr != "" {
			<p class="card mb-6 text-sm">spotDL downloads are off: { spErr }.</p>
		}
		<section class="mb-8">
			@sectionLabel("Active")
			@DownloadsActive(active)
		</section>
		<section class="mb-8">
			@sectionLabel("Needs pick")
			<p class="mb-2 text-sm text-fg-muted">
				No other source had these. Pick the right YouTube video; nothing is downloaded from YouTube on a guess.
			</p>
			@downloadList(needsPick, false)
		</section>
		<section class="mb-8">
			@sectionLabel("Failed")
			if len(failed) > 0 {
				<p class="mb-2 text-sm text-fg-muted">
					YouTube often changes in ways that break yt-dlp; updating it usually fixes failed downloads.
				</p>
			}
			@downloadList(failed, true)
		</section>
		<section class="mb-8">
			@sectionLabel("Not found")
			@downloadList(notFound, false)
		</section>
	}
}

// DownloadsActive is polled while downloads run; it stops polling itself
// once nothing is left.
templ DownloadsActive(active []*db.Download) {
	<div
		id="downloads-active"
		if len(active) > 0 {
			hx-get="/ui/downloads/active"
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		if len(active) == 0 {
			@emptyState() {
				Nothing downloading.
			}
		} else {
			@list() {
				@listHead("row-dl", "", "Item", "Progress", "Status", "")
				for _, d := range active {
					@downloadRow(d, false, false)
				}
			}
		}
	</div>
}

templ downloadList(downloads []*db.Download, retry bool) {
	if len(downloads) == 0 {
		@emptyState() {
			None.
		}
	} else {
		@list() {
			@listHead("row-dl", "", "Item", "Progress", "Status", "")
			for _, d := range downloads {
				@downloadRow(d, retry, true)
			}
		}
	}
}

// downloadRow is a download: cover, title over artists and release, its
// progress (or error), a status chip and Retry. With fix set it opens with
// the manual ways to get the file below it.
templ downloadRow(d *db.Download, retry bool, fix bool) {
	<article class="row row-dl">
		@cover(downloadCover(d), 28)
		@downloadTrack(d)
		<span class="dl-prog">
			if d.Status == db.DownloadDownloading {
				@progress(int(d.Progress * 100))
				<span class="mono text-xs text-fg-muted">{ fmt.Sprintf("%d%%", int(d.Progress*100)) }</span>
			} else if d.LastError != "" {
				<span class="text-xs break-words text-st-failed">{ d.LastError }</span>
			}
		</span>
		<span>
			@statusChip(downloadChipStatus(d), downloadStatus(d))
		</span>
		<span class="dl-act">
			if retry {
				<button class="btn btn-ghost" hx-post={ "/ui/downloads/" + d.Track.ID.String() + "/retry" }>Retry</button>
			}
		</span>
		if fix {
			<div class="dl-fix">
				@downloadFix(d.Track)
			</div>
		}
	</article>
}

func downloadCover(d *db.Download) string {
	if d.Track.ImgURL != "" {
		return d.Track.ImgURL
	}
	if d.Release != nil {
		return d.Release.ImgURL
	}
	return "/assets/img/default_track.png"
}

// downloadFix offers the manual ways to get a track's file: picking a
// YouTube result, a YouTube URL, or uploading the file.
templ downloadFix(t *audio.Track) {
	<div class="flex flex-wrap gap-x-6 gap-y-2">
		@youTubePickButton(t)
		<form
			class="flex flex-wrap items-center gap-2"
			hx-post={ "/ui/downloads/" + t.ID.String() + "/youtube" }
			hx-target="next .fix-result"
			hx-on::after-request="if (!event.detail.successful) this.parentElement.querySelector('.fix-result').textContent = event.detail.xhr.responseText"
		>
			<input class="input w-64" type="url" name="url" placeholder="YouTube video URL" aria-label={ "YouTube URL for " + t.Title } required/>
			<button class="btn" type="submit">Download</button>
		</form>
		<form
			class="flex flex-wrap items-center gap-2"
			hx-post={ "/ui/tracks/" + t.ID.String() + "/file" }
			hx-encoding="multipart/form-data"
			hx-on::after-request="if (!event.detail.successful) this.parentElement.querySelector('.fix-result').textContent = event.detail.xhr.responseText"
		>
			<input type="file" name="track" accept={ audioAccept } aria-label={ "File for " + t.Title } required/>
			<button class="btn" type="submit">Upload</button>
		</form>
		<span class="fix-result text-sm text-st-failed" aria-live="polite"></span>
	</div>
}

templ downloadTrack(d *db.Download) {
	<span class="stack">
		<b>{ d.Track.Title }</b>
		<span>
			{ artistNames(d.Track.Artists) }
			if d.Release != nil {
				{ " · " }<a href={ releaseURL(d.Release) }>{ d.Release.Title }</a>{ fmt.Sprintf(" #%d", d.Position) }
			}
		</span>
	</span>
}

// downloadChipStatus maps a download's state to a statusChip colour.
func downloadChipStatus(d *db.Download) string {
	switch d.Status {
	case db.DownloadQueued:
		return "queued"
	case db.DownloadSearching, db.DownloadDownloading:
		return "running"
	}
	return d.Status
}

func downloadStatus(d *db.Download) string {
	switch d.Status {
	case db.DownloadQueued:
		return "Waiting"
	case db.DownloadSearching:
		return "Looking for a file"
	case db.DownloadDownloading:
		return "Downloading from " + d.Source
	case db.DownloadNeedsPick:
		return "Needs a pick"
	case db.DownloadNotFound:
		return "Not found"
	}
	return d.Status
}

// releaseMissing is the release page's section for its placeholder tracks.
templ releaseMissing(r *audio.Release) {
	if n := missingCount(r); n > 0 {
		<section class="mt-6">
			@sectionLabel(fmt.Sprintf("%d tracks not in your library yet", n))
			<p class="mb-3 text-sm text-fg-muted">
				See <a href="/downloads">Downloads</a>, or fill them from a YouTube playlist of this release.
			</p>
			<form
				class="flex flex-wrap items-center gap-2"
				hx-post={ "/ui/releases/" + r.ID.String() + "/youtube" }
				hx-target="#playlist-mapping"
				hx-on::after-request="if (!event.detail.successful) document.getElementById('playlist-mapping').textContent = event.detail.xhr.responseText"
				hx-indicator="#playlist-loading"
			>
				<input class="input w-80" type="url" name="url" placeholder="YouTube playlist URL" aria-label="YouTube playlist URL" required/>
				<button class="btn" type="submit">Match tracks</button>
				<span id="playlist-loading" class="htmx-indicator text-sm text-fg-muted">Reading the playlist…</span>
			</form>
			<div id="playlist-mapping" class="mt-4 text-sm"></div>
			<div class="mt-4">
				@list() {
					for _, rt := range r.Tracks {
						if !rt.Track.HasFile {
							<div class="row row-missing">
								<span class="truncate text-sm">{ fmt.Sprintf("%d. %s", rt.Position, rt.Track.Title) }</span>
								@youTubePickButton(rt.Track)
							</div>
						}
					}
				}
			</div>
		</section>
	}
}

func missingCount(r *audio.Release) int {
	n := 0
	for _, rt := range r.Tracks {
		if !rt.Track.HasFile {
			n++
		}
	}
	return n
}

// PlaylistMapping lets the user check which video fills which track.
templ PlaylistMapping(r *audio.Release, mapping []downloads.Mapping, videos []ytdlp.Entry) {
	<form hx-post={ "/ui/releases/" + r.ID.String() + "/youtube/confirm" } class="grid gap-2">
		for _, m := range mapping {
			<label class="grid items-center gap-2 sm:grid-cols-[2rem_1fr_1fr]">
				<span class="text-right text-fg-muted tabular-nums">{ fmt.Sprint(m.Track.Position) }</span>
				<span class="truncate">{ m.Track.Track.Title }</span>
				<input type="hidden" name="track_id" value={ m.Track.Track.ID.String() }/>
				<select class="input" name="video_id" aria-label={ "Video for " + m.Track.Track.Title }>
					<option value="">No video</option>
					for _, v := range videos {
						<option value={ v.ID } selected?={ v.ID == m.ID }>{ fmt.Sprintf("%s (%s)", v.Title, formatSeconds(v.Duration)) }</option>
					}
				</select>
			</label>
		}
		<div>
			<button class="btn" type="submit">Download matched videos</button>
		</div>
	</form>
}

func formatSeconds(s float64) string {
	return fmt.Sprintf("%d:%02d", int(s)/60, int(s)%60)
}

// YouTubeImportPage imports videos or a playlist as new tracks.
// RecentImports lists the latest YouTube imports and how they went.
templ RecentImports(recent []jobs.Job) {
	@sectionLabel("Recent imports")
	@list() {
		for _, j := range recent {
			<div class="row row-2 row-pad text-sm">
				<span class="truncate">{ importTitle(j) }</span>
				@statusChip(j.Status, j.Status)
				if j.LastError != "" {
					<span class="col-span-full break-words text-st-failed">{ j.LastError }</span>
				}
			</div>
		}
	}
}

func importTitle(j jobs.Job) string {
	var imp downloads.YouTubeImport
	if json.Unmarshal(j.Payload, &imp) != nil {
		return "?"
	}
	return imp.Title
}

// YouTubePreview lists the URL's videos with editable titles, and where
// they go: artists, and a release or new singles.
templ YouTubePreview(info *ytdlp.Info, titles []string, artists []*audio.Artist, releases []*audio.Release) {
	<form
		class="card grid gap-4"
		hx-post="/ui/youtube/import"
		hx-target="#youtube-import-result"
		hx-on::after-request="if (!event.detail.successful) document.getElementById('youtube-import-result').textContent = event.detail.xhr.responseText"
	>
		<p class="text-sm text-fg-muted">
			if info.Type == "playlist" {
				{ fmt.Sprintf("%s: %d videos", info.Title, len(info.Videos())) }
			} else {
				One video
			}
		</p>
		<ol class="grid gap-2">
			for i, v := range info.Videos() {
				<li class="grid items-center gap-2 sm:grid-cols-[auto_1fr_4rem]">
					<input type="checkbox" name="video_id" value={ v.ID } checked aria-label={ "Import " + v.Title }/>
					<input class="input" type="text" name={ "title_" + v.ID } value={ titles[i] } aria-label="Title" required/>
					<span class="text-sm text-fg-muted tabular-nums">{ formatSeconds(v.Duration) }</span>
				</li>
			}
		</ol>
		<div class="grid gap-4 sm:grid-cols-2">
			<div>
				<span class="mb-1 block text-sm font-medium">Artists</span>
				@artistPicker(artists, nil)
			</div>
			<div>
				<span class="mb-1 block text-sm font-medium">Release</span>
				@releaseSelect("", releases, nil, "input")
				<p class="mt-1 text-xs text-fg-muted">On a release, videos are added after its last track, in this order.</p>
			</div>
		</div>
		if info.Type != "playlist" {
			@youTubeCoverFields(downloads.GuessCover(info.Videos()[0].Title))
		}
		<div class="flex items-center gap-4">
			<button class="btn" type="submit">Import</button>
			<span id="youtube-import-result" class="text-sm text-st-failed" aria-live="polite"></span>
		</div>
	</form>
}

// youTubePickButton opens the top 5 YouTube results for a missing track
// below itself. The search runs when it is clicked.
templ youTubePickButton(t *audio.Track) {
	<div class="w-full">
		<button
			type="button"
			class="btn"
			hx-get={ "/ui/downloads/" + t.ID.String() + "/youtube/search" }
			hx-target="next .yt-pick"
			hx-indicator="next .yt-loading"
			hx-on::after-request="if (!event.detail.successful) this.parentElement.querySelector('.yt-pick').textContent = event.detail.xhr.responseText"
			aria-label={ "Pick from YouTube for " + t.Title }
		>Pick from YouTube</button>
		<span class="yt-loading htmx-indicator text-sm text-fg-muted">Searching YouTube…</span>
		<div class="yt-pick mt-2 text-sm text-st-failed" aria-live="polite"></div>
	</div>
}

// YouTubeCandidates lists YouTube search results for a missing track. The
// thumbnails are loaded by the browser from YouTube's image host.
templ YouTubeCandidates(t *audio.Track, found []ytdlp.Entry) {
	<div class="text-fg">
		if len(found) == 0 {
			<p class="text-fg-muted">YouTube found nothing.</p>
		} else {
			@list() {
				for _, c := range found {
					@youTubeCandidate(c, t.Duration) {
						<button
							type="button"
							class="btn"
							hx-post={ "/ui/downloads/" + t.ID.String() + "/youtube" }
							hx-vals={ fmt.Sprintf(`{"video_id": %q}`, c.ID) }
						>Use this</button>
					}
				}
			}
		}
		<button type="button" class="btn mt-2" hx-post={ "/ui/downloads/" + t.ID.String() + "/youtube/none" }>None of these</button>
	</div>
}

// youTubeCandidate is one search result: thumbnail, title, channel, length
// (against expected, if known) and a Preview link, then the caller's buttons.
templ youTubeCandidate(c ytdlp.Entry, expected time.Duration) {
	<div class="row row-yt">
		<img class="cover h-9 w-16 shrink-0" src={ c.Thumbnail } alt="" loading="lazy" referrerpolicy="no-referrer"/>
		<span class="stack min-w-0 flex-1">
			<b>{ c.Title }</b>
			<span>
				{ channelName(c) }
				if d := lengthDiff(c.Duration, expected); d != "" {
					{ " (" + d + ")" }
				}
				for _, b := range channelBadges(c) {
					@chip(b)
				}
			</span>
		</span>
		<span class="mono text-fg-muted">{ formatSeconds(c.Duration) }</span>
		<span class="flex items-center gap-2">
			<a class="btn btn-ghost" href={ templ.SafeURL(ytdlp.VideoURL(c.ID)) } target="_blank" rel="noopener noreferrer">Preview</a>
			{ children... }
		</span>
	</div>
}

func channelName(e ytdlp.Entry) string {
	return cmp.Or(e.Channel, e.Uploader, "unknown channel")
}

// channelBadges marks channels worth trusting: YouTube's auto-generated
// "- Topic" channels (the album audio), verified and official ones.
func channelBadges(e ytdlp.Entry) []string {
	var out []string
	name := channelName(e)
	if strings.HasSuffix(name, " - Topic") {
		out = append(out, "Topic")
	}
	if e.ChannelIsVerified {
		out = append(out, "Verified")
	} else if strings.Contains(strings.ToLower(name), "official") {
		out = append(out, "Official")
	}
	return out
}

// lengthDiff is the video's length against the track's, e.g. "+2 s"; ""
// when the track's length isn't known.
func lengthDiff(video float64, expected time.Duration) string {
	if expected <= 0 || video <= 0 {
		return ""
	}
	diff := int(math.Round(video - expected.Seconds()))
	switch {
	case diff == 0:
		return "same length"
	case diff > 0:
		return fmt.Sprintf("+%d s", diff)
	}
	return fmt.Sprintf("%d s", diff)
}
