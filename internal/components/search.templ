package components

import (
	"context"
	"net/url"

	"audioloader/internal/audio"
	"audioloader/internal/db"
)

// SearchPage shows every kind of match for q.
templ SearchPage(q string, res *db.SearchResults) {
	@layout("Search", "") {
		@pageHead("Search", searchSubtitle(q)) {
		}
		if q != "" && !secretMode(ctx) {
			<p class="mb-4 text-sm text-fg-muted">
				Not in your library? <a href={ templ.SafeURL("/add?q=" + url.QueryEscape(q)) }>Add “{ q }” as a song</a>
			</p>
		}
		if q != "" && res.Empty() {
			@emptyState() {
				Nothing matches.
			}
		}
		if len(res.Tracks) > 0 {
			<section class="mb-6">
				@sectionLabel("Tracks")
				@TrackList(res.Tracks)
			</section>
		}
		if len(res.Releases) > 0 {
			<section class="mb-6">
				@sectionLabel("Releases")
				@list() {
					for _, r := range res.Releases {
						@searchRow(r.ImgURL, r.Title, artistNames(r.Artists), string(releaseURL(r)), r.Type.Label(), false)
					}
				}
			</section>
		}
		if len(res.Artists) > 0 {
			<section class="mb-6">
				@sectionLabel(artistsWord(ctx))
				@list() {
					for _, a := range res.Artists {
						@searchRow(a.ImgURL, a.Name, "", string(artistURL(a)), "", true)
					}
				}
			</section>
		}
		if len(res.Shows) > 0 {
			<section class="mb-6">
				@sectionLabel("Podcasts")
				@list() {
					for _, s := range res.Shows {
						@searchRow(s.ImgURL, s.Title, s.Author, string(showURL(s.ID.String())), "", false)
					}
				}
			</section>
		}
	}
}

func artistsWord(ctx context.Context) string {
	if secretMode(ctx) {
		return "Creators"
	}
	return "Artists"
}

// searchRow is a result that links elsewhere: a small picture, a title with
// a muted line under it, and a kind chip.
templ searchRow(img, title, sub, href, kind string, round bool) {
	<a class="row row-2 row-pad" href={ templ.SafeURL(href) }>
		<span class="flex min-w-0 items-center gap-2.5">
			if round {
				@avatar(img, 28)
			} else {
				@cover(img, 28)
			}
			<span class="stack">
				<b>{ title }</b>
				if sub != "" {
					<span>{ sub }</span>
				}
			</span>
		</span>
		if kind != "" {
			@chipKind(kind)
		}
	</a>
}

func searchSubtitle(q string) string {
	if q == "" {
		return "Tracks, releases and artists"
	}
	return "Results for “" + q + "”"
}

// SearchSuggest is the dropdown under the nav search box.
templ SearchSuggest(q string, res *db.SearchResults) {
	if q != "" {
		<div class="pop absolute top-full left-0 z-30 mt-1 max-h-[70vh] w-full min-w-80 overflow-y-auto">
			if res.Empty() {
				<p class="px-2 py-1 text-fg-muted">Nothing matches.</p>
			}
			if len(res.Tracks) > 0 {
				@sectionLabel("Tracks")
				for _, t := range res.Tracks {
					@suggestItem(t.ImgURL, t.Title, artistNames(t.Artists), string(trackURL(t)), false)
				}
			}
			if len(res.Releases) > 0 {
				@sectionLabel("Releases")
				for _, r := range res.Releases {
					@suggestItem(r.ImgURL, r.Title, r.Type.Label()+" · "+artistNames(r.Artists), string(releaseURL(r)), false)
				}
			}
			if len(res.Artists) > 0 {
				@sectionLabel(artistsWord(ctx))
				for _, a := range res.Artists {
					@suggestItem(a.ImgURL, a.Name, "", string(searchURL(a.Name)), true)
				}
			}
			if len(res.Shows) > 0 {
				@sectionLabel("Podcasts")
				for _, s := range res.Shows {
					@suggestItem(s.ImgURL, s.Title, "", string(showURL(s.ID.String())), false)
				}
			}
			<a class="menu-item mt-1 border-t border-line text-accent" href={ searchURL(q) }>All results</a>
		</div>
	}
}

templ suggestItem(img, title, sub, href string, round bool) {
	<a class="menu-item min-h-11 gap-2.5 py-1 focus:bg-panel-2" href={ templ.SafeURL(href) }>
		if round {
			@avatar(img, 28)
		} else {
			@cover(img, 28)
		}
		<span class="stack">
			<b class="truncate font-medium">{ title }</b>
			if sub != "" {
				<span class="truncate text-xs text-fg-muted">{ sub }</span>
			}
		</span>
	</a>
}

func searchURL(q string) templ.SafeURL {
	return templ.SafeURL("/search?q=" + url.QueryEscape(q))
}

// trackURL links a track to the release it is best known from; tracks
// have no page of their own.
func trackURL(t *audio.Track) templ.SafeURL {
	if r := mainRelease(t); r != nil {
		return releaseURL(r)
	}
	if len(t.Releases) > 0 {
		return releaseURL(t.Releases[0])
	}
	return searchURL(t.Title)
}
