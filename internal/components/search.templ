package components

import (
	"net/url"

	"audioloader/internal/audio"
	"audioloader/internal/db"
)

// SearchPage shows every kind of match for q.
templ SearchPage(q string, res *db.SearchResults) {
	@layout("Search", "") {
		@pageHeader("Search", searchSubtitle(q)) {
		}
		if q != "" && res.Empty() {
			@emptyState() {
				Nothing matches.
			}
		}
		if len(res.Artists) > 0 {
			<h2 class="mb-3 text-lg font-semibold">Artists</h2>
			<div class="mb-8">
				@ArtistList(res.Artists)
			</div>
		}
		if len(res.Releases) > 0 {
			<h2 class="mb-3 text-lg font-semibold">Releases</h2>
			<div class="mb-8">
				@releaseGrid(res.Releases)
			</div>
		}
		if len(res.Tracks) > 0 {
			<h2 class="mb-3 text-lg font-semibold">Tracks</h2>
			@TrackList(res.Tracks)
		}
	}
}

func searchSubtitle(q string) string {
	if q == "" {
		return "Tracks, releases and artists"
	}
	return "Results for “" + q + "”"
}

// SearchSuggest is the dropdown under the nav search box.
templ SearchSuggest(q string, res *db.SearchResults) {
	if q != "" {
		<div class="absolute right-0 z-30 mt-1 w-80 rounded-md border border-zinc-300 bg-white p-2 text-sm shadow-lg dark:border-zinc-700 dark:bg-zinc-800">
			if res.Empty() {
				<p class="px-2 py-1 text-zinc-500">Nothing matches.</p>
			}
			for _, a := range res.Artists {
				<a class="block truncate rounded px-2 py-1 hover:bg-zinc-100 hover:no-underline dark:hover:bg-zinc-700" href={ searchURL(a.Name) }>
					{ a.Name }<span class="text-zinc-500">{ " · Artist" }</span>
				</a>
			}
			for _, r := range res.Releases {
				<a class="block truncate rounded px-2 py-1 hover:bg-zinc-100 hover:no-underline dark:hover:bg-zinc-700" href={ releaseURL(r) }>
					{ r.Title }<span class="text-zinc-500">{ " · " + r.Type.Label() + " · " + artistNames(r.Artists) }</span>
				</a>
			}
			for _, t := range res.Tracks {
				<a class="block truncate rounded px-2 py-1 hover:bg-zinc-100 hover:no-underline dark:hover:bg-zinc-700" href={ trackURL(t) }>
					{ t.Title }<span class="text-zinc-500">{ " · " + artistNames(t.Artists) }</span>
				</a>
			}
			<a class="mt-1 block border-t border-zinc-200 px-2 pt-2 dark:border-zinc-700" href={ searchURL(q) }>All results</a>
		</div>
	}
}

func searchURL(q string) templ.SafeURL {
	return templ.SafeURL("/search?q=" + url.QueryEscape(q))
}

// trackURL links a track to the release it is best known from; tracks
// have no page of their own.
func trackURL(t *audio.Track) templ.SafeURL {
	if r := mainRelease(t); r != nil {
		return releaseURL(r)
	}
	if len(t.Releases) > 0 {
		return releaseURL(t.Releases[0])
	}
	return searchURL(t.Title)
}
