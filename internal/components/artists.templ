package components

import (
	"fmt"
	"slices"

	"audioloader/internal/audio"
)

templ ArtistsPage(artists []*audio.Artist) {
	@layout("Artists", PageArtists) {
		@pageHeader("Artists", fmt.Sprintf("%d in library", len(artists))) {
		}
		@AddArtistForm()
		<div
			id="artist-list"
			class="mt-6"
			hx-get="/ui/artists"
			hx-trigger="artistsChanged from:body"
			hx-swap="innerHTML"
		>
			@ArtistList(artists)
		</div>
	}
}

templ AddArtistForm() {
	<section class="card">
		<form
			class="flex gap-2"
			hx-post="/ui/artists"
			hx-encoding="multipart/form-data"
			hx-target="#result-artist"
			hx-on::after-request="if (event.detail.successful) this.reset()"
		>
			<label for="artist-name" class="sr-only">Artist name</label>
			<input id="artist-name" class="input flex-1" type="text" name="name" placeholder="New artist name" required/>
			<button class="btn shrink-0" type="submit">Add artist</button>
		</form>
		<div id="result-artist" aria-live="polite"></div>
	</section>
}

// artistPicker is a dropdown of artist checkboxes, submitted as repeated
// artist_id values. The summary text is kept up to date by artist-picker.js.
templ artistPicker(artists []*audio.Artist, selected []string) {
	<details class="relative" data-artist-picker>
		<summary class="input cursor-pointer list-none truncate" data-artist-summary>Select artists</summary>
		<div class="absolute z-10 mt-1 w-full rounded-md border border-zinc-300 bg-white p-2 shadow-lg dark:border-zinc-700 dark:bg-zinc-800">
			// no name attribute: the search box is never submitted with the form
			<input type="search" class="input mb-2" placeholder="Search artists…" aria-label="Search artists" autocomplete="off" data-artist-search/>
			<div class="max-h-60 overflow-auto" data-artist-options>
				for _, a := range artists {
					<label class="flex cursor-pointer items-center gap-2 rounded px-1 py-1 text-sm hover:bg-zinc-100 dark:hover:bg-zinc-700">
						<input type="checkbox" name="artist_id" value={ a.ID.String() } data-name={ a.Name } checked?={ slices.Contains(selected, a.ID.String()) }/>
						{ a.Name }
					</label>
				}
			</div>
			<p class="px-1 py-1 text-sm text-zinc-500" hidden data-artist-empty>No matching artists.</p>
		</div>
	</details>
}

templ Artist(a *audio.Artist) {
	<article class="card flex flex-col items-center gap-2 px-2 py-4 text-center">
		<img class="pixelated size-20 rounded-full bg-white object-cover dark:bg-zinc-900" src={ a.ImgURL } alt=""/>
		<a class="block max-w-full truncate" href={ artistURL(a) }>{ a.Name }</a>
		<a class="text-sm" href={ templ.SafeURL("/upload/batch?artist=" + a.ID.String()) }>Batch upload</a>
		<a class="text-sm" href={ templ.SafeURL("/artists/" + a.ID.String() + "/follow") }>
			if a.Followed {
				Following
			} else {
				Follow releases
			}
		</a>
	</article>
}

templ ArtistList(artists []*audio.Artist) {
	if len(artists) == 0 {
		@emptyState() {
			No artists yet.
		}
	} else {
		<div class="grid grid-cols-[repeat(auto-fill,minmax(8rem,1fr))] gap-4">
			for _, artist := range artists {
				@Artist(artist)
			}
		</div>
	}
}

func artistURL(a *audio.Artist) templ.SafeURL {
	return templ.SafeURL("/artists/" + a.ID.String())
}

// artistLinks lists artist names, each linking to the artist's page.
templ artistLinks(artists []*audio.Artist) {
	for i, a := range artists {
		if i > 0 {
			{ ", " }
		}
		<a href={ artistURL(a) }>{ a.Name }</a>
	}
}

// ArtistPage shows an artist with their releases by type, then the tracks
// that aren't on any of those releases.
templ ArtistPage(a *audio.Artist, releases []*audio.Release, tracks []*audio.Track) {
	@layout(a.Name, PageArtists) {
		<div class="mb-8 flex flex-col gap-6 sm:flex-row sm:items-end">
			<img class="pixelated size-40 shrink-0 rounded-full bg-zinc-100 object-cover shadow dark:bg-zinc-800" src={ a.ImgURL } alt=""/>
			<div class="min-w-0">
				<p class="text-sm font-medium tracking-wide text-zinc-500 uppercase dark:text-zinc-400">Artist</p>
				<h1 class="text-4xl font-bold tracking-tight">{ a.Name }</h1>
				<p class="mt-1 text-sm">
					if a.MBID != "" {
						<a href={ templ.SafeURL("https://musicbrainz.org/artist/" + a.MBID) } rel="noopener noreferrer">MusicBrainz</a>
						{ " · " }
					}
					<a href={ templ.SafeURL("/artists/" + a.ID.String() + "/follow") }>
						if a.Followed {
							Following
						} else {
							Follow releases
						}
					</a>
					{ " · " }
					<a href={ templ.SafeURL("/upload/batch?artist=" + a.ID.String()) }>Batch upload</a>
				</p>
			</div>
		</div>
		@artistImageForm(a)
		if len(releases) == 0 && len(tracks) == 0 {
			@emptyState() {
				Nothing by this artist yet.
			}
		}
		for _, typ := range audio.ReleaseTypes {
			if rs := releasesOfType(releases, typ); len(rs) > 0 {
				<section class="mb-10">
					<h2 class="mb-4 text-xl font-semibold">{ pluralLabel(typ) }</h2>
					if typ == audio.ReleaseSingle {
						@singleList(rs)
					} else {
						@releaseGrid(rs)
					}
				</section>
			}
		}
		if len(tracks) > 0 {
			<section class="mb-10">
				<h2 class="mb-4 text-xl font-semibold">Other tracks</h2>
				@TrackList(tracks)
			</section>
		}
	}
}

templ artistImageForm(a *audio.Artist) {
	<details class="mb-8">
		<summary class="cursor-pointer text-sm font-medium">Change picture</summary>
		<form
			class="card mt-2 grid max-w-lg gap-2"
			hx-post={ "/ui/artists/" + a.ID.String() + "/image" }
			hx-encoding="multipart/form-data"
			hx-target="#artist-image-result"
			hx-on::after-request="if (!event.detail.successful) document.getElementById('artist-image-result').textContent = event.detail.xhr.responseText || 'Could not upload the picture.'"
		>
			<label for="artist-image" class="text-sm font-medium">Picture (JPEG, PNG or WebP, up to 10 MiB)</label>
			<input id="artist-image" type="file" name="image" accept="image/jpeg,image/png,image/webp" required/>
			<div class="flex flex-wrap items-center gap-4">
				<button class="btn" type="submit">Upload picture</button>
				<button
					type="button"
					class="btn"
					hx-post={ "/ui/artists/" + a.ID.String() + "/image/remove" }
					hx-confirm="Go back to the default picture?"
				>Remove picture</button>
				<span id="artist-image-result" class="text-sm text-red-600 dark:text-red-400" aria-live="polite"></span>
			</div>
		</form>
	</details>
}
