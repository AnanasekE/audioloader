package components

import (
	"fmt"
	"net/url"
	"slices"
	"strings"

	"audioloader/internal/audio"
	"audioloader/internal/db"
	"audioloader/internal/mb"
)

templ ArtistsPage(artists []*audio.Artist) {
	@layout("Artists", PageArtists) {
		@pageHead("Artists", fmt.Sprintf("%d in library", len(artists))) {
			@gridFilterInput("Filter artists")
			@popover("Add artist") {
				@AddArtistForm()
			}
			if !secretMode(ctx) {
				@popover("Add from MusicBrainz") {
					@AddArtistFromMusicBrainz()
				}
			}
		}
		<div
			id="artist-list"
			hx-get="/ui/artists"
			hx-trigger="artistsChanged from:body"
			hx-swap="innerHTML"
		>
			@ArtistList(artists)
		</div>
	}
}

// AddArtistFromMusicBrainz searches MusicBrainz for an artist to add.
templ AddArtistFromMusicBrainz() {
	<section class="card mt-4">
		<h2 class="mb-2 text-lg font-semibold">Add from MusicBrainz</h2>
		<form
			class="flex gap-2"
			hx-get="/ui/artists/musicbrainz"
			hx-target="#mb-artist-results"
			hx-disabled-elt="find button"
		>
			<label class="sr-only" for="mb-artist-q">Artist name</label>
			<input id="mb-artist-q" class="input flex-1" type="text" name="q" placeholder="Artist name" required/>
			<button class="btn shrink-0" type="submit">Search</button>
		</form>
		<div id="mb-artist-results" class="mt-3" aria-live="polite"></div>
	</section>
}

// MBArtistCandidate is a MusicBrainz artist found by name, with how it
// relates to the library.
type MBArtistCandidate struct {
	Artist  mb.Artist
	Match   db.MBArtistMatch
	Library *audio.Artist // the matching library artist, nil for MBArtistNew
	AddName string        // name to add it under; "" when it can't be added
}

// MBArtistCandidates is the answer to the search: pick one to add.
templ MBArtistCandidates(found []MBArtistCandidate, searchErr string) {
	<div
		class="card grid gap-3"
		hx-target="#mb-artist-results"
		hx-on::after-request="this.querySelector('[data-link-result]').textContent = event.detail.successful ? '' : (event.detail.xhr.responseText || 'Could not add.')"
	>
		for _, c := range found {
			@artistCandidate(c.Artist) {
				switch c.Match {
					case db.MBArtistLinked:
						<a hx-target="body" hx-swap="innerHTML" class="btn shrink-0" href={ artistURL(c.Library) }>In your library</a>
					case db.MBArtistNameTaken:
						if c.AddName != "" {
							@addMBArtistButton(c, "Add as "+c.AddName)
						} else {
							<span class="shrink-0 text-fg-muted">
								Name taken by <a hx-target="body" hx-swap="innerHTML" class="underline" href={ artistURL(c.Library) }>{ c.Library.Name }</a>
							</span>
						}
					case db.MBArtistSameName:
						@addMBArtistButton(c, "Link "+c.Library.Name)
					default:
						@addMBArtistButton(c, "Add")
				}
			}
		}
		if searchErr != "" {
			<p class="text-sm text-st-failed">{ searchErr }</p>
		} else if len(found) == 0 {
			<p class="text-sm text-fg-muted">MusicBrainz found no artist with that name. Add it by name above.</p>
		}
		<div class="flex flex-wrap items-center gap-4">
			<button
				type="button"
				class="btn"
				onclick="document.getElementById('mb-artist-results').innerHTML = ''"
			>None of these</button>
			<span data-link-result class="text-sm text-st-failed empty:hidden" aria-live="polite"></span>
		</div>
	</div>
}

templ addMBArtistButton(c MBArtistCandidate, label string) {
	<button
		type="button"
		class="btn shrink-0"
		hx-post="/ui/artists/musicbrainz"
		hx-vals={ templ.JSONString(map[string]string{"mbid": c.Artist.ID, "name": c.AddName}) }
	>{ label }</button>
}

// MBArtistAdded is the answer to a pick, with what to do next.
templ MBArtistAdded(a *audio.Artist, m db.MBArtistMatch) {
	<div class="card flex flex-wrap items-center gap-3 text-sm">
		switch m {
			case db.MBArtistLinked:
				<span>{ a.Name } is already in your library.</span>
			case db.MBArtistSameName:
				<span>Linked { a.Name } to MusicBrainz.</span>
			default:
				<span>Added { a.Name }.</span>
		}
		<a class="btn btn-ghost" href={ artistURL(a) }>Open</a>
		if a.Followed {
			<span class="text-fg-muted">Following</span>
		} else {
			<a class="btn" href={ templ.SafeURL("/artists/" + a.ID.String() + "/follow") }>Follow</a>
		}
	</div>
}

templ AddArtistForm() {
	<section class="card">
		<form
			class="flex gap-2"
			hx-post="/ui/artists"
			hx-encoding="multipart/form-data"
			hx-target="#result-artist"
			hx-on::after-request="if (event.detail.successful) this.reset()"
		>
			<label for="artist-name" class="sr-only">Artist name</label>
			<input id="artist-name" class="input flex-1" type="text" name="name" placeholder="New artist name" required/>
			<button class="btn shrink-0" type="submit">Add artist</button>
		</form>
		<div id="result-artist" aria-live="polite"></div>
	</section>
}

// artistPicker is a dropdown of artist checkboxes, submitted as repeated
// artist_id values. The summary text is kept up to date by artist-picker.js.
templ artistPicker(artists []*audio.Artist, selected []string) {
	@artistPickerNew(artists, selected, "")
}

// artistPickerNew is artistPicker with, when newCreator is not empty, a
// pre-checked "New: <name>" option on top. It is submitted as new_creator.
templ artistPickerNew(artists []*audio.Artist, selected []string, newCreator string) {
	<details class="relative" data-artist-picker>
		<summary class="input cursor-pointer list-none truncate" data-artist-summary>Select artists</summary>
		<div class="absolute z-10 mt-1 w-full rounded-md border border-line bg-panel p-2 shadow-(--shadow-pop)">
			// no name attribute: the search box is never submitted with the form
			<input type="search" class="input mb-2" placeholder="Search artists…" aria-label="Search artists" autocomplete="off" data-artist-search/>
			<div class="max-h-60 overflow-auto" data-artist-options>
				if newCreator != "" {
					<label class="flex cursor-pointer items-center gap-2 rounded px-1 py-1 text-sm hover:bg-panel-2">
						<input type="checkbox" name="new_creator" value={ newCreator } data-name={ newCreator } checked/>
						New: { newCreator }
					</label>
				}
				for _, a := range artists {
					<label class="flex cursor-pointer items-center gap-2 rounded px-1 py-1 text-sm hover:bg-panel-2">
						<input type="checkbox" name="artist_id" value={ a.ID.String() } data-name={ a.Name } checked?={ slices.Contains(selected, a.ID.String()) }/>
						{ a.Name }
					</label>
				}
			</div>
			<p class="px-1 py-1 text-sm text-fg-muted" hidden data-artist-empty>No matching artists.</p>
		</div>
	</details>
}

templ Artist(a *audio.Artist) {
	@tileWithMenu(a.Name) {
		if secretMode(ctx) {
			// creators have no releases to count
			@avatarCard(a.ImgURL, a.Name, "", string(artistURL(a)))
		} else {
			@avatarCard(a.ImgURL, a.Name, releaseCountLabel(a.ReleaseCount), string(artistURL(a)))
		}
		@artistMenu(a, "card")
	}
}

// artistMenu is the ⋯ menu of an artist, on their card and in their header.
// Renaming and linking are in the page's Manage section.
templ artistMenu(a *audio.Artist, where string) {
	@ctxMenu(where, "More for "+a.Name) {
		@sourceItems("artists/"+a.ID.String(), "Play all", false)
		<a class="menu-item" href={ templ.SafeURL("/artists/" + a.ID.String() + "#manage") }>Edit / rename</a>
		if !secretMode(ctx) {
			if a.Followed {
				<a class="menu-item" href={ templ.SafeURL("/artists/" + a.ID.String() + "/follow") }>Following ✓</a>
			} else {
				<a class="menu-item" href={ templ.SafeURL("/artists/" + a.ID.String() + "/follow") }>Follow releases</a>
			}
			if a.MBID == "" {
				<a class="menu-item" href={ templ.SafeURL("/artists/" + a.ID.String() + "#manage") }>Link to MusicBrainz…</a>
			}
		}
	}
}

func releaseCountLabel(n int) string {
	if n == 1 {
		return "1 release"
	}
	return fmt.Sprintf("%d releases", n)
}

templ ArtistList(artists []*audio.Artist) {
	if len(artists) == 0 {
		@emptyState() {
			No { strings.ToLower(artistsWord(ctx)) } yet. Add one with the button above, or <a href="/add">add a song</a>.
		}
	} else {
		@cardGrid() {
			for _, artist := range artists {
				@Artist(artist)
			}
		}
	}
}

func artistURL(a *audio.Artist) templ.SafeURL {
	return templ.SafeURL("/artists/" + a.ID.String())
}

// artistLinks lists artist names, each linking to the artist's page.
templ artistLinks(artists []*audio.Artist) {
	for i, a := range artists {
		if i > 0 {
			{ ", " }
		}
		<a href={ artistURL(a) }>{ a.Name }</a>
	}
}

// ArtistPage shows an artist with their releases by type, then the tracks
// that aren't on any of those releases, then the covers of their songs.
templ ArtistPage(a *audio.Artist, releases []*audio.Release, tracks []*audio.Track, covers []*audio.Track, others []*audio.Artist, twitchOn bool, uploaders []string) {
	@layout(a.Name, PageArtists) {
		@avatarHeader(a.ImgURL, "Artist", a.Name, artistSub(a, uploaders), releaseCountLabel(len(releases))) {
			if !secretMode(ctx) {
				if a.Followed {
					<a class="btn btn-ghost" href={ templ.SafeURL("/artists/" + a.ID.String() + "/follow") }>Following</a>
				} else {
					<a class="btn" href={ templ.SafeURL("/artists/" + a.ID.String() + "/follow") }>Follow releases</a>
				}
			}
			<a class="btn btn-ghost" href={ templ.SafeURL("/upload/batch?artist=" + a.ID.String()) }>Batch upload</a>
			@artistMenu(a, "head")
		}
		if len(releases) == 0 && len(tracks) == 0 && len(covers) == 0 {
			@emptyState() {
				Nothing by this artist yet. <a href={ templ.SafeURL("/upload/batch?artist=" + a.ID.String()) }>Upload tracks</a>, or <a href={ templ.SafeURL("/add?q=" + url.QueryEscape(a.Name)) }>search for their songs</a>.
			}
		}
		for _, typ := range audio.ReleaseTypes {
			if rs := releasesOfType(releases, typ); len(rs) > 0 {
				<section class="mb-8">
					@sectionLabel(pluralLabel(typ))
					if typ == audio.ReleaseSingle {
						@singleList(rs)
					} else {
						@releaseGrid(rs)
					}
				</section>
			}
		}
		if len(tracks) > 0 {
			<section class="mb-8">
				@sectionLabel("Other tracks")
				@TrackList(tracks)
			</section>
		}
		if len(covers) > 0 {
			<section class="mb-8">
				@sectionLabel("Covered by")
				@TrackList(covers)
			</section>
		}
		<details id="manage" class="mb-8">
			<summary class="btn btn-ghost inline-flex cursor-pointer list-none">Manage</summary>
			<div class="mt-3">
				@formPanel() {
					@artistImageForm(a)
					@artistTwitchForm(a, twitchOn)
					if a.MBID == "" && !secretMode(ctx) {
						@artistLinkSection(a)
					}
					@artistManageForm(a, others)
				}
			</div>
		</details>
		// the ⋯ menu links to #manage, which should be open when it is there
		<script>if (location.hash === "#manage") document.getElementById("manage").open = true</script>
	}
}

// artistSub is the line under an artist's name: links to their MusicBrainz
// and Twitch pages as chips, and where their tracks come from.
templ artistSub(a *audio.Artist, uploaders []string) {
	<div class="flex flex-wrap items-center gap-2 text-sm">
		if a.MBID != "" && !secretMode(ctx) {
			<a class="chip" href={ templ.SafeURL("https://musicbrainz.org/artist/" + a.MBID) } rel="noopener noreferrer">MusicBrainz</a>
		}
		if a.TwitchLogin != "" {
			<a class="chip" href={ templ.SafeURL("https://www.twitch.tv/" + a.TwitchLogin) } rel="noopener noreferrer">Twitch</a>
		}
		for _, u := range uploaders {
			@UploaderLink(u)
		}
	</div>
}

templ artistImageForm(a *audio.Artist) {
	<details>
		<summary class="cursor-pointer text-sm font-medium">Change picture</summary>
		<form
			class="mt-2 grid gap-2"
			hx-post={ "/ui/artists/" + a.ID.String() + "/image" }
			hx-encoding="multipart/form-data"
			hx-target="#artist-image-result"
			hx-on::after-request="if (!event.detail.successful) document.getElementById('artist-image-result').textContent = event.detail.xhr.responseText || 'Could not upload the picture.'"
		>
			<label for="artist-image" class="text-xs font-medium text-fg-muted">Picture (JPEG, PNG or WebP, up to 10 MiB)</label>
			<input id="artist-image" type="file" name="image" accept="image/jpeg,image/png,image/webp" required/>
			<div class="flex flex-wrap items-center gap-4">
				<button class="btn" type="submit">Upload picture</button>
				<button
					type="button"
					class="btn"
					hx-post={ "/ui/artists/" + a.ID.String() + "/image/remove" }
					hx-confirm="Go back to the default picture?"
				>Remove picture</button>
				<span id="artist-image-result" class="text-sm text-st-failed" aria-live="polite"></span>
			</div>
		</form>
	</details>
}

// artistTwitchForm sets the artist's Twitch channel. Saving fetches the
// channel's picture for an artist with the default picture; Update replaces
// the picture on request only.
templ artistTwitchForm(a *audio.Artist, twitchOn bool) {
	<details>
		<summary class="cursor-pointer text-sm font-medium">Twitch channel</summary>
		<form
			class="mt-2 grid gap-2"
			hx-post={ "/ui/artists/" + a.ID.String() + "/twitch" }
			hx-target="#artist-twitch-result"
			hx-on::after-request="if (!event.detail.successful) document.getElementById('artist-twitch-result').textContent = event.detail.xhr.responseText || 'Could not save.'"
		>
			<label for="artist-twitch" class="text-xs font-medium text-fg-muted">Login or twitch.tv link (empty removes it)</label>
			<input id="artist-twitch" class="input" type="text" name="twitch" value={ a.TwitchLogin } placeholder="e.g. cottontailva" maxlength="200"/>
			if !twitchOn {
				<p class="text-sm text-fg-muted">
					Pictures can't be fetched: set <code>TWITCH_CLIENT_ID</code> and <code>TWITCH_CLIENT_SECRET</code>.
				</p>
			}
			<div class="flex flex-wrap items-center gap-4">
				<button class="btn" type="submit">Save</button>
				if a.TwitchLogin != "" && twitchOn {
					<button
						type="button"
						class="btn"
						hx-post={ "/ui/artists/" + a.ID.String() + "/twitch/picture" }
						hx-target="#artist-twitch-result"
						hx-confirm="Replace the picture with the channel's current one?"
					>Update picture from Twitch</button>
				}
				<span id="artist-twitch-result" class="text-sm text-st-failed empty:hidden" aria-live="polite"></span>
			</div>
		</form>
	</details>
}

// artistManageForm renames an artist or merges them into another one.
templ artistManageForm(a *audio.Artist, others []*audio.Artist) {
	<details>
		<summary class="cursor-pointer text-sm font-medium">Rename or merge</summary>
		<div class="mt-2 grid gap-4">
			<form
				class="flex gap-2"
				hx-post={ "/ui/artists/" + a.ID.String() + "/rename" }
				hx-target="#artist-manage-result"
				hx-on::after-request="if (!event.detail.successful) document.getElementById('artist-manage-result').textContent = event.detail.xhr.responseText || 'Could not rename.'"
			>
				<label for="artist-rename" class="sr-only">Name</label>
				<input id="artist-rename" class="input flex-1" type="text" name="name" value={ a.Name } required/>
				<button class="btn shrink-0" type="submit">Rename</button>
			</form>
			if len(others) > 1 {
				<form
					class="flex gap-2"
					hx-post={ "/ui/artists/" + a.ID.String() + "/merge" }
					hx-target="#artist-manage-result"
					hx-confirm={ "Merge " + a.Name + " into the chosen artist? Their tracks and releases move over and " + a.Name + " is deleted." }
					hx-on::after-request="if (!event.detail.successful) document.getElementById('artist-manage-result').textContent = event.detail.xhr.responseText || 'Could not merge.'"
				>
					<label for="artist-merge" class="sr-only">Merge into</label>
					<select id="artist-merge" class="input flex-1" name="into" required>
						<option value="">Merge into…</option>
						for _, o := range others {
							if o.ID != a.ID {
								<option value={ o.ID.String() }>{ o.Name }</option>
							}
						}
					</select>
					<button class="btn shrink-0" type="submit">Merge</button>
				</form>
			}
			<span id="artist-manage-result" class="text-sm text-st-failed empty:hidden" aria-live="polite"></span>
		</div>
	</details>
}

// artistCandidate is a MusicBrainz artist with what tells namesakes apart:
// disambiguation, type, country and active years. Expand loads a few of
// their release groups. The children are the control that picks it.
templ artistCandidate(c mb.Artist) {
	<div class="row row-cand text-sm">
		{ children... }
		<div class="min-w-0 flex-1">
			<a class="font-medium" href={ templ.SafeURL("https://musicbrainz.org/artist/" + c.ID) } target="_blank" rel="noopener">{ c.Name }</a>
			if c.MatchedAlias != "" {
				<span class="text-fg-muted">{ " (alias: " + c.MatchedAlias + ")" }</span>
			}
			if d := candidateDetails(c); d != "" {
				<span class="text-fg-muted">{ " " + d }</span>
			}
			<button
				type="button"
				class="ml-2 text-xs underline"
				hx-get={ "/ui/musicbrainz/artists/" + c.ID + "/releases" }
				hx-target="next .candidate-releases"
				hx-swap="innerHTML"
				hx-disabled-elt="this"
			>Expand</button>
			<div class="candidate-releases text-fg-muted" aria-live="polite"></div>
		</div>
	</div>
}

// CandidateReleases is the answer to Expand: an artist's newest release groups.
templ CandidateReleases(groups []mb.ReleaseGroup, failed bool) {
	if failed {
		<p class="text-st-failed">Couldn't load releases from MusicBrainz.</p>
	} else if len(groups) == 0 {
		<p class="text-fg-muted">No releases listed.</p>
	} else {
		<div class="list mt-1">
			for _, g := range groups {
				@row("row-2 row-pad") {
					<span class="truncate">{ g.Title }</span>
					<span class="mono text-fg-muted">{ joinNonEmpty(", ", g.PrimaryType, g.FirstReleaseDate) }</span>
				}
			}
		</div>
	}
}

func candidateDetails(a mb.Artist) string {
	place := a.Area.Name
	if place == "" {
		place = a.Country
	}
	years := a.LifeSpan.Begin
	if len(years) > 4 {
		years = years[:4]
	}
	if end := a.LifeSpan.End; years != "" || end != "" {
		if len(end) > 4 {
			end = end[:4]
		}
		switch {
		case end != "":
			years += "–" + end
		case a.LifeSpan.Ended:
			years += "–?"
		default:
			years += "–"
		}
	}
	return joinNonEmpty(" · ", a.Disambiguation, a.Type, place, years)
}

func joinNonEmpty(sep string, parts ...string) string {
	s := ""
	for _, p := range parts {
		if p == "" {
			continue
		}
		if s != "" {
			s += sep
		}
		s += p
	}
	return s
}

// artistLinkSection links an artist without a MusicBrainz ID. The
// MusicBrainz search only runs when the user asks for it.
templ artistLinkSection(a *audio.Artist) {
	<details>
		<summary class="cursor-pointer text-sm font-medium">Link to MusicBrainz</summary>
		<div class="mt-2 max-w-lg">
			@artistLinkButton(a, "")
		</div>
	</details>
}

// artistLinkButton loads the candidate panel that follows it. back is the
// page to return to after linking, "" for the artist's own page.
templ artistLinkButton(a *audio.Artist, back string) {
	<button
		type="button"
		class="btn"
		hx-get={ artistLinkURL(a, back) }
		hx-target="next [data-link-panel]"
		hx-disabled-elt="this"
	>Find on MusicBrainz</button>
	<div class="mt-2" data-link-panel aria-live="polite"></div>
}

func artistLinkURL(a *audio.Artist, back string) string {
	u := "/ui/artists/" + a.ID.String() + "/link"
	if back != "" {
		u += "?back=" + url.QueryEscape(back)
	}
	return u
}

// ArtistLinkCandidates is the panel of MusicBrainz candidates for an
// artist: pick one, paste an ID or URL, or give up.
templ ArtistLinkCandidates(a *audio.Artist, candidates []mb.Artist, searchErr string, back string) {
	<div
		class="card grid gap-3"
		hx-target="closest [data-link-panel]"
		hx-on::after-request="this.querySelector('[data-link-result]').textContent = event.detail.successful ? '' : (event.detail.xhr.responseText || 'Could not link.')"
	>
		for _, c := range candidates {
			@artistCandidate(c) {
				<button
					type="button"
					class="btn shrink-0"
					hx-post={ "/ui/artists/" + a.ID.String() + "/link" }
					hx-vals={ templ.JSONString(map[string]string{"mbid": c.ID, "back": back}) }
				>Link to this artist</button>
			}
		}
		if searchErr != "" {
			<p class="text-sm text-st-failed">{ searchErr }</p>
		} else if len(candidates) == 0 {
			<p class="text-sm text-fg-muted">MusicBrainz found no artist with that name.</p>
		}
		<form class="flex gap-2" hx-post={ "/ui/artists/" + a.ID.String() + "/link" }>
			<input type="hidden" name="back" value={ back }/>
			<div class="flex-1">
				@field("Or paste a MusicBrainz artist link or ID", "") {
					<input class="input" type="text" name="mbid_manual" placeholder="https://musicbrainz.org/artist/…" required/>
				}
			</div>
			<button class="btn shrink-0 self-end" type="submit">Link</button>
		</form>
		<div class="flex flex-wrap items-center gap-4">
			<button
				type="button"
				class="btn"
				onclick="this.closest('[data-link-panel]').innerHTML = ''; this.closest('details')?.removeAttribute('open')"
			>None of these</button>
			<span data-link-result class="text-sm text-st-failed empty:hidden" aria-live="polite"></span>
		</div>
	</div>
}

// ArtistLinkTaken answers a link to an ID that another artist has: merge
// into them instead. other is nil when the viewer can't see that artist.
templ ArtistLinkTaken(a *audio.Artist, other *audio.Artist) {
	<div class="card grid gap-3 text-sm">
		if other == nil {
			<p>Another artist already has that MusicBrainz ID.</p>
		} else {
			<p>
				<a href={ artistURL(other) }>{ other.Name }</a> already has that MusicBrainz ID.
				Merging moves { a.Name }'s tracks and releases to them.
			</p>
			<form
				hx-post={ "/ui/artists/" + a.ID.String() + "/merge" }
				hx-swap="none"
				hx-confirm={ "Merge " + a.Name + " into " + other.Name + "? Their tracks and releases move over and " + a.Name + " is deleted." }
				hx-on::after-request="this.querySelector('[data-link-result]').textContent = event.detail.successful ? '' : (event.detail.xhr.responseText || 'Could not merge.')"
			>
				<input type="hidden" name="into" value={ other.ID.String() }/>
				<button class="btn" type="submit">Merge into { other.Name }</button>
				<span data-link-result class="ml-2 text-sm text-st-failed empty:hidden" aria-live="polite"></span>
			</form>
		}
	</div>
}
