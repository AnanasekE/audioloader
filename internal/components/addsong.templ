package components

import (
	"fmt"
	"net/url"
	"time"

	"audioloader/internal/audio"
	"audioloader/internal/jobs"
	"audioloader/internal/sources/ytdlp"
)

// SongCandidate is a MusicBrainz recording offered for "Add a song".
type SongCandidate struct {
	RecordingID, Title, Artists             string
	Length                                  time.Duration
	ReleaseID, ReleaseTitle, Year, CoverURL string // the release it would go on; "" if none
	// set when the library has the song, or has it queued
	OwnedTrackID, OwnedReleaseID string
	OwnedHasFile                 bool
	Disc, Position               int // the track's place on its release; 0 when listed on its own
}

// SongRelease is the header above the tracks of a release listed from a
// MusicBrainz link.
type SongRelease struct {
	ID, Title, Artists, Year, CoverURL string
	Tracks, Missing                    int // Missing: how many the library doesn't have
}

// Owned reports whether the library already has the song.
func (c SongCandidate) Owned() bool { return c.OwnedTrackID != "" }

// AddPage is the one place to add things: a box that takes search text or
// a link and sends it where it belongs (see api.classifyAddInput), and the
// file upload forms below. A q fills the box and runs the lookup on load.
// recent lists the latest YouTube imports (normal mode).
templ AddPage(q string, artists []*audio.Artist, shows []*audio.Show, recent []jobs.Job) {
	@layout("Add", PageAdd) {
		@pageHead("Add", addSubtitle(secretMode(ctx), secretSourceOn(ctx)))
		if secretMode(ctx) && secretSourceOn(ctx) {
			<details class="mb-4">
				<summary class="mb-2 cursor-pointer text-sm font-medium">New creator</summary>
				@AddArtistForm()
			</details>
			<script src="/assets/js/secret-source.js" defer></script>
		}
		if !secretMode(ctx) || secretSourceOn(ctx) {
			<div
				id="add-box"
				hx-on::after-request="if (event.target.hasAttribute('hx-on::after-request')) return; document.getElementById('add-status').textContent = event.detail.successful ? '' : event.detail.xhr.responseText"
			>
				<form
					id="add-lookup"
					class="form-panel max-w-none! flex-row! flex-wrap items-center"
					hx-post="/ui/add/lookup"
					hx-target="#add-results"
					hx-indicator="#add-loading"
					if q != "" {
						hx-trigger="load, submit"
					}
				>
					<label for="add-q" class="sr-only">Search, or paste a link</label>
					<input
						id="add-q"
						class="input flex-1"
						type="text"
						name="q"
						value={ q }
						if secretMode(ctx) {
							placeholder="Paste a link"
							inputmode="url"
						} else {
							placeholder="Search, or paste a link"
						}
						autocomplete="off"
						required
					/>
					<button class="btn" type="submit">
						if secretMode(ctx) {
							Check
						} else {
							Go
						}
					</button>
					<span id="add-loading" class="htmx-indicator text-sm text-fg-muted">Looking…</span>
				</form>
				<p id="add-status" class="mt-4 text-sm text-st-failed empty:hidden" role="alert"></p>
				<div id="add-results" class="mt-6" aria-live="polite"></div>
			</div>
		}
		if len(recent) > 0 {
			<div class="mt-8">
				@RecentImports(recent)
			</div>
		}
		<div class="mt-8 flex items-center gap-3 text-sm text-fg-muted">
			<hr class="flex-1 border-line"/>
			<span>Or upload a file</span>
			<hr class="flex-1 border-line"/>
		</div>
		<div class="mt-4">
			@uploadForms(artists, shows)
		</div>
		<div class="mt-2 flex flex-wrap gap-2">
			<a class="btn btn-ghost" href="/upload/batch">Batch mode</a>
			<a class="btn btn-ghost" href="/upload/import">Import library</a>
		</div>
	}
}

func addSubtitle(secret, source bool) string {
	if secret && !source {
		return "Upload a file"
	}
	if secret {
		return "Paste a link, or upload a file"
	}
	return "Search MusicBrainz, paste a MusicBrainz, YouTube or YouTube Music link, or upload a file"
}

// SongCandidates lists MusicBrainz's best recordings for q. rel is set when
// the list is a release's tracks, found from a link instead of a search.
templ SongCandidates(q string, rel *SongRelease, found []SongCandidate) {
	<div class="text-fg">
		if rel != nil {
			<div class="mb-3 flex flex-wrap items-center gap-3">
				<img
					class="size-20 shrink-0 rounded bg-panel-2 object-cover"
					src={ rel.CoverURL }
					alt=""
					loading="lazy"
					onerror="this.onerror = null; this.src = '/assets/img/default_track.png'"
				/>
				<span class="min-w-0 flex-1">
					<span class="block truncate font-medium">{ rel.Title }</span>
					<span class="block truncate text-fg-muted">
						{ rel.Artists }
						if rel.Year != "" {
							{ " · " + rel.Year }
						}
						{ fmt.Sprintf(" · %d tracks", rel.Tracks) }
					</span>
				</span>
				if rel.Missing > 0 {
					<button
						type="button"
						class="btn"
						hx-post="/ui/add/musicbrainz/release"
						hx-vals={ fmt.Sprintf(`{"release_id": %q}`, rel.ID) }
						hx-target="#add-results"
					>{ fmt.Sprintf("Add all (%d)", rel.Missing) }</button>
				}
			</div>
		}
		if len(found) == 0 && rel != nil {
			<p class="text-fg-muted">This release has no tracks.</p>
		} else if len(found) == 0 {
			<p class="mb-3 text-fg-muted">MusicBrainz found nothing. Looking on YouTube…</p>
			<div hx-get={ "/ui/add/youtube?q=" + url.QueryEscape(q) } hx-trigger="load" hx-target="this" hx-swap="outerHTML"></div>
		} else {
			<ul class="divide-y divide-line">
				for _, c := range found {
					<li class="flex flex-wrap items-center gap-3 py-2">
						<img
							class="size-14 shrink-0 rounded bg-panel-2 object-cover"
							src={ c.CoverURL }
							alt=""
							loading="lazy"
							onerror="this.onerror = null; this.src = '/assets/img/default_track.png'"
						/>
						<span class="min-w-0 flex-1">
							<span class="block truncate">
								if c.Position > 0 {
									<span class="text-fg-muted">{ fmt.Sprintf("%d.%d ", c.Disc, c.Position) }</span>
								}
								{ c.Title }
							</span>
							<span class="block truncate text-fg-muted">
								{ c.Artists }
								if c.Length > 0 {
									{ " · " + formatDuration(c.Length) }
								}
							</span>
							if c.ReleaseTitle != "" {
								<span class="block truncate text-sm text-fg-muted">
									{ c.ReleaseTitle }
									if c.Year != "" {
										{ " · " + c.Year }
									}
								</span>
							}
						</span>
						if c.Owned() && c.OwnedHasFile {
							<a href={ templ.SafeURL("/releases/" + c.OwnedReleaseID) }>In your library</a>
						} else if c.Owned() {
							<a href="/downloads">Already queued</a>
						} else {
							<button
								type="button"
								class="btn"
								hx-post="/ui/add/musicbrainz"
								hx-vals={ fmt.Sprintf(`{"recording_id": %q, "release_id": %q}`, c.RecordingID, c.ReleaseID) }
							>Add</button>
						}
					</li>
				}
			</ul>
			if rel == nil {
				<button type="button" class="btn mt-2" hx-get={ "/ui/add/youtube?q=" + url.QueryEscape(q) } hx-target="#add-results">None of these</button>
			}
		}
	</div>
}

// SongYouTubeCandidates lists YouTube results for q. titles and artists are
// the guessed track title and artist of each result, for the person to
// correct; owned holds the link to the library's track when it has the video.
templ SongYouTubeCandidates(found []ytdlp.Entry, titles, artists, owned []string) {
	<div class="text-fg">
		if len(found) == 0 {
			<p class="text-fg-muted">YouTube found nothing.</p>
		} else {
			<p class="mb-2 text-sm text-fg-muted">The picked video becomes a single you can tag later.</p>
			@list() {
				for i, c := range found {
					@youTubeCandidate(c, 0) {
						if owned[i] != "" {
							<a href={ templ.SafeURL(owned[i]) }>In your library</a>
						} else {
							<details>
								<summary class="btn cursor-pointer">Use this</summary>
								<form class="mt-2 grid gap-2" hx-post="/ui/add/youtube">
									<input type="hidden" name="video_id" value={ c.ID }/>
									<input class="input" type="text" name="title" value={ titles[i] } aria-label="Title" required/>
									<input class="input" type="text" name="artist" value={ artists[i] } aria-label="Artist" required/>
									<button class="btn" type="submit">Add</button>
								</form>
							</details>
						}
					}
				}
			}
		}
	</div>
}
