package components

import (
	"context"

	"audioloader/internal/db"
)

templ VaultPage(wrong bool) {
	@layout("Vault", "") {
		@pageHeader("Vault", "") {
		}
		// a plain form: the unlock reloads the whole page
		<form method="post" action="/vault" hx-boost="false" class="card grid max-w-sm gap-4">
			<label for="vault-passphrase" class="text-sm font-medium">Passphrase</label>
			<input id="vault-passphrase" class="input" type="password" name="passphrase" autocomplete="current-password" required autofocus/>
			if wrong {
				<p class="text-sm text-red-600 dark:text-red-400">That's not it.</p>
			}
			<div>
				<button class="btn" type="submit">Unlock</button>
			</div>
		</form>
	}
}

// secretMode reports whether the request rendering this page unlocked the vault.
func secretMode(ctx context.Context) bool {
	return db.ViewerFrom(ctx).IsSecret()
}

type vaultEnabledKey struct{}

// WithVaultEnabled says whether the vault is configured, so pages know
// whether to offer moving tracks between the modes.
func WithVaultEnabled(ctx context.Context, on bool) context.Context {
	return context.WithValue(ctx, vaultEnabledKey{}, on)
}

func vaultEnabled(ctx context.Context) bool {
	on, _ := ctx.Value(vaultEnabledKey{}).(bool)
	return on
}

// modeName is "secret" or "normal", for the body's data-mode.
func modeName(ctx context.Context) string {
	if secretMode(ctx) {
		return "secret"
	}
	return "normal"
}
