package components

import (
	"fmt"

	"audioloader/internal/audio"
)

const PagePlaylists = "playlists"

templ PlaylistsPage(playlists []*audio.Playlist) {
	@layout("Playlists", PagePlaylists) {
		@pageHead("Playlists", plural(len(playlists), "playlist")) {
		}
		<form
			class="card mb-6 flex flex-wrap items-center gap-2"
			hx-post="/ui/playlists"
			hx-target="#playlist-result"
			hx-on::after-request="if (!event.detail.successful) document.getElementById('playlist-result').textContent = event.detail.xhr.responseText"
		>
			<label for="playlist-name" class="sr-only">Name</label>
			<input id="playlist-name" class="input flex-1" type="text" name="name" placeholder="New playlist name" required/>
			<button class="btn" type="submit">Create playlist</button>
			<span id="playlist-result" class="text-sm text-st-failed" aria-live="polite"></span>
		</form>
		if len(playlists) == 0 {
			@emptyState() {
				No playlists yet. Add tracks to one from a track's ⋯ menu.
			}
		} else {
			<div class="grid grid-cols-[repeat(auto-fill,minmax(10rem,1fr))] gap-4">
				for _, p := range playlists {
					<a class="card block hover:no-underline" href={ playlistURL(p) }>
						<img class="pixelated mb-2 aspect-square w-full rounded bg-panel-2 object-cover" src={ p.ImgURL } alt=""/>
						<strong class="block truncate text-fg">{ p.Name }</strong>
						<span class="font-mono text-xs text-fg-muted">{ plural(p.Count, "track") }</span>
					</a>
				}
			</div>
		}
	}
}

templ PlaylistPage(p *audio.Playlist) {
	@layout(p.Name, PagePlaylists) {
		<div class="mb-8 flex flex-col gap-6 sm:flex-row sm:items-end">
			<img class="pixelated size-40 shrink-0 rounded-lg bg-panel-2 object-cover min-[720px]:size-48" src={ p.ImgURL } alt=""/>
			<div class="min-w-0">
				<p class="text-xs font-semibold tracking-[0.06em] text-fg-subtle uppercase">Playlist</p>
				<h1 class="text-2xl font-semibold tracking-tight">{ p.Name }</h1>
				<p class="text-sm text-fg-muted">{ plural(p.Count, "track") } · { formatLongDuration(p.Duration) }</p>
				<div class="mt-4 flex flex-wrap gap-2">
					if p.Count > 0 {
						<button type="button" class="btn" data-play-list="playlist-tracks">Play</button>
						<button type="button" class="btn btn-ghost" data-play-list="playlist-tracks" data-shuffle>Shuffle</button>
					}
					<a class="btn btn-ghost" href={ templ.SafeURL(string(playlistURL(p)) + "/edit") }>Edit playlist</a>
				</div>
			</div>
		</div>
		if p.Count == 0 {
			@emptyState() {
				Empty. Add tracks from a track's ⋯ menu.
			}
		} else {
			<ol id="playlist-tracks" class="flex flex-col" data-track-list>
				for _, t := range p.Tracks {
					<li>
						@Track(t)
					</li>
				}
			</ol>
		}
	}
}

templ PlaylistEditPage(p *audio.Playlist) {
	@layout("Edit "+p.Name, PagePlaylists) {
		@pageHead("Edit playlist", p.Name) {
			<a class="btn btn-ghost" href={ playlistURL(p) }>Cancel</a>
		}
		<form
			class="card mb-6 flex flex-wrap items-center gap-2"
			hx-post={ "/ui/playlists/" + p.ID.String() + "/rename" }
			hx-target="#playlist-rename-result"
		>
			<label for="playlist-name" class="text-xs font-medium text-fg-muted">Name</label>
			<input id="playlist-name" class="input flex-1" type="text" name="name" value={ p.Name } required/>
			<button class="btn" type="submit">Rename</button>
			<span id="playlist-rename-result" class="text-sm"></span>
		</form>
		<form
			id="playlist-edit"
			class="card"
			hx-post={ "/ui/playlists/" + p.ID.String() + "/tracks" }
			hx-target="#playlist-edit-result"
			hx-on::after-request="if (!event.detail.successful) document.getElementById('playlist-edit-result').textContent = event.detail.xhr.responseText || 'Could not save.'"
		>
			<ol id="playlist-edit-rows" class="divide-y divide-line">
				for _, t := range p.Tracks {
					<li class="playlist-edit-row grid grid-cols-[2rem_1fr_auto] items-center gap-3 py-2">
						<input type="hidden" name="track_id" value={ t.ID.String() }/>
						<span class="text-right text-sm text-fg-muted tabular-nums" data-number></span>
						<div class="min-w-0">
							<strong class="block truncate">{ t.Title }</strong>
							<span class="block truncate text-sm text-fg-muted">{ artistNames(t.Artists) }</span>
						</div>
						<div class="flex gap-1">
							<button type="button" class="btn px-2.5" data-action="up" aria-label="Move up">↑</button>
							<button type="button" class="btn px-2.5" data-action="down" aria-label="Move down">↓</button>
							<button type="button" class="btn px-2.5" data-action="remove" aria-label="Remove from playlist">✕</button>
						</div>
					</li>
				}
			</ol>
			<p class="py-4 text-sm text-fg-muted" data-edit-empty hidden?={ len(p.Tracks) > 0 }>No tracks.</p>
			<div class="mt-6 flex items-center gap-4">
				<button type="submit" class="btn">Save order</button>
				<span id="playlist-edit-result" class="text-sm text-st-failed" aria-live="polite"></span>
			</div>
		</form>
		<section class="card mt-8">
			<button
				type="button"
				class="btn"
				hx-post={ "/ui/playlists/" + p.ID.String() + "/delete" }
				hx-confirm={ "Delete the playlist " + p.Name + "? Its tracks stay in your library." }
			>Delete playlist</button>
		</section>
		<script src="/assets/js/playlist-edit.js" defer></script>
	}
}

// PlaylistPicker lists playlists to add a track to, inside a track's menu.
templ PlaylistPicker(trackID string, playlists []*audio.Playlist) {
	<div class="mt-1 grid border-t border-line pt-1">
		if len(playlists) == 0 {
			<a class="px-2 py-1" href="/playlists">Create a playlist first</a>
		}
		for _, p := range playlists {
			<button
				type="button"
				class="truncate rounded px-2 py-1 text-left hover:bg-panel-2"
				hx-post={ "/ui/playlists/" + p.ID.String() + "/tracks/add" }
				hx-vals={ fmt.Sprintf(`{"track_id": %q}`, trackID) }
				hx-swap="outerHTML"
			>{ p.Name }</button>
		}
	</div>
}

func playlistURL(p *audio.Playlist) templ.SafeURL {
	return templ.SafeURL("/playlists/" + p.ID.String())
}
