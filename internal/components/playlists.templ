package components

import (
	"fmt"

	"audioloader/internal/audio"
)

const PagePlaylists = "playlists"

templ PlaylistsPage(playlists []*audio.Playlist) {
	@layout("Playlists", PagePlaylists) {
		@pageHead("Playlists", plural(len(playlists), "playlist")) {
			@popover("New playlist") {
				<form
					class="flex flex-wrap items-center gap-2"
					hx-post="/ui/playlists"
					hx-target="#playlist-result"
					hx-on::after-request="if (!event.detail.successful) document.getElementById('playlist-result').textContent = event.detail.xhr.responseText"
				>
					<label for="playlist-name" class="sr-only">Name</label>
					<input id="playlist-name" class="input min-w-0 flex-1" type="text" name="name" placeholder="New playlist name" required/>
					<button class="btn" type="submit">Create playlist</button>
					<span id="playlist-result" class="w-full text-sm text-st-failed empty:hidden" aria-live="polite"></span>
				</form>
			}
		}
		if len(playlists) == 0 {
			@emptyState() {
				No playlists yet. Add tracks to one from a track's @iconClass("more", "inline size-4 align-text-bottom") menu.
			}
		} else {
			@cardGrid() {
				for _, p := range playlists {
					@tileWithMenu("") {
						@card(p.ImgURL, p.Name, plural(p.Count, "track")+" · "+formatLongDuration(p.Duration), string(playlistURL(p)))
						@playlistMenu(p, "card")
					}
				}
			}
		}
	}
}

templ PlaylistPage(p *audio.Playlist) {
	@layout(p.Name, PagePlaylists) {
		@mediaHeader(p.ImgURL, "Playlist", p.Name, nil, plural(p.Count, "track")+" · "+formatLongDuration(p.Duration)) {
			if p.Count > 0 {
				<button type="button" class="btn" data-play-list="playlist-tracks">Play</button>
				<button type="button" class="btn btn-ghost" data-play-list="playlist-tracks" data-shuffle>Shuffle</button>
			}
			<a class="btn btn-ghost" href={ templ.SafeURL(string(playlistURL(p)) + "/edit") }>Edit playlist</a>
			@playlistMenu(p, "head")
		}
		if p.Count == 0 {
			@emptyState() {
				Empty. Add tracks from a track's @iconClass("more", "inline size-4 align-text-bottom") menu.
			}
		} else {
			<div id="playlist-tracks" class="list" data-track-list data-filter-rows>
				@listHead("row-track", "#", "", "Title", trackAlbumHead(ctx), ">Time", "")
				for i, t := range p.Tracks {
					@trackRow(t, nil, i+1)
				}
			</div>
		}
	}
}

// playlistMenu is the ⋯ menu of a playlist, on its card and in its header.
templ playlistMenu(p *audio.Playlist, where string) {
	@ctxMenu(where, "More for "+p.Name) {
		@sourceItems("playlists/"+p.ID.String(), "Play", true)
		<a class="menu-item" href={ templ.SafeURL(string(playlistURL(p)) + "/edit") }>Edit</a>
		<button
			type="button"
			class="menu-item"
			hx-post={ "/ui/playlists/" + p.ID.String() + "/delete" }
			hx-confirm={ "Delete the playlist " + p.Name + "? Its tracks stay in your library." }
		>Delete…</button>
	}
}

templ PlaylistEditPage(p *audio.Playlist) {
	@layout("Edit "+p.Name, PagePlaylists) {
		@pageHead("Edit playlist", p.Name) {
			<a class="btn btn-ghost" href={ playlistURL(p) }>Cancel</a>
		}
		<div class="mb-6">
			@formPanel() {
				<form
					class="flex flex-wrap items-end gap-2"
					hx-post={ "/ui/playlists/" + p.ID.String() + "/rename" }
					hx-target="#playlist-rename-result"
				>
					<div class="min-w-0 flex-1">
						@field("Name", "") {
							<input id="playlist-name" class="input" type="text" name="name" value={ p.Name } required/>
						}
					</div>
					<button class="btn" type="submit">Rename</button>
					<span id="playlist-rename-result" class="w-full text-sm"></span>
				</form>
			}
		</div>
		<form
			id="playlist-edit"
			hx-post={ "/ui/playlists/" + p.ID.String() + "/tracks" }
			hx-target="#playlist-edit-result"
			hx-on::after-request="if (!event.detail.successful) document.getElementById('playlist-edit-result').textContent = event.detail.xhr.responseText || 'Could not save.'"
		>
			@sectionLabel("Tracks")
			<div id="playlist-edit-rows" class="list">
				for _, t := range p.Tracks {
					<div class="row row-edit playlist-edit-row">
						<input type="hidden" name="track_id" value={ t.ID.String() }/>
						<span class="mono text-right text-fg-muted" data-number></span>
						<span class="stack">
							<b>{ t.Title }</b>
							<span>{ artistNames(t.Artists) }</span>
						</span>
						<div class="flex gap-1">
							<button type="button" class="btn btn-ghost px-2.5" data-action="up" aria-label="Move up">@icon("arrow-up")</button>
							<button type="button" class="btn btn-ghost px-2.5" data-action="down" aria-label="Move down">@icon("arrow-down")</button>
							<button type="button" class="btn btn-ghost px-2.5" data-action="remove" aria-label="Remove from playlist">@icon("x")</button>
						</div>
					</div>
				}
			</div>
			<p class="py-4 text-sm text-fg-muted" data-edit-empty hidden?={ len(p.Tracks) > 0 }>No tracks.</p>
			<div class="mt-4 flex items-center gap-4">
				<button type="submit" class="btn">Save order</button>
				<span id="playlist-edit-result" class="text-sm text-st-failed" aria-live="polite"></span>
			</div>
		</form>
		<div class="mt-10">
			<button
				type="button"
				class="btn btn-danger"
				hx-post={ "/ui/playlists/" + p.ID.String() + "/delete" }
				hx-confirm={ "Delete the playlist " + p.Name + "? Its tracks stay in your library." }
			>Delete playlist</button>
		</div>
		<script src="/assets/js/playlist-edit.js" defer></script>
	}
}

// PlaylistPicker lists playlists to add a track to, inside a track's menu.
templ PlaylistPicker(trackID string, playlists []*audio.Playlist) {
	<div class="mt-1 grid border-t border-line pt-1">
		if len(playlists) == 0 {
			<a class="px-2 py-1" href="/playlists">Create a playlist first</a>
		}
		for _, p := range playlists {
			<button
				type="button"
				class="truncate rounded px-2 py-1 text-left hover:bg-panel-2"
				hx-post={ "/ui/playlists/" + p.ID.String() + "/tracks/add" }
				hx-vals={ fmt.Sprintf(`{"track_id": %q}`, trackID) }
				hx-swap="outerHTML"
			>{ p.Name }</button>
		}
	</div>
}

func playlistURL(p *audio.Playlist) templ.SafeURL {
	return templ.SafeURL("/playlists/" + p.ID.String())
}
