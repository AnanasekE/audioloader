package components

// DevKitPage shows every kit component in both themes. It is served on
// loopback only, at /dev/kit, and goes away in plan 18 step 12.
templ DevKitPage() {
	@layout("Kit", "") {
		@kitDemo("dark")
		@kitDemo("light")
	}
}

templ kitDemo(theme string) {
	<section data-theme={ theme } class="mb-8 rounded-lg bg-bg p-4 text-fg">
		<p class="section-label">{ theme } theme</p>
		@pageHead("Page head", "12 in library") {
			@filterInput("Filter tracks")
			<a class="btn btn-ghost" href="#">Secondary</a>
			<a class="btn" href="#">Primary</a>
			<a class="btn btn-danger" href="#">Delete</a>
		}
		@sectionLabel("Disc 1")
		@list() {
			@listHead("row-track", "#", "", "Title", "Album", ">Time", "")
			@row("row-track") {
				<button type="button" class="play" aria-pressed="true" data-bare><span class="n">01</span><span class="go">▶</span>@eqBars()</button>
				@cover("/assets/img/default_track.png", 28)
				<span class="stack"><b>Playing track</b><span>Artist name</span></span>
				<span class="truncate text-fg-muted">Album name</span>
				<span class="mono text-right text-fg-muted">3:34</span>
				<span></span>
			}
			@row("row-track") {
				<button type="button" class="play" aria-pressed="false" data-bare><span class="n">02</span><span class="go">▶</span>@eqBars()</button>
				@cover("/assets/img/default_track.png", 28)
				<span class="stack"><b>Other track</b><span>Artist name</span></span>
				<span class="flex gap-1.5">@chip("single")@chipAccent("matched")</span>
				<span class="mono text-right text-fg-muted">4:07</span>
				<span></span>
			}
			@row("row-track is-missing") {
				<span class="mono text-fg-muted">03</span>
				@cover("/assets/img/default_track.png", 28)
				<span class="stack"><b>Missing track</b><span>Artist name</span></span>
				<span>@chip("missing")</span>
				<span class="mono text-right text-fg-muted">3:08</span>
				<span></span>
			}
			@rowBar(false) {
				<span class="section-label p-0">Total length</span>
				<span class="mono">10:49</span>
			}
		}
		<div class="mt-6 flex flex-wrap gap-2">
			@statusChip("queued", "queued")
			@statusChip("running", "running")
			@statusChip("done", "done")
			@statusChip("failed", "failed")
			@statusChip("review", "review")
			@chipKind("Album")
		</div>
		<div class="mt-6 max-w-sm">
			@progress(42)
		</div>
		<div class="mt-6 flex flex-wrap items-center gap-4">
			@segmented("Sort", []SegOption{{Label: "Title", Href: "#", On: true}, {Label: "Artist", Href: "#"}, {Label: "Added", Href: "#"}})
			@cover("/assets/img/default_track.png", 48)
			@avatar("/assets/img/default_pfp.png", 48)
		</div>
		<div class="mt-6">
			@mediaHeader("/assets/img/default_track.png", "Album", "Release title", plain("Artist name"), "2024 · 12 tracks · 48:10") {
				<a class="btn" href="#">Play</a>
				<a class="btn btn-ghost" href="#">Shuffle</a>
			}
		</div>
		<div class="mt-6">
			@cardGrid() {
				@card("/assets/img/default_track.png", "A playlist", "38 tracks · 2h 29m", "#")
				@avatarCard("/assets/img/default_pfp.png", "An artist", "4 releases", "#")
			}
		</div>
		<div class="mt-6">
			@formPanel() {
				@field("Title", "Shown in the list") {
					<input class="input" value="Some title"/>
				}
				@field("Kind", "") {
					<select class="select"><option>Album</option><option>EP</option></select>
				}
				<div class="flex flex-wrap gap-2">
					@choice("kind-"+theme, "album", "Album", true, false)
					@choice("kind-"+theme, "ep", "EP", false, false)
					@choice("kind-"+theme, "single", "Single", false, false)
				</div>
				<div class="flex gap-2">
					<button class="btn" type="button">Save</button>
					<button class="btn btn-ghost" type="button">Cancel</button>
				</div>
			}
		</div>
		<div class="mt-6 max-w-xs">
			<div class="pop grid">
				<span class="menu-item">Play next</span>
				<span class="menu-item">Add to queue</span>
				<span class="menu-item">Edit</span>
			</div>
		</div>
		<div class="mt-6">
			@emptyState() {
				Nothing here yet.
			}
		</div>
	</section>
}
