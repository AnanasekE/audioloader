package components

import (
	"fmt"

	"audioloader/internal/audio"
)

const PageShows = "shows"

templ ShowsPage(shows []*audio.Show, continueListening []*audio.Track) {
	@layout("Podcasts", PageShows) {
		@pageHead("Podcasts", plural(len(shows), "show")) {
			<a class="btn" href="/add#episode">Upload episode</a>
		}
		@ContinueListening(continueListening)
		if len(shows) == 0 {
			@emptyState() {
				No podcasts yet. Upload an episode to start one.
			}
		} else {
			@sectionLabel("Shows")
			@cardGrid() {
				for _, s := range shows {
					@card(s.ImgURL, s.Title, showCounts(s), string(showURL(s.ID.String())))
				}
			}
		}
	}
}

func showCounts(s *audio.Show) string {
	out := plural(s.Count, "episode")
	if s.Unplayed > 0 {
		out += fmt.Sprintf(" · %d unplayed", s.Unplayed)
	}
	return out
}

// ContinueListening lists the episodes that were started but not finished.
templ ContinueListening(tracks []*audio.Track) {
	if len(tracks) > 0 {
		<section class="mb-8">
			@sectionLabel("Continue listening")
			@list() {
				for _, t := range tracks {
					@episodeRow(t, false)
				}
			}
		</section>
	}
}

templ ShowPage(s *audio.Show) {
	@layout(s.Title, PageShows) {
		@mediaHeader(s.ImgURL, "Podcast", s.Title, showAuthor(s.Author), showCounts(s))
		if len(s.Episodes) == 0 {
			@emptyState() {
				No episodes yet.
			}
		} else {
			// not a [data-track-list]: an episode plays on its own, it doesn't queue the rest
			@list() {
				for _, t := range s.Episodes {
					@episodeRow(t, true)
				}
			}
		}
	}
}

func showAuthor(author string) templ.Component {
	if author == "" {
		return nil
	}
	return plain(author)
}

// episodeRow is an episode: play button, title over its date, a progress
// bar, the time left (or "Played"). With mark set it ends in the button
// that marks it played or unplayed.
templ episodeRow(t *audio.Track, mark bool) {
	<article class={ "row row-ep", templ.KV("is-done", t.Finished) } data-track-row>
		@playButton(t, "size-8")
		<div class="stack">
			<b>
				if t.ShowID != "" && !mark {
					<a class="text-fg" href={ showURL(t.ShowID) }>{ t.Title }</a>
				} else {
					{ t.Title }
				}
			</b>
			<span>{ joinDot([]string{t.Published, formatDuration(t.Duration)}) }</span>
		</div>
		<div class="ep-bar">
			@progress(episodePct(t))
		</div>
		<span class="mono text-right text-fg-muted">{ episodeLeft(t) }</span>
		if mark {
			if t.Finished || t.Position > 0 {
				<button class="btn btn-ghost ep-mark text-sm" hx-post={ "/ui/tracks/" + t.ID.String() + "/unplayed" }>Mark unplayed</button>
			} else {
				<button class="btn btn-ghost ep-mark text-sm" hx-post={ "/ui/tracks/" + t.ID.String() + "/played" }>Mark played</button>
			}
		}
	</article>
}

func episodePct(t *audio.Track) int {
	switch {
	case t.Finished:
		return 100
	case t.Position > 0 && t.Duration > 0:
		return int(100 * t.Position / t.Duration)
	}
	return 0
}

func episodeLeft(t *audio.Track) string {
	switch {
	case t.Finished:
		return "Played"
	case t.Position > 0 && t.Duration > t.Position:
		return "-" + formatDuration(t.Duration-t.Position)
	}
	return formatDuration(t.Duration)
}

func showURL(id string) templ.SafeURL {
	return templ.SafeURL("/shows/" + id)
}

// EpisodeForm uploads a podcast episode into a show, new or existing.
templ EpisodeForm(shows []*audio.Show) {
	<section class="card">
		<form
			id="episode-form"
			class="grid max-w-lg gap-4"
			hx-post="/ui/episodes"
			hx-encoding="multipart/form-data"
			hx-target="#result-episode"
			hx-on::after-request="
				if (event.detail.successful) this.reset();
				else document.getElementById('result-episode').textContent = event.detail.xhr.responseText || 'Upload failed.';
			"
		>
			<div>
				<label for="episode-title" class="mb-1 block text-xs font-medium text-fg-muted">Episode title</label>
				<input id="episode-title" class="input" type="text" name="title" required/>
			</div>
			<div class="grid grid-cols-2 gap-4">
				<div>
					<label for="episode-show" class="mb-1 block text-xs font-medium text-fg-muted">Show</label>
					<select id="episode-show" class="input" name="show_id">
						<option value="">New show…</option>
						for i, s := range shows {
							<option value={ s.ID.String() } selected?={ i == 0 }>{ s.Title }</option>
						}
					</select>
				</div>
				<div>
					<label for="episode-show-name" class="mb-1 block text-xs font-medium text-fg-muted">New show name</label>
					<input id="episode-show-name" class="input" type="text" name="show_name" placeholder="Only for a new show"/>
				</div>
			</div>
			<div>
				<label for="episode-date" class="mb-1 block text-xs font-medium text-fg-muted">Published <span class="font-normal text-fg-muted">(optional)</span></label>
				<input
					id="episode-date"
					class="input"
					type="text"
					name="published"
					placeholder="YYYY-MM-DD"
					pattern="\d{4}(-\d{2}(-\d{2})?)?"
					title="YYYY, YYYY-MM or YYYY-MM-DD"
				/>
			</div>
			<div>
				<label for="episode-file" class="mb-1 block text-xs font-medium text-fg-muted">Audio file</label>
				<input
					id="episode-file"
					class="input file:mr-3 file:rounded file:border-0 file:bg-panel file:px-2 file:py-1 file:text-sm"
					type="file"
					name="track"
					required
					accept={ audioAccept }
				/>
			</div>
			<div>
				<button class="btn" type="submit">Upload episode</button>
			</div>
		</form>
		<div id="result-episode" class="mt-4 text-sm" aria-live="polite"></div>
	</section>
}
