package components

import (
	"context"

	"audioloader/internal/audio"
)

// ImportPage imports a whole folder: import.js reads the files' tags in the
// browser, proposes releases, and uploads only after the review is confirmed.
templ ImportPage(artists []*audio.Artist) {
	@layout("Import library", PageUpload) {
		@pageHeader("Import library", importSubtitle(ctx)) {
			<a class="btn btn-ghost" href="/upload">Single upload</a>
		}
		<section id="import" class="card">
			<input id="import-folder" class="hidden" type="file" webkitdirectory multiple/>
			<input id="import-files" class="hidden" type="file" multiple accept={ audioAccept }/>
			<div id="import-start" class="grid max-w-lg gap-4">
				<div>
					<label for="import-creator" class="mb-1 block text-xs font-medium text-fg-muted">Creator <span class="font-normal text-fg-muted">(used where the tags name no artist)</span></label>
					<input id="import-creator" class="input" type="text" list="import-artist-list" placeholder="e.g. CerberVT" autocomplete="off"/>
					<datalist id="import-artist-list">
						for _, a := range artists {
							<option value={ a.Name }></option>
						}
					</datalist>
				</div>
				<div class="flex flex-wrap gap-2">
					<button type="button" class="btn btn-ghost" data-action="pick-folder">Choose folder</button>
					<button type="button" class="btn btn-ghost" data-action="pick-files">Choose files</button>
				</div>
				<p id="import-progress" class="text-sm text-fg-muted empty:hidden" aria-live="polite"></p>
			</div>
			<div id="import-review" hidden>
				<p id="import-summary" class="mb-4 text-sm"></p>
				<div class="sticky top-0 z-10 -mx-5 mb-4 flex flex-wrap items-center gap-2 border-b border-line bg-panel-2 px-5 py-3">
					<span id="import-selected" class="text-sm text-fg-muted">Select tracks to regroup them</span>
					// secret mode has no releases to group into; import.js still wants the controls
					<span class={ templ.KV("contents", !secretMode(ctx)), templ.KV("hidden", secretMode(ctx)) }>
						<button type="button" class="btn btn-ghost" data-action="group-selected" disabled>Group into release</button>
						<select id="import-move" class="input w-auto max-w-64" aria-label="Move selected tracks to a release" disabled>
							<option value="">Move to release…</option>
						</select>
						<button type="button" class="btn btn-ghost" data-action="singles-selected" disabled>Make singles</button>
					</span>
					<button type="button" class="btn btn-ghost" data-action="remove-selected" disabled>Remove</button>
				</div>
				<section class="mb-6 rounded-lg border border-line bg-panel p-4">
					<div class="mb-1 flex flex-wrap items-center justify-between gap-2">
						<h2 class="text-lg font-semibold">Artists <span id="import-artists-count" class="text-sm font-normal text-fg-muted"></span></h2>
						<button type="button" class="btn" data-action="add-all-artists">Add all new</button>
					</div>
					<p class="mb-3 text-sm text-fg-muted">
						New artists are also created when you import. Edit a name to change it everywhere, or type an existing artist's name to use that artist.
					</p>
					<ul id="import-artist-rows" class="divide-y divide-line"></ul>
					<div class="mt-3 flex gap-2 border-t border-line pt-3">
						<label for="import-new-artist" class="sr-only">New artist name</label>
						<input id="import-new-artist" class="input" type="text" placeholder="New artist name" autocomplete="off"/>
						<button type="button" class="btn shrink-0" data-action="add-artist">Add artist</button>
					</div>
					<p id="import-artist-status" class="mt-2 text-sm text-st-failed empty:hidden" aria-live="polite"></p>
				</section>
				<div id="import-groups"></div>
				<section id="import-singles-section">
					<h2 class="mt-6 mb-2 text-lg font-semibold">
						if secretMode(ctx) {
							Tracks
						} else {
							Singles
						}
						<span id="import-singles-count" class="text-sm font-normal text-fg-muted"></span>
					</h2>
					if !secretMode(ctx) {
						<p class="mb-2 text-sm text-fg-muted">Each track here becomes its own single.</p>
					}
					<ol id="import-singles" class="divide-y divide-line"></ol>
				</section>
				<section id="import-episodes-section" hidden>
					<h2 class="mt-6 mb-2 text-lg font-semibold">Podcast episodes <span id="import-episodes-count" class="text-sm font-normal text-fg-muted"></span></h2>
					<p class="mb-2 text-sm text-fg-muted">Tagged as podcasts. Each goes into the show named by its album tag.</p>
					<ol id="import-episodes" class="divide-y divide-line"></ol>
				</section>
				<div class="mt-6 flex flex-wrap items-center gap-4 border-t border-line pt-4">
					<button type="button" class="btn btn-ghost" data-action="pick-files">Add more files</button>
					<p id="import-result" class="flex-1 text-sm" aria-live="polite"></p>
					<button type="button" class="btn" data-action="import">Import everything</button>
				</div>
			</div>
			<template id="import-group-template">
				@importGroup()
			</template>
			<template id="import-row-template">
				@importRow()
			</template>
			<template id="import-single-template">
				@importSingle()
			</template>
			<template id="import-artist-template">
				@importArtist()
			</template>
			<template id="import-artist-option-template">
				@importArtistOption()
			</template>
		</section>
		<script src="/assets/js/artist-picker.js" defer></script>
		<script src="/assets/js/track-hash.js" defer></script>
		<script src="/assets/js/tags.js" defer></script>
		<script src="/assets/js/import.js" defer></script>
	}
}

// importGroup is one proposed release in the review.
templ importGroup() {
	<section class="import-group mb-4 rounded-lg border border-line bg-panel p-4">
		<div class="mb-3 grid items-end gap-3 md:grid-cols-[minmax(0,1fr)_auto_7rem_auto]">
			<label class="text-xs font-medium text-fg-muted">
				Release title
				<input class="input mt-1" type="text" data-field="title" required/>
			</label>
			<div>
				<span class="mb-1 block text-sm font-medium">
					Type <span class="font-normal text-fg-muted" data-type-source></span>
				</span>
				<div class="flex overflow-hidden rounded-md border border-line" role="group" aria-label="Release type">
					for _, typ := range audio.ReleaseTypes {
						<button
							type="button"
							class="border-r border-line px-2.5 py-2 text-sm last:border-r-0 aria-pressed:bg-accent-dim aria-pressed:text-accent"
							aria-pressed="false"
							data-type={ string(typ) }
						>{ typ.Label() }</button>
					}
				</div>
			</div>
			<label class="text-xs font-medium text-fg-muted">
				Date
				<input class="input mt-1" type="text" data-field="date" placeholder="YYYY" pattern="\d{4}(-\d{2}(-\d{2})?)?"/>
			</label>
			<div class="flex gap-1">
				<button type="button" class="btn btn-ghost" data-action="split">Split into singles</button>
				<button type="button" class="btn px-2.5" data-action="remove-group" aria-label="Remove release from import">✕</button>
			</div>
		</div>
		<div class="mb-2 flex items-center gap-2 text-sm">
			<span class="shrink-0 font-medium">Release artists</span>
			<div class="w-full max-w-md">
				@importArtistPicker()
			</div>
		</div>
		<p class="mb-2 text-sm text-st-failed empty:hidden" data-group-status></p>
		<ol class="divide-y divide-line" data-rows></ol>
	</section>
}

const importRowCols = "grid-cols-[auto_2rem_3.5rem_minmax(0,1fr)] md:grid-cols-[auto_2rem_3.5rem_minmax(0,1fr)_minmax(0,14rem)_minmax(0,12rem)]"

// importRow is a track inside a proposed release.
templ importRow() {
	<li class={ "import-row grid items-center gap-2 py-1.5", importRowCols }>
		<input type="checkbox" data-select aria-label="Select track"/>
		<span class="text-right text-sm text-fg-muted tabular-nums" data-number></span>
		<input class="input px-1.5" type="number" min="1" data-field="disc" aria-label="Disc" title="Disc"/>
		<input class="input" type="text" data-field="title" aria-label="Title" required/>
		@importArtistPicker()
		<span class="truncate text-xs text-fg-muted" data-file></span>
		<span class="col-span-full text-sm empty:hidden data-[state=done]:text-st-done data-[state=error]:text-st-failed data-[state=exists]:text-st-review data-[state=link]:text-accent data-[state=pending]:text-fg-muted" data-status></span>
	</li>
}

// importArtist is one detected artist name in the review's artist list.
templ importArtist() {
	<li class="import-artist grid grid-cols-[minmax(0,1fr)_auto_auto_auto] items-center gap-2 py-1.5">
		<input class="input" type="text" list="import-artist-list" data-artist-name aria-label="Artist name" autocomplete="off"/>
		<span class="text-sm text-fg-muted tabular-nums" data-count></span>
		<span class="rounded px-2 py-0.5 text-xs font-medium data-[state=known]:bg-panel-2 data-[state=known]:text-st-done data-[state=new]:bg-panel-2 data-[state=new]:text-st-review/40/40" data-badge></span>
		<button type="button" class="btn" data-action="add-detected">Add</button>
	</li>
}

// importArtistPicker looks and behaves like artistPicker (artist-picker.js
// does the summary, search and closing), but import.js fills its options when
// it opens: library artists plus names detected in the files, which may not
// exist yet. Values are artist names, resolved to IDs at import.
templ importArtistPicker() {
	<details class="relative" data-artist-picker data-import-picker>
		<summary class="input cursor-pointer list-none truncate" data-artist-summary>Select artists</summary>
		<div class="absolute z-20 mt-1 w-full min-w-56 rounded-md border border-line bg-panel p-2 shadow-(--shadow-pop)">
			<input type="search" class="input mb-2" placeholder="Search artists…" aria-label="Search artists" autocomplete="off" data-artist-search/>
			<div class="max-h-60 overflow-auto" data-artist-options></div>
			<p class="px-1 py-1 text-sm text-fg-muted" hidden data-artist-empty>No matching artists.</p>
			<button type="button" class="mt-1 w-full rounded px-1 py-1 text-left text-sm text-accent hover:bg-panel-2" hidden data-action="picker-add"></button>
		</div>
	</details>
}

// importArtistOption is cloned by import.js for each name in an import picker.
templ importArtistOption() {
	<label class="flex cursor-pointer items-center gap-2 rounded px-1 py-1 text-sm hover:bg-panel-2">
		<input type="checkbox" name="artist_id"/>
		<span data-option-name></span>
		<span class="text-xs text-st-review" hidden data-option-new>new</span>
	</label>
}

const importSingleCols = "grid-cols-[auto_minmax(0,1fr)] md:grid-cols-[auto_minmax(0,1fr)_minmax(0,14rem)_7rem_minmax(0,12rem)]"

// no date column in secret mode
const importSingleColsSecret = "grid-cols-[auto_minmax(0,1fr)] md:grid-cols-[auto_minmax(0,1fr)_minmax(0,14rem)_minmax(0,12rem)]"

func importSingleColsFor(ctx context.Context) string {
	if secretMode(ctx) {
		return importSingleColsSecret
	}
	return importSingleCols
}

// importSingle is a track that becomes its own single.
templ importSingle() {
	<li class={ "import-row grid items-center gap-2 py-1.5", importSingleColsFor(ctx) }>
		<input type="checkbox" data-select aria-label="Select track"/>
		<input class="input" type="text" data-field="title" aria-label="Title" required/>
		@importArtistPicker()
		// the single's release date; secret tracks have no release
		<input class={ "input", templ.KV("hidden", secretMode(ctx)) } type="text" data-field="date" aria-label="Release date" placeholder="YYYY" pattern="\d{4}(-\d{2}(-\d{2})?)?"/>
		<span class="truncate text-xs text-fg-muted" data-file></span>
		<span class="col-span-full text-sm empty:hidden data-[state=done]:text-st-done data-[state=error]:text-st-failed data-[state=exists]:text-st-review data-[state=pending]:text-fg-muted" data-status></span>
	</li>
}

func importSubtitle(ctx context.Context) string {
	if secretMode(ctx) {
		return "Each file becomes a secret track; nothing uploads until you confirm"
	}
	return "Releases are recognised from the files' tags; nothing uploads until you confirm"
}
