package components

import "audioloader/internal/audio"

// ImportPage imports a whole folder: import.js reads the files' tags in the
// browser, proposes releases, and uploads only after the review is confirmed.
templ ImportPage(artists []*audio.Artist) {
	@layout("Import library", PageUpload) {
		@pageHeader("Import library", "Releases are recognised from the files' tags; nothing uploads until you confirm") {
			<a class="btn" href="/upload">Single upload</a>
		}
		<section id="import" class="card">
			<input id="import-folder" class="hidden" type="file" webkitdirectory multiple/>
			<input id="import-files" class="hidden" type="file" multiple accept={ audioAccept }/>
			<div id="import-start" class="grid max-w-lg gap-4">
				<div>
					<label for="import-creator" class="mb-1 block text-sm font-medium">Creator <span class="font-normal text-zinc-500">(used where the tags name no artist)</span></label>
					<input id="import-creator" class="input" type="text" list="import-artist-list" placeholder="e.g. CerberVT" autocomplete="off"/>
					<datalist id="import-artist-list">
						for _, a := range artists {
							<option value={ a.Name }></option>
						}
					</datalist>
				</div>
				<div class="flex flex-wrap gap-2">
					<button type="button" class="btn" data-action="pick-folder">Choose folder</button>
					<button type="button" class="btn" data-action="pick-files">Choose files</button>
				</div>
				<p id="import-progress" class="text-sm text-zinc-500 empty:hidden dark:text-zinc-400" aria-live="polite"></p>
			</div>
			<div id="import-review" hidden>
				<p id="import-summary" class="mb-4 text-sm"></p>
				<div class="sticky top-0 z-10 -mx-5 mb-4 flex flex-wrap items-center gap-2 border-b border-zinc-200 bg-zinc-100 px-5 py-3 dark:border-zinc-700 dark:bg-zinc-800">
					<span id="import-selected" class="text-sm text-zinc-500 dark:text-zinc-400">Select tracks to regroup them</span>
					<button type="button" class="btn" data-action="group-selected" disabled>Group into release</button>
					<select id="import-move" class="input w-auto max-w-64" aria-label="Move selected tracks to a release" disabled>
						<option value="">Move to release…</option>
					</select>
					<button type="button" class="btn" data-action="singles-selected" disabled>Make singles</button>
					<button type="button" class="btn" data-action="remove-selected" disabled>Remove</button>
				</div>
				<section class="mb-6 rounded-lg border border-zinc-300 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-900">
					<div class="mb-1 flex flex-wrap items-center justify-between gap-2">
						<h2 class="text-lg font-semibold">Artists <span id="import-artists-count" class="text-sm font-normal text-zinc-500"></span></h2>
						<button type="button" class="btn" data-action="add-all-artists">Add all new</button>
					</div>
					<p class="mb-3 text-sm text-zinc-500 dark:text-zinc-400">
						New artists are also created when you import. Edit a name to change it everywhere, or type an existing artist's name to use that artist.
					</p>
					<ul id="import-artist-rows" class="divide-y divide-zinc-200 dark:divide-zinc-800"></ul>
					<div class="mt-3 flex gap-2 border-t border-zinc-200 pt-3 dark:border-zinc-800">
						<label for="import-new-artist" class="sr-only">New artist name</label>
						<input id="import-new-artist" class="input" type="text" placeholder="New artist name" autocomplete="off"/>
						<button type="button" class="btn shrink-0" data-action="add-artist">Add artist</button>
					</div>
					<p id="import-artist-status" class="mt-2 text-sm text-red-600 empty:hidden dark:text-red-400" aria-live="polite"></p>
				</section>
				<div id="import-groups"></div>
				<section id="import-singles-section">
					<h2 class="mt-6 mb-2 text-lg font-semibold">Singles <span id="import-singles-count" class="text-sm font-normal text-zinc-500"></span></h2>
					<p class="mb-2 text-sm text-zinc-500 dark:text-zinc-400">Each track here becomes its own single.</p>
					<ol id="import-singles" class="divide-y divide-zinc-200 dark:divide-zinc-700"></ol>
				</section>
				<div class="mt-6 flex flex-wrap items-center gap-4 border-t border-zinc-200 pt-4 dark:border-zinc-700">
					<button type="button" class="btn" data-action="pick-files">Add more files</button>
					<p id="import-result" class="flex-1 text-sm" aria-live="polite"></p>
					<button type="button" class="btn" data-action="import">Import everything</button>
				</div>
			</div>
			<template id="import-group-template">
				@importGroup()
			</template>
			<template id="import-row-template">
				@importRow()
			</template>
			<template id="import-single-template">
				@importSingle()
			</template>
			<template id="import-artist-template">
				@importArtist()
			</template>
			<template id="import-artist-option-template">
				@importArtistOption()
			</template>
		</section>
		<script src="/assets/js/artist-picker.js" defer></script>
		<script src="/assets/js/track-hash.js" defer></script>
		<script src="/assets/js/tags.js" defer></script>
		<script src="/assets/js/import.js" defer></script>
	}
}

// importGroup is one proposed release in the review.
templ importGroup() {
	<section class="import-group mb-4 rounded-lg border border-zinc-300 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-900">
		<div class="mb-3 grid items-end gap-3 md:grid-cols-[minmax(0,1fr)_auto_7rem_auto]">
			<label class="text-sm font-medium">
				Release title
				<input class="input mt-1" type="text" data-field="title" required/>
			</label>
			<div>
				<span class="mb-1 block text-sm font-medium">
					Type <span class="font-normal text-zinc-500" data-type-source></span>
				</span>
				<div class="flex overflow-hidden rounded-md border border-zinc-300 dark:border-zinc-700" role="group" aria-label="Release type">
					for _, typ := range audio.ReleaseTypes {
						<button
							type="button"
							class="border-r border-zinc-300 px-2.5 py-2 text-sm last:border-r-0 aria-pressed:bg-zinc-900 aria-pressed:text-white dark:border-zinc-700 dark:aria-pressed:bg-zinc-100 dark:aria-pressed:text-zinc-900"
							aria-pressed="false"
							data-type={ string(typ) }
						>{ typ.Label() }</button>
					}
				</div>
			</div>
			<label class="text-sm font-medium">
				Date
				<input class="input mt-1" type="text" data-field="date" placeholder="YYYY" pattern="\d{4}(-\d{2}(-\d{2})?)?"/>
			</label>
			<div class="flex gap-1">
				<button type="button" class="btn" data-action="split">Split into singles</button>
				<button type="button" class="btn px-2.5" data-action="remove-group" aria-label="Remove release from import">✕</button>
			</div>
		</div>
		<div class="mb-2 flex items-center gap-2 text-sm">
			<span class="shrink-0 font-medium">Release artists</span>
			<div class="w-full max-w-md">
				@importArtistPicker()
			</div>
		</div>
		<p class="mb-2 text-sm text-red-600 empty:hidden dark:text-red-400" data-group-status></p>
		<ol class="divide-y divide-zinc-200 dark:divide-zinc-800" data-rows></ol>
	</section>
}

const importRowCols = "grid-cols-[auto_2rem_3.5rem_minmax(0,1fr)] md:grid-cols-[auto_2rem_3.5rem_minmax(0,1fr)_minmax(0,14rem)_minmax(0,12rem)]"

// importRow is a track inside a proposed release.
templ importRow() {
	<li class={ "import-row grid items-center gap-2 py-1.5", importRowCols }>
		<input type="checkbox" data-select aria-label="Select track"/>
		<span class="text-right text-sm text-zinc-500 tabular-nums" data-number></span>
		<input class="input px-1.5" type="number" min="1" data-field="disc" aria-label="Disc" title="Disc"/>
		<input class="input" type="text" data-field="title" aria-label="Title" required/>
		@importArtistPicker()
		<span class="truncate text-xs text-zinc-500 dark:text-zinc-400" data-file></span>
		<span class="col-span-full text-sm empty:hidden data-[state=done]:text-emerald-600 data-[state=error]:text-red-600 data-[state=exists]:text-amber-600 data-[state=link]:text-sky-600 data-[state=pending]:text-zinc-500 dark:data-[state=error]:text-red-400 dark:data-[state=exists]:text-amber-400 dark:data-[state=link]:text-sky-400" data-status></span>
	</li>
}

// importArtist is one detected artist name in the review's artist list.
templ importArtist() {
	<li class="import-artist grid grid-cols-[minmax(0,1fr)_auto_auto_auto] items-center gap-2 py-1.5">
		<input class="input" type="text" list="import-artist-list" data-artist-name aria-label="Artist name" autocomplete="off"/>
		<span class="text-sm text-zinc-500 tabular-nums dark:text-zinc-400" data-count></span>
		<span class="rounded px-2 py-0.5 text-xs font-medium data-[state=known]:bg-emerald-100 data-[state=known]:text-emerald-800 data-[state=new]:bg-amber-100 data-[state=new]:text-amber-800 dark:data-[state=known]:bg-emerald-900/40 dark:data-[state=known]:text-emerald-300 dark:data-[state=new]:bg-amber-900/40 dark:data-[state=new]:text-amber-300" data-badge></span>
		<button type="button" class="btn" data-action="add-detected">Add</button>
	</li>
}

// importArtistPicker looks and behaves like artistPicker (artist-picker.js
// does the summary, search and closing), but import.js fills its options when
// it opens: library artists plus names detected in the files, which may not
// exist yet. Values are artist names, resolved to IDs at import.
templ importArtistPicker() {
	<details class="relative" data-artist-picker data-import-picker>
		<summary class="input cursor-pointer list-none truncate" data-artist-summary>Select artists</summary>
		<div class="absolute z-20 mt-1 w-full min-w-56 rounded-md border border-zinc-300 bg-white p-2 shadow-lg dark:border-zinc-700 dark:bg-zinc-800">
			<input type="search" class="input mb-2" placeholder="Search artists…" aria-label="Search artists" autocomplete="off" data-artist-search/>
			<div class="max-h-60 overflow-auto" data-artist-options></div>
			<p class="px-1 py-1 text-sm text-zinc-500" hidden data-artist-empty>No matching artists.</p>
			<button type="button" class="mt-1 w-full rounded px-1 py-1 text-left text-sm text-sky-600 hover:bg-zinc-100 dark:text-sky-400 dark:hover:bg-zinc-700" hidden data-action="picker-add"></button>
		</div>
	</details>
}

// importArtistOption is cloned by import.js for each name in an import picker.
templ importArtistOption() {
	<label class="flex cursor-pointer items-center gap-2 rounded px-1 py-1 text-sm hover:bg-zinc-100 dark:hover:bg-zinc-700">
		<input type="checkbox" name="artist_id"/>
		<span data-option-name></span>
		<span class="text-xs text-amber-600 dark:text-amber-400" hidden data-option-new>new</span>
	</label>
}

const importSingleCols = "grid-cols-[auto_minmax(0,1fr)] md:grid-cols-[auto_minmax(0,1fr)_minmax(0,14rem)_7rem_minmax(0,12rem)]"

// importSingle is a track that becomes its own single.
templ importSingle() {
	<li class={ "import-row grid items-center gap-2 py-1.5", importSingleCols }>
		<input type="checkbox" data-select aria-label="Select track"/>
		<input class="input" type="text" data-field="title" aria-label="Title" required/>
		@importArtistPicker()
		<input class="input" type="text" data-field="date" aria-label="Release date" placeholder="YYYY" pattern="\d{4}(-\d{2}(-\d{2})?)?"/>
		<span class="truncate text-xs text-zinc-500 dark:text-zinc-400" data-file></span>
		<span class="col-span-full text-sm empty:hidden data-[state=done]:text-emerald-600 data-[state=error]:text-red-600 data-[state=exists]:text-amber-600 data-[state=pending]:text-zinc-500 dark:data-[state=error]:text-red-400 dark:data-[state=exists]:text-amber-400" data-status></span>
	</li>
}
