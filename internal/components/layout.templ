package components

// Page identifiers, used to highlight the current nav link.
const (
	PageTracks   = "tracks"
	PageAdd      = "add"
	PageArtists  = "artists"
	PageReleases = "releases"
	PageTags     = "tags"
)

// tagsPage says whether the secret-mode Tags page exists yet (plan 17, step 10); the links stay behind this flag.
const tagsPage = true

templ layout(title string, active string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			// apply the saved theme before first paint; ?theme=light|dark overrides it (for screenshots)
			<script>try{var t=new URLSearchParams(location.search).get("theme")||localStorage.theme;if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · audioloader</title>
			// htmx doesn't swap error responses by default; a 409 carries a
			// message meant for the form's result area
			<meta name="htmx-config" content='{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"409","swap":true,"error":false},{"code":"[45]..","swap":false,"error":true}]}'/>
			<link rel="icon" type="image/png" href="/assets/img/favicon.png"/>
			<link rel="apple-touch-icon" href="/assets/img/icon-180.png"/>
			<link rel="manifest" href="/assets/manifest.webmanifest"/>
			<meta name="theme-color" content="#0e0f11"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<link rel="stylesheet" href="/assets/css/app.css"/>
			<script src="/assets/js/htmx.min.js" defer></script>
			<script src="/assets/js/player-state.js" defer></script>
			<script src="/assets/js/sleep-timer.js" defer></script>
			<script src="/assets/js/player.js" defer></script>
			<script src="/assets/js/commands.js" defer></script>
			<script src="/assets/js/nav.js" defer></script>
			<script src="/assets/js/context-menu.js" defer></script>
			<script src="/assets/js/filter.js" defer></script>
			<script src="/assets/js/grid-filter.js" defer></script>
		</head>
		// hx-boost turns links into htmx swaps of the body, so the page never
		// reloads while browsing and the hx-preserve'd player keeps playing
		// data-mode switches the accent color (styles/input.css) and tells
		// player.js which mode its saved state belongs to
		<body hx-boost="true" data-mode={ modeName(ctx) }>
			<div class="min-[720px]:grid min-[720px]:grid-cols-[232px_minmax(0,1fr)] min-[1200px]:grid-cols-[232px_minmax(0,1fr)_300px]">
				@sidebar(active)
				<div class="min-w-0">
					@topStrip()
					<main class="max-w-[1072px] px-4 pt-4 pb-44 min-[720px]:pb-28">
						{ children... }
					</main>
				</div>
				@queuePanel()
			</div>
			@tabBar(active)
			@moreSheet(active)
			@shortcutsDialog()
			@nowPlaying()
			@player()
		</body>
	</html>
}

templ player() {
	// phone: a floating card above the tab bar (cover, title, play, next; a tap
	// opens the Now Playing sheet); 720px up: the bar along the bottom
	<div id="player" hx-preserve class="fixed inset-x-2 bottom-[calc(3.5rem+6px)] z-20 rounded-xl border border-line bg-panel/80 shadow-(--shadow-pop) backdrop-blur-xl min-[720px]:inset-x-auto min-[720px]:right-0 min-[720px]:bottom-0 min-[720px]:left-[232px] min-[720px]:rounded-none min-[720px]:border-0 min-[720px]:border-t min-[720px]:bg-panel/95 min-[720px]:shadow-none min-[720px]:backdrop-blur" hidden>
		<div class="relative flex items-center gap-2 p-2 max-[720px]:cursor-pointer min-[720px]:h-16 min-[720px]:gap-3 min-[720px]:px-4 min-[720px]:py-0">
			<img id="player-cover" class="pixelated size-10 shrink-0 rounded-md bg-panel-2 object-cover min-[720px]:rounded-sm" alt=""/>
			<div class="min-w-0 flex-1 min-[720px]:w-56 min-[720px]:flex-none">
				<strong id="player-title" class="block truncate text-sm font-semibold"></strong>
				<span id="player-artists" class="block truncate text-xs text-fg-muted"></span>
				<span id="player-chapter" class="block truncate text-xs text-fg-subtle max-[720px]:hidden" hidden></span>
			</div>
			<div class="flex shrink-0 items-center gap-1 min-[720px]:order-1">
				<button id="player-shuffle" type="button" class="flex size-9 items-center justify-center rounded-md text-fg-muted hover:text-fg aria-pressed:bg-accent-dim aria-pressed:text-accent max-[720px]:hidden" aria-label="Shuffle" aria-pressed="false">@icon("shuffle")</button>
				// repeat, desktop spot: next to shuffle
				@repeatButton("max-[720px]:hidden")
				<button id="player-prev" type="button" class="flex size-9 items-center justify-center rounded-md text-fg-muted hover:text-fg disabled:opacity-40 max-[720px]:hidden" aria-label="Previous track">@iconClass("skip-back", "size-4")</button>
				<button id="player-play" type="button" class="flex size-11 items-center justify-center rounded-full bg-accent text-accent-ink hover:brightness-110 max-[720px]:bg-transparent max-[720px]:text-fg min-[720px]:size-10" aria-label="Play">
					<span data-icon-play>@iconClass("play", "size-5")</span>
					<span data-icon-pause hidden>@iconClass("pause", "size-5")</span>
				</button>
				<button id="player-next" type="button" class="flex size-11 items-center justify-center rounded-md text-fg-muted hover:text-fg disabled:opacity-40 min-[720px]:size-9" aria-label="Next track">@iconClass("skip-forward", "size-5")</button>
			</div>
			<div class="hidden shrink-0 items-center gap-1 min-[720px]:order-3 min-[720px]:flex">
				<button id="player-mute" type="button" class="flex size-9 items-center justify-center rounded-md text-fg-muted hover:text-fg" aria-label="Mute">
					<span data-vol-icon="x" hidden>@icon("volume-x")</span>
					<span data-vol-icon="1" hidden>@icon("volume-1")</span>
					<span data-vol-icon="2">@icon("volume-2")</span>
				</button>
				<input id="player-volume" type="range" min="0" max="1" step="0.01" value="1" class="h-6 w-24 accent-accent" aria-label="Volume"/>
			</div>
			<details id="player-queue" class="relative shrink-0 min-[720px]:order-4 min-[1200px]:hidden">
				<summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-md text-fg-muted hover:text-fg min-[720px]:size-9" aria-label="Queue">@iconClass("list", "size-5")</summary>
				<div class="absolute right-0 bottom-full mb-2 w-72 rounded-lg border border-line bg-panel p-2 text-sm shadow-(--shadow-pop)">
					<div class="mb-1 flex items-center justify-between">
						<strong>Up next</strong>
						<span class="flex items-center gap-3">
							@autoplaySwitch()
							<button data-queue-clear type="button" class="text-xs text-fg-muted underline hover:text-fg">Clear</button>
						</span>
					</div>
					<ol data-queue-list class="max-h-72 overflow-auto"></ol>
					<p data-queue-empty class="py-1 text-fg-muted">Nothing queued.</p>
					<div data-chapter-box class="mt-2 border-t border-line pt-2" hidden>
						<strong>Chapters</strong>
						<ol data-chapter-list class="max-h-60 overflow-auto"></ol>
					</div>
				</div>
			</details>
			<div class="flex min-w-0 items-center gap-x-2 max-[720px]:hidden min-[720px]:order-2 min-[720px]:flex-1">
				// sleep timer: next to the episode controls
				@sleepTimer("", "left-0")
				<span id="player-episode-controls" class="flex shrink-0 items-center gap-1" hidden>
					<button id="player-back" type="button" class="btn btn-ghost min-h-9 px-2 text-xs" aria-label="Back 15 seconds">−15</button>
					<button id="player-forward" type="button" class="btn btn-ghost min-h-9 px-2 text-xs" aria-label="Forward 30 seconds">+30</button>
					<select id="player-speed" class="input w-auto px-1 py-1 text-xs" aria-label="Playback speed">
						for _, s := range []string{"0.8", "1", "1.1", "1.25", "1.5", "1.75", "2"} {
							<option value={ s } selected?={ s == "1" }>{ s }×</option>
						}
					</select>
				</span>
				<div class="flex min-w-0 flex-1 items-center gap-2">
				<span id="player-time" class="w-10 shrink-0 text-right font-mono text-xs text-fg-muted tabular-nums">0:00</span>
				<input id="player-seek" type="range" min="0" max="0" step="any" value="0" class="h-6 min-w-0 flex-1 accent-accent" aria-label="Seek"/>
				<span id="player-remaining" class="w-12 shrink-0 font-mono text-xs text-fg-muted tabular-nums">-0:00</span>
				</div>
			</div>
			// the playback position along the card's bottom edge (phone)
			<div class="pointer-events-none absolute inset-x-3 bottom-0 h-0.5 rounded-full bg-fg/10 min-[720px]:hidden"><div data-mini-progress class="h-full w-0 rounded-full bg-fg/60"></div></div>
			// player.js builds the queue remove buttons from this
			<template id="player-x-icon">@iconClass("x", "size-3.5")</template>
			// short feedback when tracks are queued (player.js); hidden when empty
			<div data-queue-toast role="status" aria-live="polite" class="pop absolute right-3 bottom-full mb-2 px-3 py-2 text-sm empty:hidden"></div>
			<audio id="player-audio" preload="metadata"></audio>
		</div>
	</div>
}

// nowPlaying is the full-screen sheet a tap on the phone mini player opens.
templ nowPlaying() {
	<dialog id="now-playing" hx-preserve class="fixed inset-0 m-0 size-full max-h-none max-w-none bg-panel p-4 text-fg min-[720px]:hidden" aria-label="Now playing">
		<form method="dialog" class="text-center">
			<button class="mx-auto block h-1.5 w-10 rounded-full bg-fg-subtle" aria-label="Close"></button>
		</form>
	</dialog>
}

// autoplaySwitch turns autoplay on and off in a queue header. It is drawn in
// the popover and in the side panel; player.js keeps both in step (data-autoplay).
templ autoplaySwitch() {
	<button data-autoplay type="button" role="switch" aria-checked="true" class="group flex items-center gap-1.5 text-xs text-fg-muted hover:text-fg aria-checked:text-accent" title="Keep playing similar tracks when the queue ends">
		<span class="relative inline-block h-3.5 w-6 rounded-full bg-panel-2 ring-1 ring-line ring-inset group-aria-checked:bg-accent-dim">
			<span class="absolute top-0.5 left-0.5 size-2.5 rounded-full bg-current transition-transform group-aria-checked:translate-x-2.5"></span>
		</span>
		Autoplay
	</button>
}

// repeatButton cycles off, all, one. It is drawn twice, one per spot, and
// player.js keeps both in step through data-repeat.
templ repeatButton(class string) {
	<button data-repeat type="button" class={ "flex size-9 shrink-0 items-center justify-center rounded-md text-fg-muted hover:text-fg aria-pressed:bg-accent-dim aria-pressed:text-accent", class } aria-label="Repeat: off" aria-pressed="false">
		<span data-repeat-icon="all">@icon("repeat")</span>
		<span data-repeat-icon="one" hidden>@icon("repeat-1")</span>
	</button>
}

// sleepTimer is the moon button and its menu. It is drawn twice, one per spot
// (phone: top row; 720px up: beside the seek bar), and player.js keeps both in
// step through the data-sleep-* attributes.
templ sleepTimer(class string, align string) {
	<details data-sleep-box class={ "relative shrink-0", class }>
		<summary data-sleep-summary class="flex h-9 cursor-pointer list-none items-center gap-1 rounded-md px-2 text-fg-muted hover:text-fg" aria-label="Sleep timer">
			@icon("moon")
			<span data-sleep-label class="font-mono text-xs tabular-nums" hidden></span>
		</summary>
		<div class={ "absolute bottom-full mb-2 w-56 rounded-lg border border-line bg-panel p-2 text-sm shadow-(--shadow-pop)", align }>
			<strong class="block">Sleep timer</strong>
			<p data-sleep-status class="mb-1 text-xs text-fg-muted">Off</p>
			<div data-sleep-extra class="mb-1 flex gap-1" hidden>
				<button data-sleep="extend" type="button" class="btn btn-ghost min-h-8 flex-1 px-2 text-xs">+15 min</button>
				<button data-sleep="off" type="button" class="btn btn-ghost min-h-8 flex-1 px-2 text-xs">Off</button>
			</div>
			<ul class="max-h-60 overflow-auto">
				for _, m := range []string{"15", "30", "45", "60", "75", "90", "105", "120"} {
					<li><button data-sleep={ m } type="button" class="w-full rounded px-1 py-1 text-left hover:bg-panel-2">{ m } minutes</button></li>
				}
				<li><button data-sleep="track" data-sleep-track type="button" class="w-full rounded px-1 py-1 text-left hover:bg-panel-2">End of this track</button></li>
			</ul>
		</div>
	</details>
}

// queuePanel is the queue column from 1200px up; player.js fills it. Like
// the player it is hx-preserve'd, so page swaps keep it and its scroll position.
templ queuePanel() {
	<aside id="queue-panel" hx-preserve class="hidden flex-col gap-4 border-l border-line bg-panel p-3 pb-20 text-sm min-[1200px]:sticky min-[1200px]:top-0 min-[1200px]:flex min-[1200px]:h-dvh min-[1200px]:overflow-y-auto" aria-label="Queue">
		<section>
			<strong class="mb-2 block text-xs font-semibold tracking-[0.06em] text-fg-subtle uppercase">Now playing</strong>
			<p data-now-empty class="text-fg-muted">Nothing playing.</p>
			<div data-now class="flex items-center gap-3" hidden>
				<img data-now-cover class="pixelated size-16 shrink-0 rounded-sm bg-panel-2 object-cover" alt=""/>
				<div class="min-w-0">
					<strong data-now-title class="block truncate font-semibold"></strong>
					<span data-now-artists class="block truncate text-xs text-fg-muted"></span>
				</div>
			</div>
		</section>
		<section>
			<div class="mb-1 flex items-center justify-between">
				<strong class="text-xs font-semibold tracking-[0.06em] text-fg-subtle uppercase">Up next</strong>
				<span class="flex items-center gap-3">
					@autoplaySwitch()
					<button data-queue-clear type="button" class="text-xs text-fg-muted underline hover:text-fg">Clear</button>
				</span>
			</div>
			<ol data-queue-list></ol>
			<p data-queue-empty class="py-1 text-fg-muted">Nothing queued.</p>
		</section>
		<section data-chapter-box hidden>
			<strong class="mb-1 block text-xs font-semibold tracking-[0.06em] text-fg-subtle uppercase">Chapters</strong>
			<ol data-chapter-list></ol>
		</section>
	</aside>
}

templ sidebar(active string) {
	<aside class="flex flex-col gap-4 max-[720px]:hidden border-b border-line bg-panel p-3 min-[720px]:sticky min-[720px]:top-0 min-[720px]:h-dvh min-[720px]:overflow-y-auto min-[720px]:border-r min-[720px]:border-b-0">
		<a class="flex items-center gap-2 px-2 py-1 font-semibold text-fg hover:no-underline" href="/">
			<img class="pixelated size-6" src="/assets/img/favicon.png" alt=""/>
			audioloader
		</a>
		<a
			class="btn w-full justify-center gap-2"
			href="/add"
			if active == PageAdd {
				aria-current="page"
			}
		>
			@icon("upload")
			Add
		</a>
		<nav aria-label="Library">
			@navLabel("Library")
			<ul class="flex flex-col gap-0.5">
				@navLink("/tracks", "Tracks", "tracks", active == PageTracks)
				if secretMode(ctx) && tagsPage {
					@navLink("/tags", "Tags", "tags", active == PageTags)
				}
				if !secretMode(ctx) {
					@navLink("/releases", "Releases", "releases", active == PageReleases)
				}
				if secretMode(ctx) {
					@navLink("/artists", "Creators", "artists", active == PageArtists)
				} else {
					@navLink("/artists", "Artists", "artists", active == PageArtists)
					@navLink("/playlists", "Playlists", "playlists", active == PagePlaylists)
					@navLink("/shows", "Podcasts", "shows", active == PageShows)
				}
			</ul>
		</nav>
		if !secretMode(ctx) {
			<nav aria-label="Queue">
				@navLabel("Queue")
				<ul class="flex flex-col gap-0.5">
					@navLinkBadge("/inbox", "Inbox", "inbox", active == PageInbox, "/ui/badges/inbox")
					@navLinkBadge("/tagging", "Tagging", "tagging", active == PageTagging, "/ui/badges/tagging")
					@navLinkBadge("/downloads", "Downloads", "downloads", active == PageDownloads, "/ui/badges/downloads")
				</ul>
			</nav>
		}
		<div class="mt-auto">
			if secretMode(ctx) {
				<form method="post" action="/vault/lock" hx-boost="false" onsubmit="window.player?.reset()">
					<button type="submit" class="btn btn-ghost w-full justify-center gap-2">
						@icon("lock")
						<span>Lock</span>
					</button>
				</form>
			} else if vaultEnabled(ctx) {
				<a href="/vault" class="btn btn-ghost w-full justify-center gap-2">
					@icon("lock")
					Vault
				</a>
			}
		</div>
		<div class="flex flex-col gap-2 px-2 text-xs text-fg-subtle">
			<div class="flex items-center gap-2" role="group" aria-label="Theme">
				<button type="button" class="rounded px-2 py-1 hover:text-fg" onclick="setTheme('dark')">Dark</button>
				<button type="button" class="rounded px-2 py-1 hover:text-fg" onclick="setTheme('light')">Light</button>
			</div>
		</div>
		<script>function setTheme(t){document.documentElement.dataset.theme=t;try{localStorage.theme=t}catch(e){}}</script>
	</aside>
}

templ navLabel(label string) {
	<p class="mb-1 px-2 text-xs font-semibold tracking-[0.06em] text-fg-subtle uppercase">{ label }</p>
}

templ topStrip() {
	<header class="sticky top-0 z-10 flex h-12 items-center gap-3 border-b border-line bg-bg/95 px-4 backdrop-blur min-[720px]:px-6">
		<form action="/search" class="relative min-w-0 max-w-[520px] flex-1" role="search">
			<input
				class="input peer min-[720px]:pr-16"
				type="search"
				name="q"
				placeholder="Search"
				aria-label="Search the library, or type > for actions"
				autocomplete="off"
				hx-get="/ui/search"
				hx-trigger="input changed delay:200ms, focus"
				hx-target="#search-suggest"
				hx-sync="this:replace"
			/>
			<kbd id="search-hint" class="pointer-events-none absolute top-1/2 right-2 -translate-y-1/2 rounded-sm border border-line px-1.5 font-mono text-xs text-fg-subtle max-[720px]:hidden peer-focus:hidden">Ctrl K</kbd>
			<div id="search-suggest" onfocusout="setTimeout(() => { if (!this.parentElement.contains(document.activeElement)) this.replaceChildren() }, 150)"></div>
		</form>
		<a href="/add" class="ml-auto flex size-11 items-center justify-center rounded-md text-fg-muted hover:bg-panel-2 hover:text-fg min-[720px]:hidden" aria-label="Add">
			@icon("upload")
		</a>
		if secretMode(ctx) {
			<span class="rounded bg-accent-dim px-2 py-0.5 text-xs font-semibold tracking-wide text-accent uppercase">Secret</span>
			<form class="min-[720px]:hidden" method="post" action="/vault/lock" hx-boost="false" onsubmit="window.player?.reset()">
				<button type="submit" class="flex size-11 items-center justify-center rounded-md text-fg-muted hover:bg-panel-2 hover:text-fg" aria-label="Lock">
					@icon("lock")
				</button>
			</form>
		} else if vaultEnabled(ctx) {
			<a href="/vault" class="flex size-11 items-center justify-center rounded-md text-fg-muted hover:bg-panel-2 hover:text-fg min-[720px]:hidden" aria-label="Vault">
				@icon("lock")
			</a>
		}
	</header>
}

templ navLink(href string, label string, iconName string, current bool) {
	<li>
		@navAnchor(href, label, iconName, current)
	</li>
}

templ navAnchor(href string, label string, iconName string, current bool) {
	if current {
		<a href={ templ.SafeURL(href) } aria-current="page" class="flex flex-1 items-center gap-2 rounded-md bg-accent-dim px-2 py-1.5 font-medium text-accent hover:no-underline">
			@icon(iconName)
			{ label }
		</a>
	} else {
		<a href={ templ.SafeURL(href) } class="flex flex-1 items-center gap-2 rounded-md px-2 py-1.5 text-fg-muted hover:bg-panel-2 hover:text-fg hover:no-underline">
			@icon(iconName)
			{ label }
		</a>
	}
}

// navLinkBadge is a nav link with a count loaded from badgeURL after the
// page, so pages don't each have to look the count up.
templ navLinkBadge(href string, label string, iconName string, current bool, badgeURL string) {
	<li class="relative flex items-center">
		@navAnchor(href, label, iconName, current)
		<span hx-get={ badgeURL } hx-trigger="load" hx-swap="outerHTML"></span>
	</li>
}

// Notice is a short status message, swapped into a form's result area.
templ Notice(msg string) {
	<p class="mt-4 rounded-md border-l-4 border-st-done bg-panel px-3 py-2 text-sm">{ msg }</p>
}

templ emptyState() {
	<p class="rounded-lg border border-dashed border-line px-4 py-12 text-center text-fg-muted">
		{ children... }
	</p>
}

// tabBar is the phone navigation under the player; the sidebar replaces it
// from 720px up.
templ tabBar(active string) {
	<nav class="fixed inset-x-0 bottom-0 z-30 flex h-14 border-t border-line bg-panel/80 pb-[env(safe-area-inset-bottom)] backdrop-blur-xl min-[720px]:hidden" aria-label="Main">
		@tab("/tracks", "Tracks", "tracks", active == PageTracks, "")
		if secretMode(ctx) {
			if tagsPage {
				@tab("/tags", "Tags", "tags", active == PageTags, "")
			}
			@tab("/artists", "Creators", "artists", active == PageArtists, "")
		} else {
			@tab("/releases", "Releases", "releases", active == PageReleases, "")
			@tab("/artists", "Artists", "artists", active == PageArtists, "")
			@tab("/inbox", "Inbox", "inbox", active == PageInbox, "/ui/badges/inbox")
			<button
				type="button"
				class={ tabClass(active == PagePlaylists || active == PageShows || active == PageTagging || active == PageDownloads || active == PageAdd) }
				data-sheet-open="more-sheet"
			>
				<span class="relative inline-flex [&>span]:top-[-4px] [&>span]:right-[-14px]">
					@icon("library")
					<span hx-get="/ui/badges/more" hx-trigger="load" hx-swap="outerHTML"></span>
				</span>
				Library
			</button>
		}
	</nav>
}

func tabClass(current bool) string {
	c := "flex min-h-11 flex-1 flex-col items-center justify-center gap-0.5 text-xs hover:no-underline "
	if current {
		return c + "text-accent"
	}
	return c + "text-fg-muted"
}

templ tab(href string, label string, iconName string, current bool, badgeURL string) {
	<a href={ templ.SafeURL(href) } class={ tabClass(current) }>
		<span class="relative inline-flex [&>span]:top-[-4px] [&>span]:right-[-14px]">
			@icon(iconName)
			if badgeURL != "" {
				<span hx-get={ badgeURL } hx-trigger="load" hx-swap="outerHTML"></span>
			}
		</span>
		{ label }
	</a>
}

// moreSheet is the Library tab's sheet: the pages that don't fit in the tab
// bar, as large rows. nav.js opens it.
templ moreSheet(active string) {
	if !secretMode(ctx) {
		<dialog id="more-sheet" class="fixed inset-x-0 top-auto bottom-0 m-0 w-full max-w-none rounded-t-lg border border-line bg-panel p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] text-fg shadow-[0_8px_24px_rgba(0,0,0,0.45)] backdrop:bg-black/50 min-[720px]:hidden" aria-label="Library">
			<ul class="flex flex-col">
				@sheetLink("/playlists", "Playlists", "playlists", active == PagePlaylists, "")
				@sheetLink("/shows", "Podcasts", "shows", active == PageShows, "")
				@sheetLink("/tagging", "Tagging", "tagging", active == PageTagging, "/ui/badges/tagging")
				@sheetLink("/downloads", "Downloads", "downloads", active == PageDownloads, "/ui/badges/downloads")
				@sheetLink("/inbox", "Inbox", "inbox", active == PageInbox, "/ui/badges/inbox")
				@sheetLink("/add", "Add", "upload", active == PageAdd, "")
			</ul>
		</dialog>
	}
}

// shortcutsDialog lists the keys and the ways into a menu. nav.js opens it on ?.
templ shortcutsDialog() {
	<dialog id="shortcuts-dialog" class="m-auto w-[min(26rem,calc(100vw-2rem))] rounded-lg border border-line bg-panel p-4 text-fg shadow-(--shadow-pop) backdrop:bg-black/50" aria-label="Keyboard shortcuts">
		<h2 class="mb-3 text-base font-semibold">Keyboard shortcuts</h2>
		<dl class="grid grid-cols-[auto_1fr] items-baseline gap-x-4 gap-y-2 text-sm">
			@shortcut("Ctrl K  or  ⌘K", "Search, or run an action. Start with > for actions only.")
			@shortcut("/", "Search")
			@shortcut("Space", "Play or pause")
			@shortcut("m", "Mute")
			@shortcut("?", "This list")
			@shortcut("Shift F10  or  Menu", "Open the menu of the focused row or card")
		</dl>
		<p class="mt-3 text-sm text-fg-muted">Right-click a track, release, artist or playlist for its menu (Shift + right-click keeps the browser's). On a phone, press and hold.</p>
		<form method="dialog" class="mt-4 text-right">
			<button class="btn btn-ghost">Close</button>
		</form>
	</dialog>
}

templ shortcut(keys string, what string) {
	<dt><kbd class="rounded-sm border border-line px-1.5 font-mono text-xs whitespace-pre text-fg-muted">{ keys }</kbd></dt>
	<dd>{ what }</dd>
}

templ sheetLink(href string, label string, iconName string, current bool, badgeURL string) {
	<li class="relative flex items-center">
		<a
			href={ templ.SafeURL(href) }
			class={ "flex min-h-14 flex-1 items-center gap-4 rounded-md px-3 text-base hover:no-underline", templ.KV("bg-accent-dim text-accent", current), templ.KV("text-fg", !current) }
			if current {
				aria-current="page"
			}
		>
			@iconClass(iconName, "size-5")
			{ label }
		</a>
		if badgeURL != "" {
			<span hx-get={ badgeURL } hx-trigger="load" hx-swap="outerHTML"></span>
		}
	</li>
}

// icon is a 16px inline SVG that takes the text colour.
templ icon(name string) {
	@iconClass(name, "size-4")
}

// iconClass is an icon at another size: class sets the size classes.
templ iconClass(name string, class string) {
	<svg class={ "shrink-0", class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "tracks":
				<path d="M9 18V5l12-2v13"></path>
				<circle cx="6" cy="18" r="3"></circle>
				<circle cx="18" cy="16" r="3"></circle>
			case "releases":
				<circle cx="12" cy="12" r="10"></circle>
				<circle cx="12" cy="12" r="3"></circle>
			case "artists":
				<circle cx="12" cy="8" r="4"></circle>
				<path d="M4 21c0-4 4-7 8-7s8 3 8 7"></path>
			case "inbox":
				<path d="M22 12h-6l-2 3h-4l-2-3H2"></path>
				<path d="M5.5 5h13L22 12v7a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-7z"></path>
			case "library":
				<rect x="4" y="4" width="5" height="16" rx="1"></rect>
				<path d="M14 5.5l4-1 3 14.5-4 1z"></path>
			case "more":
				<circle cx="5" cy="12" r="1"></circle>
				<circle cx="12" cy="12" r="1"></circle>
				<circle cx="19" cy="12" r="1"></circle>
			case "upload":
				<path d="M12 16V4"></path>
				<path d="M7 9l5-5 5 5"></path>
				<path d="M4 20h16"></path>
			case "tags":
				<path d="M20 12l-8 8-9-9V3h8z"></path>
				<circle cx="7.5" cy="7.5" r="1"></circle>
			case "playlists":
				<path d="M3 6h13M3 12h13M3 18h8"></path>
				<path d="M19 9v9"></path>
				<circle cx="17" cy="18" r="2"></circle>
			case "shows":
				<rect x="9" y="2" width="6" height="12" rx="3"></rect>
				<path d="M5 11a7 7 0 0 0 14 0M12 18v4"></path>
			case "tagging":
				<path d="M20 6L9 17l-5-5"></path>
			case "downloads":
				<path d="M12 4v12"></path>
				<path d="M7 11l5 5 5-5"></path>
				<path d="M4 20h16"></path>
			case "moon":
				<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
			case "volume-x":
				<path d="M11 5L6 9H2v6h4l5 4V5z"></path>
				<path d="M22 9l-6 6M16 9l6 6"></path>
			case "volume-1":
				<path d="M11 5L6 9H2v6h4l5 4V5z"></path>
				<path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
			case "volume-2":
				<path d="M11 5L6 9H2v6h4l5 4V5z"></path>
				<path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"></path>
			case "play":
				<path d="M7 4.5v15l12-7.5z" fill="currentColor"></path>
			case "pause":
				<rect x="6" y="4.5" width="4" height="15" rx="1" fill="currentColor"></rect>
				<rect x="14" y="4.5" width="4" height="15" rx="1" fill="currentColor"></rect>
			case "skip-back":
				<path d="M19 5v14L8 12z" fill="currentColor"></path>
				<path d="M5 5v14"></path>
			case "skip-forward":
				<path d="M5 5v14l11-7z" fill="currentColor"></path>
				<path d="M19 5v14"></path>
			case "shuffle":
				<path d="M16 3h5v5"></path>
				<path d="M4 20L21 3"></path>
				<path d="M21 16v5h-5"></path>
				<path d="M15 15l6 6"></path>
				<path d="M4 4l5 5"></path>
			case "repeat":
				<path d="M17 2l4 4-4 4"></path>
				<path d="M3 11v-1a4 4 0 0 1 4-4h14"></path>
				<path d="M7 22l-4-4 4-4"></path>
				<path d="M21 13v1a4 4 0 0 1-4 4H3"></path>
			case "repeat-1":
				<path d="M17 2l4 4-4 4"></path>
				<path d="M3 11v-1a4 4 0 0 1 4-4h14"></path>
				<path d="M7 22l-4-4 4-4"></path>
				<path d="M21 13v1a4 4 0 0 1-4 4H3"></path>
				<path d="M11 10h1v4"></path>
			case "list":
				<path d="M4 6h16M4 12h16M4 18h16"></path>
			case "x":
				<path d="M18 6L6 18M6 6l12 12"></path>
			case "arrow-up":
				<path d="M12 19V5"></path>
				<path d="M5 12l7-7 7 7"></path>
			case "arrow-down":
				<path d="M12 5v14"></path>
				<path d="M19 12l-7 7-7-7"></path>
			case "arrow-right":
				<path d="M5 12h14"></path>
				<path d="M12 5l7 7-7 7"></path>
			case "check":
				<path d="M20 6L9 17l-5-5"></path>
			case "lock":
				<rect x="4" y="11" width="16" height="10" rx="2"></rect>
				<path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
		}
	</svg>
}
