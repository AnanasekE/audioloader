
package components

import "audioloader/internal/audio"

templ layout() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>audioloader</title>
			<link rel="icon" type="image/png" href="/assets/img/favicon.png"/>
			<link rel="stylesheet" href="/assets/css/bamboo.min.css"/>
			<link rel="stylesheet" href="/assets/css/style.css"/>
			<script src="/assets/js/htmx.min.js" defer></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ Home(artists []*audio.Artist, tracks []*audio.Track) {
	@layout() {
		<nav>
			<h1>HOME</h1>
		</nav>
		<main>
			@AddTrack(artists)
			@AddArtist()
			@GetArtists()
			@GetTracks(tracks)
		</main>
	}
}

templ AddTrack(artists []*audio.Artist) {
	<section>
		<h2>Add track</h2>
		<form
			hx-post="/ui/tracks"
			hx-encoding="multipart/form-data"
			hx-target="#result-tracks"
		>
			<label for="track-title">Title</label>
			<input id="track-title" type="text" name="title" placeholder="Track name"/>
			<label for="track-artist">Artist</label>
			<select
				id="track-artist"
				name="artist_id"
				hx-get="/ui/artists/options"
				hx-trigger="artistsChanged from:body"
				hx-target="this"
				hx-swap="innerHTML"
			>
				@ArtistOptions(artists)
			</select>
			<label for="track-file">File</label>
			<input
				id="track-file"
				type="file"
				name="track"
				accept="audio/*,.mp3,.opus,.flac,.ogg,.wav,.m4a,.aac"
			/>
			<button type="submit">Submit</button>
		</form>
		<span id="result-tracks"></span>
	</section>
}

templ ArtistOptions(artists []*audio.Artist) {
	<option value="" disabled selected>Select artist</option>
	for _, artist := range artists {
		<option value={ artist.ID.String() }>{ artist.Name }</option>
	}
}

templ AddArtist() {
	<section>
		<h2>Add artist</h2>
		<form
			hx-post="/ui/artists"
			hx-encoding="multipart/form-data"
			hx-target="#result-artist"
		>
			<label for="artist-name">Name</label>
			<input id="artist-name" type="text" name="name" placeholder="Artist name"/>
			<button type="submit">Submit</button>
		</form>
		<span id="result-artist"></span>
	</section>
}

templ GetArtists() {
	<section>
		<h2>Artists</h2>
		<button hx-get="/ui/artists" hx-target="#result-artists">Get artists</button>
		<div id="result-artists"></div>
	</section>
}

templ GetTracks(tracks []*audio.Track) {
	<section>
		<h2>Tracks</h2>
		<button hx-get="/ui/tracks" hx-target="#result-track-list">Refresh tracks</button>
		<div id="result-track-list">
			@TrackList(tracks)
		</div>
	</section>
}

templ Artist(a *audio.Artist) {
	<div>
		<img src={ a.ImgURL } alt="Artist profile picture"/>
		<p>{ a.Name }</p>
	</div>
}

templ ArtistList(artists []*audio.Artist) {
	<div>
		for _, artist := range artists {
			@Artist(artist)
		}
	</div>
}

templ Track(t *audio.Track) {
	<div>
		<img src={ t.ImgURL } alt="Track image"/>
		<p>{ t.Title }</p>
		<small>
			for i, artist := range t.Artists {
				if i > 0 {
					{ ", " }
				}
				{ artist.Name }
			}
		</small>
		<small>{ t.Duration.String() }</small>
		<audio controls preload="none" src={ "/api/tracks/" + t.ID.String() + "/stream" }>
			Your browser does not support the audio element.
		</audio>
	</div>
}

templ TrackList(tracks []*audio.Track) {
	if len(tracks) == 0 {
		<p>No tracks yet.</p>
	} else {
		<ul>
			for _, track := range tracks {
				<li>
					@Track(track)
				</li>
			}
		</ul>
	}
}
