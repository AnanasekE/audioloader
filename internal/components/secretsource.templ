package components

import (
	"context"
	"fmt"
	"net/url"
	"path"

	"audioloader/internal/audio"
	"audioloader/internal/sources/secret"
)

type secretSourceKey struct{}

// WithSecretSource says whether a secret source is configured, so the upload
// page knows whether to offer it.
func WithSecretSource(ctx context.Context, on bool) context.Context {
	return context.WithValue(ctx, secretSourceKey{}, on)
}

func secretSourceOn(ctx context.Context) bool {
	on, _ := ctx.Value(secretSourceKey{}).(bool)
	return on
}

// SecretSourcePage downloads a secret track from a page of the secret
// source. Check loads the page's title and description into a form, where
// the creators are picked by hand before the download starts; a listing page,
// such as an uploader's, lists its pages to pick from instead. A prefilled
// address is checked as soon as the page loads.
templ SecretSourcePage(prefill string) {
	@layout("Download from URL", PageUpload) {
		@pageHeader("Download from URL", "Paste the address of a page; you pick the creators yourself") {
			<a class="btn" href="/upload">Upload a file</a>
		}
		<details class="mb-4">
			<summary class="mb-2 cursor-pointer text-sm font-medium">New creator</summary>
			@AddArtistForm()
		</details>
		<section id="secret-source" class="card grid max-w-2xl grid-cols-1 gap-4">
			<form
				class="flex flex-wrap items-center gap-2"
				hx-post="/ui/secret-source/check"
				hx-target="#secret-source-result"
				hx-indicator="#secret-source-loading"
				if prefill != "" {
					hx-trigger="load, submit"
				}
				hx-on::after-request="if (!event.detail.successful) document.getElementById('secret-source-result').textContent = event.detail.xhr.responseText || 'Could not check that address.'"
			>
				<label for="secret-source-url" class="sr-only">Page address</label>
				<input id="secret-source-url" class="input min-w-64 flex-1" type="text" inputmode="url" name="url" value={ prefill } placeholder="Page address" autocomplete="off" required/>
				<button class="btn" type="submit">Check</button>
				<span id="secret-source-loading" class="htmx-indicator text-sm text-zinc-500">Loading…</span>
			</form>
			<div id="secret-source-result" class="text-sm" aria-live="polite"></div>
		</section>
		<script src="/assets/js/artist-picker.js" defer></script>
		<script src="/assets/js/secret-source.js" defer></script>
	}
}

// SecretSourceDetails is the form after Check: what the page says, as
// editable defaults, and the creator picker. The page URL travels in a
// hidden field; the server looks the audio file up again from its own copy.
templ SecretSourceDetails(page *secret.Page, artists []*audio.Artist, uploader string) {
	<form
		class="grid grid-cols-1 gap-4"
		hx-post="/ui/secret-source/download"
		hx-target="#secret-source-status"
		hx-on::after-request="if (!event.detail.successful) document.getElementById('secret-source-status').textContent = event.detail.xhr.responseText || 'Could not start the download.'"
	>
		<input type="hidden" name="url" value={ page.URL }/>
		if uploader != "" {
			<p class="text-sm">@UploaderLink(uploader)</p>
		}
		<div>
			<label for="ss-title" class="mb-1 block text-sm font-medium">Title</label>
			<input id="ss-title" class="input" type="text" name="title" value={ page.Title } maxlength="200" required/>
		</div>
		<div>
			<span class="mb-1 block text-sm font-medium">Creators</span>
			@artistPicker(artists, nil)
			<small class="mt-1 block text-zinc-500">Pick at least one. Add a new creator above if they aren't listed.</small>
		</div>
		@secretTrackFields(page.Description, page.Tags)
		<div>
			<button class="btn" type="submit">Download</button>
		</div>
		<div id="secret-source-status" aria-live="polite"></div>
	</form>
}

// SecretSourceStatus is the download's progress. While it is queued or
// running it asks again every couple of seconds; once finished it stops.
templ SecretSourceStatus(pageURL string, state SecretDownloadState, trackID string, message string) {
	switch state {
	case SecretDownloadWorking:
		<p
			class="rounded-md border-l-4 border-zinc-400 bg-white px-3 py-2 text-sm dark:bg-zinc-900"
			hx-get={ "/ui/secret-source/status?url=" + url.QueryEscape(pageURL) }
			hx-trigger="load delay:2s"
			hx-swap="outerHTML"
		>Downloading…</p>
	case SecretDownloadDone:
		<p class="rounded-md border-l-4 border-emerald-500 bg-white px-3 py-2 text-sm dark:bg-zinc-900">
			Done.
			if trackID != "" {
				{ " " }<a href={ templ.SafeURL("/tracks/" + trackID + "/edit") }>Edit the track</a>
				{ " · " }<a href="/tracks">Tracks</a>
			}
		</p>
	default:
		<p class="rounded-md border-l-4 border-red-500 bg-white px-3 py-2 text-sm text-red-600 dark:bg-zinc-900 dark:text-red-400">{ message }</p>
	}
}

// SecretSourceExists says the page was downloaded before.
templ SecretSourceExists(t *ExistingTrack, uploader string) {
	<p class="rounded-md border-l-4 border-amber-500 bg-white px-3 py-2 text-sm dark:bg-zinc-900">
		Already in the library:
		{ " " }<a href={ templ.SafeURL("/tracks/" + t.ID + "/edit") }>{ t.Title }</a>.
		if uploader != "" {
			{ " " }@UploaderLink(uploader)
		}
	</p>
}

// UploaderLink opens the page one level above a downloaded page, such as its
// uploader's, to see what else is there.
templ UploaderLink(pageURL string) {
	<a href={ templ.SafeURL("/upload/secret-source?url=" + url.QueryEscape(pageURL)) }>Other pages from this uploader</a>
}

// ListingEntry is a page a listing links to, and the track already
// downloaded from it, if any.
type ListingEntry struct {
	secret.Entry
	Have *ExistingTrack
}

// entryTitle is what a listing row shows: the link's text, else the last
// part of its address.
func entryTitle(e ListingEntry) string {
	if e.Title != "" {
		return e.Title
	}
	if u, err := url.Parse(e.URL); err == nil {
		return path.Base(u.Path)
	}
	return e.URL
}

func entriesWhere(entries []ListingEntry, have bool) []ListingEntry {
	var out []ListingEntry
	for _, e := range entries {
		if (e.Have != nil) == have {
			out = append(out, e)
		}
	}
	return out
}

// SecretSourceListing lists the pages a listing page links to. The ones not
// in the library come first, each with a button that checks it like a
// pasted address; the ones already downloaded are folded away.
templ SecretSourceListing(l *secret.Listing, entries []ListingEntry) {
	{{ todo, done := entriesWhere(entries, false), entriesWhere(entries, true) }}
	<div class="grid grid-cols-1 gap-4">
		<p class="text-zinc-500">
			<a href={ templ.SafeURL(l.URL) } target="_blank" rel="noopener noreferrer">{ path.Base(l.URL) }</a>:{ " " }
			{ fmt.Sprint(len(todo)) } not in the library, { fmt.Sprint(len(done)) } already downloaded.
		</p>
		<div id="secret-source-detail" aria-live="polite"></div>
		if len(todo) > 0 {
			<ul class="divide-y divide-zinc-200 dark:divide-zinc-800">
				for _, e := range todo {
					<li class="flex flex-wrap items-center gap-2 py-2">
						<span class="min-w-0 flex-1 truncate">{ entryTitle(e) }</span>
						<a class="text-sm" href={ templ.SafeURL(e.URL) } target="_blank" rel="noopener noreferrer">Open</a>
						<form
							hx-post="/ui/secret-source/check"
							hx-target="#secret-source-detail"
							hx-swap="innerHTML show:#secret-source-detail:top"
							hx-on::after-request="if (!event.detail.successful) document.getElementById('secret-source-detail').textContent = event.detail.xhr.responseText || 'Could not check that page.'"
						>
							<input type="hidden" name="url" value={ e.URL }/>
							<button class="btn" type="submit">Download…</button>
						</form>
					</li>
				}
			</ul>
		}
		if len(done) > 0 {
			<details>
				<summary class="cursor-pointer text-sm font-medium">Already in the library ({ fmt.Sprint(len(done)) })</summary>
				<ul class="mt-2 divide-y divide-zinc-200 dark:divide-zinc-800">
					for _, e := range done {
						<li class="flex flex-wrap items-center gap-2 py-2">
							<span class="min-w-0 flex-1 truncate">{ entryTitle(e) }</span>
							<a class="text-sm" href={ templ.SafeURL("/tracks/" + e.Have.ID + "/edit") }>{ e.Have.Title }</a>
						</li>
					}
				</ul>
			</details>
		}
	</div>
}

// ExistingTrack is a track the library already has.
type ExistingTrack struct{ ID, Title string }

// SecretDownloadState is where a secret source download stands.
type SecretDownloadState int

const (
	SecretDownloadWorking SecretDownloadState = iota
	SecretDownloadDone
	SecretDownloadFailed
)
